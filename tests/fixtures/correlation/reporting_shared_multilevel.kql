let Events = datatable(Timestamp:datetime, Host:string, Marker:string) [
datetime(2026-01-01T10:00:00Z), "h", "match",
datetime(2026-01-01T10:02:00Z), "h", "match",
datetime(2026-01-01T10:06:00Z), "h", "match",
datetime(2026-01-01T10:08:00Z), "h", "match",
datetime(2026-01-01T10:18:00Z), "h", "success"
];
let Expected = datatable(WindowEnd:datetime, Host:string, RuleCount:long) [datetime(2026-01-01T10:18:00Z), "h", 2] | extend WindowStart=WindowEnd-11m;
let Actual0 = () {
let ReportStart_ = datetime(2026-01-01T10:18:00.0000000Z);
let ReportEnd_ = datetime(2026-01-01T10:19:00.0000000Z);
let Child = () {
let ReportStart = datetime(2026-01-01T10:18:00.0000000Z);
let ReportEnd = datetime(2026-01-01T10:19:00.0000000Z);
Events
| where Marker =~ "match"
| where ["Timestamp"] >= ReportStart - 1260s and ["Timestamp"] < ReportEnd
| project EventTime_1 = ["Timestamp"], GroupHost = ["Host"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
// Preserve individual source matches, including timestamp ties, before the threshold lookup.
| sort by GroupHost asc, EventTime_1 asc
| extend ThresholdPredecessorTime = prev(EventTime_1, 1)
| where ThresholdPredecessorTime >= EventTime_1 - 3m and GroupHost == prev(GroupHost, 1)
| distinct EventTime_1, GroupHost
| project WindowStart = EventTime_1 - 3m, WindowEnd = EventTime_1, ["Host"] = GroupHost
};
let SourceMatchArrivals = Child()
| project EventTime = ["WindowEnd"], GroupHost = ["Host"]
| where isnotnull(EventTime) and isnotempty(GroupHost)
| summarize SourceMatchCount = count() by EventTime, GroupHost;
union (SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime + 2m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupHost asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupHost != prev(GroupHost))
| where CountBoundaryOrder == 0
| where EventCount >= 1
| project WindowStart = CountBoundaryTime - 2m, WindowEnd = CountBoundaryTime, ["Host"] = GroupHost, EventCount
| where WindowEnd >= ReportStart_ and WindowEnd < ReportEnd_
};
let Actual1 = () {
let ReportStart__ = datetime(2026-01-01T10:18:00.0000000Z);
let ReportEnd__ = datetime(2026-01-01T10:19:00.0000000Z);
let Far = () {
let ReportStart_ = datetime(2026-01-01T10:18:00.0000000Z);
let ReportEnd_ = datetime(2026-01-01T10:19:00.0000000Z);
let Child = () {
let ReportStart = datetime(2026-01-01T10:18:00.0000000Z);
let ReportEnd = datetime(2026-01-01T10:19:00.0000000Z);
Events
| where Marker =~ "match"
| where ["Timestamp"] >= ReportStart - 1260s and ["Timestamp"] < ReportEnd
| project EventTime_1 = ["Timestamp"], GroupHost = ["Host"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
// Preserve individual source matches, including timestamp ties, before the threshold lookup.
| sort by GroupHost asc, EventTime_1 asc
| extend ThresholdPredecessorTime = prev(EventTime_1, 1)
| where ThresholdPredecessorTime >= EventTime_1 - 3m and GroupHost == prev(GroupHost, 1)
| distinct EventTime_1, GroupHost
| project WindowStart = EventTime_1 - 3m, WindowEnd = EventTime_1, ["Host"] = GroupHost
};
Child()
| project EventTime = ["WindowEnd"], GroupHost = ["Host"]
| where isnotnull(EventTime) and isnotempty(GroupHost)
| distinct EventTime, GroupHost
| project WindowStart = EventTime - 7m, WindowEnd = EventTime, ["Host"] = GroupHost
};
// Strict sequence: "far" -> "success". Total inclusive span: 11m.
union (Far()
| extend EventTime_1 = ["WindowEnd"], GroupHost = ["Host"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
| extend SourceRule = "far"),
(Events
| where Marker =~ "success"
| where ["Timestamp"] >= ReportStart__ - 660s and ["Timestamp"] < ReportEnd__
| extend EventTime_1 = ["Timestamp"], GroupHost = ["Host"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
| extend SourceRule = "success")
// Batch equal timestamps: simultaneous source matches cannot advance strict sequence positions.
| summarize HasFar = countif(SourceRule == "far") > 0, HasSuccess = countif(SourceRule == "success") > 0 by EventTime_1, GroupHost
| sort by GroupHost asc, EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1)) or GroupHost != prev(GroupHost)
// Read preceding timestamp state for every assignment; preserve viable earlier prefixes.
| scan declare (LastFarTime:datetime = datetime(null), CompleteNow:bool = false) with (
    step SequenceState: true =>
        CompleteNow = not(NewCorrelationGroup) and HasSuccess and isnotnull(SequenceState.LastFarTime) and SequenceState.LastFarTime >= EventTime_1 - 11m,
        LastFarTime = iff(HasFar, EventTime_1, iff(NewCorrelationGroup, datetime(null), SequenceState.LastFarTime));
)
| where CompleteNow
| project WindowStart = EventTime_1 - 11m, WindowEnd = EventTime_1, ["Host"] = GroupHost, RuleCount = tolong(2)
| where WindowEnd >= ReportStart__ and WindowEnd < ReportEnd__
};
let NearRows = Actual0() | count;
union (Actual1() | extend Host=tostring(Host) | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Host, RuleCount
| where Delta != 0
| union (NearRows | where Count != 0 | project WindowStart=datetime(null), WindowEnd=datetime(null), Host="unexpected-near", RuleCount=Count, Delta=long(1))
