// Prepared acceptance fixture; runtime PENDING.
let Events=datatable(Timestamp:datetime,Marker:string,Amount:real) [
 datetime(2026-01-01T12:00:00Z),"match",2.5
];
let Actual=(){
let _sigma_shared_child = () {
let _sigma_context_summary = () {
union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]), SourceRule = "source-rule")
| where isnotnull(EventTime_1)
// Batch simultaneous source matches before updating inclusive trailing presence.
| summarize MatchesSourcerule = countif(SourceRule == "source-rule") > 0 by EventTime_1
| sort by EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1))
| scan declare (LastSourceruleTime:datetime) with (
    step PresenceWindow: true =>
        LastSourceruleTime = iff(MatchesSourcerule, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastSourceruleTime));
)
// Only source-match timestamps evaluate; expiration never creates an anchor.
| extend HasSourcerule = isnotnull(LastSourceruleTime) and LastSourceruleTime >= EventTime_1 - 1m
| extend RuleCount = tolong(HasSourcerule)
| where RuleCount >= 1
| project WindowStart = EventTime_1 - 1m, WindowEnd = EventTime_1, RuleCount
};
let _sigma_context_summaries = materialize(_sigma_context_summary()
| serialize _sigma_context_id = row_number());
let _sigma_context_matches = materialize(
_sigma_context_summaries | project _sigma_context_id, _sigma_context_end = WindowEnd, _sigma_context_partition = 1
| join kind=inner (
union (Events
| where Marker =~ "match"
| extend _sigma_context_timestamp = todatetime(["Timestamp"]), _sigma_context_value = ["Amount"]
| extend _sigma_context_rule = "source-rule")
| project _sigma_context_timestamp, _sigma_context_rule, _sigma_context_value, _sigma_context_partition = 1
) on _sigma_context_partition
| where _sigma_context_timestamp between ((_sigma_context_end - 1m) .. _sigma_context_end)
| serialize _sigma_context_key = row_number());
let _sigma_context_rows = materialize(_sigma_context_matches
| project _sigma_context_id, _sigma_context_value
| distinct *);
union (_sigma_context_summaries | extend ContextRowKind = "Summary"), (_sigma_context_summaries | join kind=inner (_sigma_context_rows) on _sigma_context_id | extend ContextRowKind = "ContextEvidence")
};
let _sigma_shared_results = materialize(_sigma_shared_child());
let _sigma_context_summary = () {
// Strict sequence: "child". Total inclusive span: 5m.
union (_sigma_shared_results
| where ["ContextRowKind"] == "Summary"
| extend EventTime = todatetime(["WindowEnd"])
| extend SourceRule = "child")
| where isnotnull(EventTime)
// Batch equal timestamps: simultaneous source matches cannot advance strict sequence positions.
| summarize by EventTime
| project WindowStart = EventTime - 5m, WindowEnd = EventTime, RuleCount = tolong(1)
};
let _sigma_context_summaries = materialize(_sigma_context_summary()
| serialize _sigma_context_id = row_number());
let _sigma_context_matches = materialize(
_sigma_context_summaries | project _sigma_context_id, _sigma_context_end = WindowEnd, _sigma_context_partition = 1
| join kind=inner (
union (_sigma_shared_results
| where ["ContextRowKind"] == "ContextEvidence"
| extend _sigma_context_timestamp = todatetime(["WindowEnd"]), _sigma_context_value = toreal(pack_array(gettype(["_sigma_context_value"]), ["_sigma_context_value"])[1])
| extend _sigma_context_rule = "child")
| project _sigma_context_timestamp, _sigma_context_rule, _sigma_context_value, _sigma_context_partition = 1
) on _sigma_context_partition
| where _sigma_context_timestamp between ((_sigma_context_end - 5m) .. _sigma_context_end)
| serialize _sigma_context_key = row_number());
let _sigma_context_path = _sigma_context_matches
| where _sigma_context_rule == "child"
| project _sigma_context_id, _sigma_context_end, _sigma_context_step = _sigma_context_key, _sigma_context_step_time = _sigma_context_timestamp
| where _sigma_context_step_time == _sigma_context_end
| project _sigma_context_id, _sigma_context_end, _sigma_context_step, _sigma_context_previous = _sigma_context_step_time;
let _sigma_context_participating = union (_sigma_context_path | project _sigma_context_id, _sigma_context_key = _sigma_context_step)
| distinct _sigma_context_id, _sigma_context_key;
let _sigma_context_selected = materialize(_sigma_context_matches
| join kind=leftsemi (_sigma_context_participating) on _sigma_context_id, _sigma_context_key);
let _sigma_context_rows = materialize(_sigma_context_selected
| project _sigma_context_id, _sigma_context_value
| distinct *);
let ContextValues = _sigma_context_rows
| where isnotnull(_sigma_context_value)
| summarize by _sigma_context_id, _sigma_context_value
| summarize DisplayedValues = make_list(_sigma_context_value, 1000), DistinctValueCount = count() by _sigma_context_id;
_sigma_context_summaries
| join kind=leftouter (ContextValues) on _sigma_context_id
| extend ["Amount"] = coalesce(DisplayedValues, dynamic([]))
| extend ContextComplete = coalesce(DistinctValueCount, 0) <= 1000
| project ["WindowStart"], ["WindowEnd"], ["Amount"], ["RuleCount"], ["ContextComplete"]
};
let Observed=Actual() | project WindowStart,WindowEnd,Metric=toreal(RuleCount);
let Expected=datatable(WindowStart:datetime,WindowEnd:datetime,Metric:real) [
 datetime(2026-01-01T11:55:00Z),datetime(2026-01-01T12:00:00Z),1
];
union (Observed | extend Delta=1),(Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowStart,WindowEnd,Metric
| where Delta!=0
