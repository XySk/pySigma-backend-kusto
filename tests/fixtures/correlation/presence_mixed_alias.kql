// Public Sigma conversion; expected rows are worked inclusive-window examples.
let Events=datatable(Timestamp:datetime,Host:string,Marker:string) [
datetime(2026-01-01T00:00:00Z),"g","A",
        datetime(2026-01-01T00:01:00Z),"g","A",
        datetime(2026-01-01T00:06:00Z),"g","B",
        datetime(2026-01-01T00:06:00.0000001Z),"g","B"
] | extend Device=Host;
let Actual=(){
let Child = () {
Events
| where Marker =~ "A"
| project EventTime_1 = ["Timestamp"], GroupHost = ["Host"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
// Preserve individual source matches, including timestamp ties, before the threshold lookup.
| sort by GroupHost asc, EventTime_1 asc
| extend ThresholdPredecessorTime = prev(EventTime_1, 1)
| where ThresholdPredecessorTime >= EventTime_1 - 5m and GroupHost == prev(GroupHost, 1)
| distinct EventTime_1, GroupHost
| project WindowStart = EventTime_1 - 5m, WindowEnd = EventTime_1, ["Host"] = GroupHost
};
union (Child()
| project EventTime_1 = ["WindowEnd"], GroupActor = ["Host"], SourceRule = "child"
| where isnotnull(EventTime_1) and isnotempty(GroupActor)),
(Events
| where Marker =~ "B"
| project EventTime_1 = ["Timestamp"], GroupActor = ["Device"], SourceRule = "B"
| where isnotnull(EventTime_1) and isnotempty(GroupActor))
// Batch simultaneous source matches before updating inclusive trailing presence.
| summarize MatchesChild = countif(SourceRule == "child") > 0, MatchesB = countif(SourceRule == "B") > 0 by GroupActor, EventTime_1
| sort by GroupActor asc, EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1)) or GroupActor != prev(GroupActor)
| scan declare (LastChildTime:datetime, LastBTime:datetime) with (
    step PresenceWindow: true =>
        LastChildTime = iff(MatchesChild, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastChildTime)),
        LastBTime = iff(MatchesB, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastBTime));
)
// Only source-match timestamps evaluate; expiration never creates an anchor.
| extend HasChild = isnotnull(LastChildTime) and LastChildTime >= EventTime_1 - 5m, HasB = isnotnull(LastBTime) and LastBTime >= EventTime_1 - 5m
| extend RuleCount = tolong(HasChild) + tolong(HasB)
| where RuleCount >= 2
| project WindowStart = EventTime_1 - 5m, WindowEnd = EventTime_1, ["Actor"] = GroupActor, RuleCount
| project WindowEnd,Host=Actor,RuleCount
};
let Expected=datatable(WindowEnd:datetime,Host:string,RuleCount:long) [
datetime(2026-01-01T00:06:00Z),"g",2
];
union (Actual() | project WindowEnd,Host,RuleCount | extend Delta=1), (Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowEnd,Host,RuleCount
| where Delta!=0
