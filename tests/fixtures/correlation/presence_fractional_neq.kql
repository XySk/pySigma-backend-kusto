// Public Sigma conversion; expected rows are worked inclusive-window examples.
let Events=datatable(Timestamp:datetime,Host:string,Marker:string) [
datetime(2026-01-01T00:00:00Z),"boundary","A",
        datetime(2026-01-01T00:00:00Z),"boundary","A",
        datetime(2026-01-01T00:05:00Z),"boundary","B",
        datetime(2026-01-01T00:05:00.0000001Z),"boundary","B",
        datetime(2026-01-01T00:11:00Z),"boundary","C",
        datetime(2026-01-01T00:00:00Z),"ties","A",
        datetime(2026-01-01T00:00:00Z),"ties","B",
        datetime(2026-01-01T00:00:00Z),"ties","C",
        datetime(2026-01-01T00:01:00Z),"ties","A",
        datetime(null),"ties","C",
        datetime(2026-01-01T00:00:00Z),"","A"
];
let Actual=(){
union (Events
| where Marker =~ "A"
| project EventTime_1 = ["Timestamp"], GroupHost = ["Host"], SourceRule = "A"
| where isnotnull(EventTime_1) and isnotempty(GroupHost)),
(Events
| where Marker =~ "B"
| project EventTime_1 = ["Timestamp"], GroupHost = ["Host"], SourceRule = "B"
| where isnotnull(EventTime_1) and isnotempty(GroupHost)),
(Events
| where Marker =~ "C"
| project EventTime_1 = ["Timestamp"], GroupHost = ["Host"], SourceRule = "C"
| where isnotnull(EventTime_1) and isnotempty(GroupHost))
// Batch simultaneous source matches before updating inclusive trailing presence.
| summarize MatchesA = countif(SourceRule == "A") > 0, MatchesB = countif(SourceRule == "B") > 0, MatchesC = countif(SourceRule == "C") > 0 by GroupHost, EventTime_1
| sort by GroupHost asc, EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1)) or GroupHost != prev(GroupHost)
| scan declare (LastATime:datetime, LastBTime:datetime, LastCTime:datetime) with (
    step PresenceWindow: true =>
        LastATime = iff(MatchesA, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastATime)),
        LastBTime = iff(MatchesB, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastBTime)),
        LastCTime = iff(MatchesC, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastCTime));
)
// Only source-match timestamps evaluate; expiration never creates an anchor.
| extend HasA = isnotnull(LastATime) and LastATime >= EventTime_1 - 5m, HasB = isnotnull(LastBTime) and LastBTime >= EventTime_1 - 5m, HasC = isnotnull(LastCTime) and LastCTime >= EventTime_1 - 5m
| extend RuleCount = tolong(HasA) + tolong(HasB) + tolong(HasC)
| where todecimal(RuleCount) != decimal(1.5)
| project WindowStart = EventTime_1 - 5m, WindowEnd = EventTime_1, ["Host"] = GroupHost, RuleCount
};
let Expected=datatable(WindowEnd:datetime,Host:string,RuleCount:long) [
datetime(2026-01-01T00:00:00Z),"boundary",1,
datetime(2026-01-01T00:05:00.0000001Z),"boundary",1,
datetime(2026-01-01T00:11:00Z),"boundary",1,
datetime(2026-01-01T00:05:00Z),"boundary",2,
datetime(2026-01-01T00:00:00Z),"ties",3,
datetime(2026-01-01T00:01:00Z),"ties",3
];
union (Actual() | project WindowEnd,Host,RuleCount | extend Delta=1), (Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowEnd,Host,RuleCount
| where Delta!=0
