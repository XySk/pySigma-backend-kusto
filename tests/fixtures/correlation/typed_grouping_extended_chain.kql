let Events=datatable(User:guid) [guid(00000000-0000-0000-0000-000000000001)]
| extend Timestamp=datetime(2026-01-01T12:00:00Z),Marker="match";
let Actual=(){
let Child = () {
Events
| where Marker =~ "match"
| project EventTime_1 = ["Timestamp"], GroupUser = ["User"]
| where isnotnull(EventTime_1) and isnotempty(GroupUser)
| distinct EventTime_1, GroupUser
| project WindowStart = EventTime_1 - 5m, WindowEnd = EventTime_1, ["User"] = GroupUser
};
let SourceMatchArrivals = Child()
| project EventTime = ["WindowEnd"], GroupActor = ["User"]
| where isnotnull(EventTime) and isnotempty(GroupActor)
| summarize SourceMatchCount = count() by EventTime, GroupActor;
union (SourceMatchArrivals
| project GroupActor, CountBoundaryTime = EventTime, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupActor, CountBoundaryTime = EventTime + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupActor asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupActor != prev(GroupActor))
| where CountBoundaryOrder == 0
| where EventCount >= 1
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, ["Actor"] = GroupActor, EventCount
};
let Observed=Actual() | project WindowEnd,Kind=gettype(Actor),EventCount;
let Expected=datatable(Kind:string) ["guid"]
| extend WindowEnd=datetime(2026-01-01T12:00:00Z),EventCount=tolong(1);
union (Observed | extend Delta=1),(Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowEnd,Kind,EventCount
| where Delta!=0
