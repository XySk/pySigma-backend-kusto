// Public-conversion comparison; execution status is hash-scoped in RUNTIME.md.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
// C has ValueCount 2 at 01 and 3 at 02; both remain one immediate source type.
// D ties C at 01. Unordered temporal permits ties and returns two overlapping summaries.
let Events=datatable(Timestamp:string, Case:string, Host:string, User:string, Marker:string) [
    "2026-01-01T12:00:00Z", "value-temporal", "host", "alice", "V1",
    "2026-01-01T12:01:00Z", "value-temporal", "host", "bob", "V2",
    "2026-01-01T12:02:00Z", "value-temporal", "host", "carol", "V1",
    "2026-01-01T12:01:00Z", "value-temporal", "host", "", "D",
    "invalid", "value-temporal", "host", "dave", "V1",
    "2026-01-01T12:03:00Z", "value-temporal", "", "dave", "V2"
]
// Normalize Events scalar fixture inputs explicitly.
| extend Timestamp=todatetime(Timestamp);
let Actual = () {
let C = () {
let ValueCountSources = materialize(union (Events
| where Marker =~ "V1"
| project EventTime_1 = todatetime(["Timestamp"]), GroupCase = ["Case"], GroupHost = ["Host"], CountedUser = ["User"]),
(Events
| where Marker =~ "V2"
| project EventTime_1 = todatetime(["Timestamp"]), GroupCase = ["Case"], GroupHost = ["Host"], CountedUser = ["User"])
| where isnotnull(EventTime_1) and isnotempty(GroupCase) and isnotempty(GroupHost));
let CountedUserActivity = materialize(ValueCountSources
| where isnotempty(CountedUser)
| summarize by GroupCase, GroupHost, CountedUser, EventTime_1
| sort by GroupCase asc, GroupHost asc, CountedUser asc, EventTime_1 asc
// Repeated values whose inclusive active intervals overlap contribute only once.
| extend CountedUserStarts = isnull(prev(EventTime_1)) or GroupCase != prev(GroupCase) or GroupHost != prev(GroupHost) or CountedUser != prev(CountedUser) or EventTime_1 > prev(EventTime_1) + 5m,
    CountedUserEnds = isnull(next(EventTime_1)) or GroupCase != next(GroupCase) or GroupHost != next(GroupHost) or CountedUser != next(CountedUser) or next(EventTime_1) > EventTime_1 + 5m);
union (ValueCountSources | summarize by GroupCase, GroupHost, EventTime_1
| project GroupCase, GroupHost, ValueBoundaryTime = EventTime_1, ValueBoundaryOrder = 1, CountedUserDelta = 0),
(CountedUserActivity | where CountedUserStarts
| project GroupCase, GroupHost, ValueBoundaryTime = EventTime_1, ValueBoundaryOrder = 0, CountedUserDelta = 1),
(CountedUserActivity | where CountedUserEnds
| project GroupCase, GroupHost, ValueBoundaryTime = EventTime_1 + 5m, ValueBoundaryOrder = 2, CountedUserDelta = -1)
// All interval starts precede anchors; equal-time expirations follow them.
| sort by GroupCase asc, GroupHost asc, ValueBoundaryTime asc, ValueBoundaryOrder asc
| extend ValueCount = row_cumsum(CountedUserDelta, GroupCase != prev(GroupCase) or GroupHost != prev(GroupHost))
| where ValueBoundaryOrder == 1
| where ValueCount >= 2
| project WindowStart = ValueBoundaryTime - 5m, WindowEnd = ValueBoundaryTime, ["Case"] = GroupCase, ["Host"] = GroupHost, ValueCount
};
union (C()
| project EventTime_1 = todatetime(["WindowEnd"]), GroupCase = ["Case"], GroupHost = ["Host"], SourceRule = "C"),
(Events
| where Marker =~ "D"
| project EventTime_1 = todatetime(["Timestamp"]), GroupCase = ["Case"], GroupHost = ["Host"], SourceRule = "D")
| where isnotnull(EventTime_1) and isnotempty(GroupCase) and isnotempty(GroupHost)
// Batch simultaneous source matches before updating inclusive trailing presence.
| summarize MatchesC = countif(SourceRule == "C") > 0, MatchesD = countif(SourceRule == "D") > 0 by GroupCase, GroupHost, EventTime_1
| sort by GroupCase asc, GroupHost asc, EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1)) or GroupCase != prev(GroupCase) or GroupHost != prev(GroupHost)
| scan declare (LastCTime:datetime, LastDTime:datetime) with (
    step PresenceWindow: true =>
        LastCTime = iff(MatchesC, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastCTime)),
        LastDTime = iff(MatchesD, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastDTime));
)
// Only source-match timestamps evaluate; expiration never creates an anchor.
| extend HasC = isnotnull(LastCTime) and LastCTime >= EventTime_1 - 5m, HasD = isnotnull(LastDTime) and LastDTime >= EventTime_1 - 5m
| extend RuleCount = tolong(HasC) + tolong(HasD)
| where RuleCount >= 2
| project WindowStart = EventTime_1 - 5m, WindowEnd = EventTime_1, ["Case"] = GroupCase, ["Host"] = GroupHost, RuleCount
};
let Expected = datatable(WindowStart:datetime, WindowEnd:datetime, Case:string, Host:string, RuleCount:long) [
    datetime(2026-01-01T11:56:00Z), datetime(2026-01-01T12:01:00Z), "value-temporal", "host", 2,
    datetime(2026-01-01T11:57:00Z), datetime(2026-01-01T12:02:00Z), "value-temporal", "host", 2
];
union (Actual() | extend Case=tostring(Case), Host=tostring(Host) | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Case, Host, RuleCount
| where Delta != 0
