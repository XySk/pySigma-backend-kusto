// Public-conversion comparison; execution status is hash-scoped in RUNTIME.md.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
// Valid anchors/counts: 12:00=0, 12:01=1, 12:05=3, 12:06=3,
// 12:06:00.0000001=2, 12:20=0. Missing values establish anchors, including zero.
// Duplicate alice rows count once; expiration alone creates no evaluation.
let Events=datatable(Timestamp:string, User:dynamic, Marker:string) [
    "2026-01-01T12:00:00Z", dynamic(null), "match",
    "2026-01-01T12:00:00Z", dynamic(""), "match",
    "2026-01-01T12:01:00Z", dynamic("alice"), "match",
    "2026-01-01T12:01:00Z", dynamic("alice"), "match",
    "2026-01-01T12:05:00Z", dynamic("bob"), "match",
    "2026-01-01T12:05:00Z", dynamic("carol"), "match",
    "2026-01-01T12:06:00Z", dynamic(null), "match",
    "2026-01-01T12:06:00.0000001Z", dynamic(""), "match",
    "2026-01-01T12:20:00Z", dynamic(null), "match",
    "invalid", dynamic("carol"), "match"
]
// Normalize Events scalar fixture inputs explicitly.
| extend Timestamp=todatetime(Timestamp), User=tostring(User);
let gt_2 = () {
let ValueCountSources = materialize(union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]), CountedUser = ["User"])
| where isnotnull(EventTime_1));
let CountedUserActivity = materialize(ValueCountSources
| where isnotempty(CountedUser)
| summarize by CountedUser, EventTime_1
| sort by CountedUser asc, EventTime_1 asc
// Repeated values whose inclusive active intervals overlap contribute only once.
| extend CountedUserStarts = isnull(prev(EventTime_1)) or CountedUser != prev(CountedUser) or EventTime_1 > prev(EventTime_1) + 5m,
    CountedUserEnds = isnull(next(EventTime_1)) or CountedUser != next(CountedUser) or next(EventTime_1) > EventTime_1 + 5m);
union (ValueCountSources | summarize by EventTime_1
| project ValueBoundaryTime = EventTime_1, ValueBoundaryOrder = 1, CountedUserDelta = 0),
(CountedUserActivity | where CountedUserStarts
| project ValueBoundaryTime = EventTime_1, ValueBoundaryOrder = 0, CountedUserDelta = 1),
(CountedUserActivity | where CountedUserEnds
| project ValueBoundaryTime = EventTime_1 + 5m, ValueBoundaryOrder = 2, CountedUserDelta = -1)
// All interval starts precede anchors; equal-time expirations follow them.
| sort by ValueBoundaryTime asc, ValueBoundaryOrder asc
| extend ValueCount = row_cumsum(CountedUserDelta)
| where ValueBoundaryOrder == 1
| where ValueCount > 2
| project WindowStart = ValueBoundaryTime - 5m, WindowEnd = ValueBoundaryTime, ValueCount
};
