// Generated with standard collection parsing; expected summaries are literal worked examples.
let Events=datatable(Timestamp:datetime,Host:string,Marker:string,User:string,Server:string) [
datetime(2026-01-01T12:00:00Z),"h","raw","Alice","s1",
datetime(2026-01-01T12:00:00Z),"h","raw","Alice","s1",
datetime(2026-01-01T12:00:00Z),"h","raw","Alice","s2",
datetime(2026-01-01T12:00:00Z),"h","raw","Bob","b1",
datetime(2026-01-01T12:01:00Z),"d","B","Alice","s3",
datetime(2026-01-01T12:02:00Z),"d","B","Alice","s4",
datetime(2026-01-01T12:00:00Z),"d","C","Bob","b2"
];
let Actual=(){
let Middle = () {
let Child = () {
let ContextSummary = () {
let SourceMatchArrivals = Events
| where Marker =~ "raw"
| project EventTime_1 = ["Timestamp"], GroupHost = ["Host"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
| summarize SourceMatchCount = count() by EventTime_1, GroupHost;
union (SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime_1 + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupHost asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupHost != prev(GroupHost))
| where CountBoundaryOrder == 0
| where EventCount >= 1
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, ["Host"] = GroupHost, EventCount
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId = row_number());
let WindowSourceMatches =
CorrelationMatches | project CorrelationMatchId, CompletionTime = WindowEnd, ContextGroupHost = ["Host"], ContextPartition = 1
| join kind=inner (
Events
| where Marker =~ "raw"
| extend ContextEventTime = ["Timestamp"], ContextGroupHost = ["Host"], ContextUser = ["User"], ContextServer = ["Server"]
| where isnotnull(ContextEventTime) and isnotempty(ContextGroupHost)
| extend ContextSourceRule = "raw"
| project ContextEventTime, ContextSourceRule, ContextGroupHost, ContextUser, ContextServer, ContextPartition = 1
) on ContextGroupHost
| where ContextEventTime between ((CompletionTime - 5m) .. CompletionTime);
let CompleteContextRelationships = materialize(WindowSourceMatches
| project CorrelationMatchId, ContextUser, ContextServer
| distinct *);
union (CorrelationMatches | extend ContextRowKind = "Summary"), (CorrelationMatches | join kind=inner (CompleteContextRelationships) on CorrelationMatchId | extend ContextRowKind = "ContextEvidence")
};
let ChildResults = materialize(Child());
let ContextSummary = () {
union (ChildResults
| where ["ContextRowKind"] == "ContextEvidence"
| extend EventTime_1 = ["WindowEnd"], GroupUser = ["ContextUser"]
| where isnotnull(EventTime_1) and isnotempty(GroupUser)
| extend SourceRule = "child"),
(Events
| where Marker =~ "B"
| extend EventTime_1 = ["Timestamp"], GroupUser = ["User"]
| where isnotnull(EventTime_1) and isnotempty(GroupUser)
| extend SourceRule = "B"),
(Events
| where Marker =~ "C"
| extend EventTime_1 = ["Timestamp"], GroupUser = ["User"]
| where isnotnull(EventTime_1) and isnotempty(GroupUser)
| extend SourceRule = "C")
// Batch simultaneous source matches before updating inclusive trailing presence.
| summarize MatchesChild = countif(SourceRule == "child") > 0, MatchesB = countif(SourceRule == "B") > 0, MatchesC = countif(SourceRule == "C") > 0 by GroupUser, EventTime_1
| sort by GroupUser asc, EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1)) or GroupUser != prev(GroupUser)
| scan declare (LastChildTime:datetime, LastBTime:datetime, LastCTime:datetime) with (
    step PresenceWindow: true =>
        LastChildTime = iff(MatchesChild, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastChildTime)),
        LastBTime = iff(MatchesB, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastBTime)),
        LastCTime = iff(MatchesC, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastCTime));
)
// Only source-match timestamps evaluate; expiration never creates an anchor.
| extend HasChild = isnotnull(LastChildTime) and LastChildTime >= EventTime_1 - 5m, HasB = isnotnull(LastBTime) and LastBTime >= EventTime_1 - 5m, HasC = isnotnull(LastCTime) and LastCTime >= EventTime_1 - 5m
| extend RuleCount = tolong(HasChild) + tolong(HasB) + tolong(HasC)
| where ((HasChild and HasB) or HasC)
| project WindowStart = EventTime_1 - 5m, WindowEnd = EventTime_1, ["User"] = GroupUser, RuleCount
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId = row_number());
let WindowSourceMatches = materialize(
CorrelationMatches | project CorrelationMatchId, CompletionTime = WindowEnd, ContextGroupUser = ["User"], ContextPartition = 1
| join kind=inner (
union (ChildResults | where ["ContextRowKind"] == "Summary"
| project-away ["ContextUser"], ["ContextServer"]
| join kind=leftouter (ChildResults | where ["ContextRowKind"] == "ContextEvidence" | project ["CorrelationMatchId"], ["ContextUser"], ["ContextServer"], HasContextEvidence = true) on ["CorrelationMatchId"]
| extend ContextEventTime = ["WindowEnd"], ContextGroupUser = ["ContextUser"], ContextServer = ["ContextServer"]
| where isnotnull(ContextEventTime) and isnotempty(ContextGroupUser)
| extend ContextSourceRule = "child"),
((Events
| where Marker =~ "B"
| extend ContextEventTime = ["Timestamp"], ContextGroupUser = ["User"], ContextServer = ["Server"]
| where isnotnull(ContextEventTime) and isnotempty(ContextGroupUser)
| extend ContextSourceRule = "B")
| extend HasContextEvidence = true),
((Events
| where Marker =~ "C"
| extend ContextEventTime = ["Timestamp"], ContextGroupUser = ["User"], ContextServer = ["Server"]
| where isnotnull(ContextEventTime) and isnotempty(ContextGroupUser)
| extend ContextSourceRule = "C")
| extend HasContextEvidence = true)
| project ContextEventTime, ContextSourceRule, ContextGroupUser, ContextServer, HasContextEvidence, ContextPartition = 1
) on ContextGroupUser
| where ContextEventTime between ((CompletionTime - 5m) .. CompletionTime));
let BooleanParticipants = WindowSourceMatches
| join kind=inner (WindowSourceMatches | summarize Haschild = countif(ContextSourceRule == "child") > 0, HasB_1 = countif(ContextSourceRule == "B") > 0, HasC_1 = countif(ContextSourceRule == "C") > 0 by CorrelationMatchId) on CorrelationMatchId
| where (((Haschild and HasB_1) and (((Haschild and HasB_1) and ((Haschild and (ContextSourceRule == "child")) or (HasB_1 and (ContextSourceRule == "B")))))) or (HasC_1 and (ContextSourceRule == "C")));
let CompleteContextRelationships = materialize(BooleanParticipants
| where HasContextEvidence
| project CorrelationMatchId, ContextServer
| distinct *);
union (CorrelationMatches | extend ContextRowKind_1 = "Summary"), (CorrelationMatches | join kind=inner (CompleteContextRelationships) on CorrelationMatchId | extend ContextRowKind_1 = "ContextEvidence")
};
let MiddleResults = materialize(Middle());
MiddleResults
| where ["ContextRowKind_1"] == "ContextEvidence"
| extend EventTime = ["WindowEnd"], GroupUser = ["User"], GroupServer = ["ContextServer"]
| where isnotnull(EventTime) and isnotempty(GroupUser) and isnotempty(GroupServer)
| extend SourceRule = "middle"
// Batch simultaneous source matches before updating inclusive trailing presence.
| summarize MatchesMiddle = countif(SourceRule == "middle") > 0 by GroupUser, GroupServer, EventTime
| sort by GroupUser asc, GroupServer asc, EventTime asc
| extend NewCorrelationGroup = isnull(prev(EventTime)) or GroupUser != prev(GroupUser) or GroupServer != prev(GroupServer)
| scan declare (LastMiddleTime:datetime) with (
    step PresenceWindow: true =>
        LastMiddleTime = iff(MatchesMiddle, EventTime, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastMiddleTime));
)
// Only source-match timestamps evaluate; expiration never creates an anchor.
| extend HasMiddle = isnotnull(LastMiddleTime) and LastMiddleTime >= EventTime - 5m
| extend RuleCount = tolong(HasMiddle)
| where RuleCount >= 1
| project WindowStart = EventTime - 5m, WindowEnd = EventTime, ["User"] = GroupUser, ["Server"] = GroupServer, RuleCount
| extend ContextComplete = true
};
let Observed=Actual() | project WindowEnd, User=tostring(User), Server=tostring(Server), RuleCount;
let Expected=datatable(WindowEnd:datetime, User:string, Server:string, RuleCount:long) [
datetime(2026-01-01T12:01:00Z),"Alice","s1",1,
datetime(2026-01-01T12:01:00Z),"Alice","s2",1,
datetime(2026-01-01T12:01:00Z),"Alice","s3",1,
datetime(2026-01-01T12:02:00Z),"Alice","s1",1,
datetime(2026-01-01T12:02:00Z),"Alice","s2",1,
datetime(2026-01-01T12:02:00Z),"Alice","s3",1,
datetime(2026-01-01T12:02:00Z),"Alice","s4",1,
datetime(2026-01-01T12:00:00Z),"Bob","b2",1
];
union (Observed | extend Delta=1), (Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowEnd,User,Server,RuleCount
| where Delta!=0
