// Public-conversion comparison; execution status is hash-scoped in RUNTIME.md.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
// Ordered child summaries at 01 and 02 each have RuleCount 2, but contribute once.
let Events=datatable(Timestamp:string, Case:string, Host:string, Marker:string) [
    "2026-01-01T12:00:00Z", "ordered-event", "host", "OA",
    "2026-01-01T12:01:00Z", "ordered-event", "host", "OB",
    "2026-01-01T12:02:00Z", "ordered-event", "host", "OB",
    "invalid", "ordered-event", "host", "OB",
    "2026-01-01T12:03:00Z", "ordered-event", "", "OB"
]
// Normalize Events scalar fixture inputs explicitly.
| extend Timestamp=todatetime(Timestamp);
let Actual = () {
let C = () {
// Strict sequence: "OA" -> "OB". Total inclusive span: 5m.
union (Events
| where Marker =~ "OA"
| extend EventTime_1 = todatetime(["Timestamp"]), GroupCase = ["Case"], GroupHost = ["Host"]
| extend SourceRule = "OA"),
(Events
| where Marker =~ "OB"
| extend EventTime_1 = todatetime(["Timestamp"]), GroupCase = ["Case"], GroupHost = ["Host"]
| extend SourceRule = "OB")
| where isnotnull(EventTime_1) and isnotempty(GroupCase) and isnotempty(GroupHost)
// Batch equal timestamps: simultaneous source matches cannot advance strict sequence positions.
| summarize HasOA = countif(SourceRule == "OA") > 0, HasOB = countif(SourceRule == "OB") > 0 by EventTime_1, GroupCase, GroupHost
| sort by GroupCase asc, GroupHost asc, EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1)) or GroupCase != prev(GroupCase) or GroupHost != prev(GroupHost)
// Read preceding timestamp state for every assignment; preserve viable earlier prefixes.
| scan declare (LatestOAStart:datetime = datetime(null), CompleteNow:bool = false) with (
    step SequenceState: true =>
        CompleteNow = not(NewCorrelationGroup) and HasOB and isnotnull(SequenceState.LatestOAStart) and SequenceState.LatestOAStart >= EventTime_1 - 5m,
        LatestOAStart = iff(HasOA, EventTime_1, iff(NewCorrelationGroup, datetime(null), SequenceState.LatestOAStart));
)
| where CompleteNow
| project WindowStart = EventTime_1 - 5m, WindowEnd = EventTime_1, ["Case"] = GroupCase, ["Host"] = GroupHost, RuleCount = tolong(2)
};
let SourceMatchArrivals = union (C()
| project EventTime = todatetime(["WindowEnd"]), GroupCase = ["Case"], GroupHost = ["Host"])
| where isnotnull(EventTime) and isnotempty(GroupCase) and isnotempty(GroupHost)
| summarize SourceMatchCount = count() by EventTime, GroupCase, GroupHost;
union (SourceMatchArrivals
| project GroupCase, GroupHost, CountBoundaryTime = EventTime, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupCase, GroupHost, CountBoundaryTime = EventTime + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupCase asc, GroupHost asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupCase != prev(GroupCase) or GroupHost != prev(GroupHost))
| where CountBoundaryOrder == 0
| where EventCount >= 2
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, ["Case"] = GroupCase, ["Host"] = GroupHost, EventCount
};
let Expected = datatable(WindowStart:datetime, WindowEnd:datetime, Case:string, Host:string, EventCount:long) [
    datetime(2026-01-01T11:57:00Z), datetime(2026-01-01T12:02:00Z), "ordered-event", "host", 2
];
union (Actual() | extend Case=tostring(Case), Host=tostring(Host) | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Case, Host, EventCount
| where Delta != 0
