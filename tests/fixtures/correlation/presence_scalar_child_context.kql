// Public Sigma conversion; expected rows are worked inclusive-window examples.
let Events=datatable(Timestamp:datetime,Host:string,Marker:string) [
datetime(2026-01-01T00:00:00Z),"g","A",
        datetime(2026-01-01T00:01:00Z),"g","A"
 ] | extend User=iff(Timestamp == datetime(2026-01-01T00:00:00Z),"Alice","Bob");
let Actual=(){
let Child = () {
let ContextSummary = () {
let SourceMatchArrivals = union (Events
| where Marker =~ "A"
| project EventTime_1 = todatetime(["Timestamp"]), GroupHost = ["Host"])
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
| summarize SourceMatchCount = count() by EventTime_1, GroupHost;
union (SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime_1 + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupHost asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupHost != prev(GroupHost))
| where CountBoundaryOrder == 0
| where EventCount >= 1
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, ["Host"] = GroupHost, EventCount
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId = row_number());
let WindowSourceMatches = materialize(
CorrelationMatches | project CorrelationMatchId, CompletionTime = WindowEnd, ContextGroupHost = ["Host"], ContextPartition = 1
| join kind=inner (
union (Events
| where Marker =~ "A"
| extend ContextEventTime = todatetime(["Timestamp"]), ContextGroupHost = ["Host"], ContextUser = ["User"]
| extend ContextSourceRule = "A")
| project ContextEventTime, ContextSourceRule, ContextGroupHost, ContextUser, ContextPartition = 1
) on ContextGroupHost
| where ContextEventTime between ((CompletionTime - 5m) .. CompletionTime));
let CompleteContextRelationships = materialize(WindowSourceMatches
| project CorrelationMatchId, ContextUser
| distinct *);
union (CorrelationMatches | extend ContextRowKind = "Summary"), (CorrelationMatches | join kind=inner (CompleteContextRelationships) on CorrelationMatchId | extend ContextRowKind = "ContextEvidence")
};
let ChildResults = materialize(Child());
let ContextSummary = () {
union (ChildResults
| where ["ContextRowKind"] == "Summary"
| project EventTime = todatetime(["WindowEnd"]), GroupHost = ["Host"], SourceRule = "child")
| where isnotnull(EventTime) and isnotempty(GroupHost)
// Batch simultaneous source matches before updating inclusive trailing presence.
| summarize MatchesChild = countif(SourceRule == "child") > 0 by GroupHost, EventTime
| sort by GroupHost asc, EventTime asc
| extend NewCorrelationGroup = isnull(prev(EventTime)) or GroupHost != prev(GroupHost)
| scan declare (LastChildTime:datetime) with (
    step PresenceWindow: true =>
        LastChildTime = iff(MatchesChild, EventTime, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastChildTime));
)
// Only source-match timestamps evaluate; expiration never creates an anchor.
| extend HasChild = isnotnull(LastChildTime) and LastChildTime >= EventTime - 5m
| extend RuleCount = tolong(HasChild)
| where RuleCount >= 1
| project WindowStart = EventTime - 5m, WindowEnd = EventTime, ["Host"] = GroupHost, RuleCount
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId = row_number());
let WindowSourceMatches = materialize(
CorrelationMatches | project CorrelationMatchId, CompletionTime = WindowEnd, ContextGroupHost = ["Host"], ContextPartition = 1
| join kind=inner (
union (ChildResults | where ["ContextRowKind"] == "Summary"
| project-away ["ContextUser"]
| join kind=leftouter (ChildResults | where ["ContextRowKind"] == "ContextEvidence" | project ["CorrelationMatchId"], ["ContextUser"], HasContextEvidence = true) on ["CorrelationMatchId"]
| extend ContextEventTime = todatetime(["WindowEnd"]), ContextGroupHost = ["Host"], ContextUser = ["ContextUser"]
| extend ContextSourceRule = "child")
| project ContextEventTime, ContextSourceRule, ContextGroupHost, ContextUser, HasContextEvidence, ContextPartition = 1
) on ContextGroupHost
| where ContextEventTime between ((CompletionTime - 5m) .. CompletionTime));
let CompleteContextRelationships = materialize(WindowSourceMatches
| where HasContextEvidence
| project CorrelationMatchId, ContextUser
| distinct *);
let ValuesForUser = CompleteContextRelationships
| where isnotnull(ContextUser)
| summarize by CorrelationMatchId, ContextUser
| summarize DisplayedUser = make_list(ContextUser, 1000), DistinctUserCount = count() by CorrelationMatchId;
CorrelationMatches
| join kind=leftouter (ValuesForUser) on CorrelationMatchId
| extend ["User"] = coalesce(DisplayedUser, dynamic([]))
| extend ContextComplete = coalesce(DistinctUserCount, 0) <= 1000
| project ["WindowStart"], ["WindowEnd"], ["Host"], ["User"], ["RuleCount"], ["ContextComplete"]
| extend Host=iff(ContextComplete, strcat(Host,"/",strcat_array(array_sort_asc(User),",")), "INCOMPLETE")
};
let Expected=datatable(WindowEnd:datetime,Host:string,RuleCount:long) [
datetime(2026-01-01T00:00:00Z),"g/Alice",1,
        datetime(2026-01-01T00:01:00Z),"g/Alice,Bob",1
];
union (Actual() | project WindowEnd,Host,RuleCount | extend Delta=1), (Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowEnd,Host,RuleCount
| where Delta!=0
