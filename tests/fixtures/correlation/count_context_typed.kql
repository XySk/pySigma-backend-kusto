let Events=datatable(Timestamp:datetime,Host:string,Marker:string,User:dynamic) [
 datetime(2026-01-01T12:00:00Z),"h","match",dynamic("one"),
 datetime(2026-01-01T12:00:00Z),"h","match",dynamic("two"),
 datetime(2026-01-01T12:00:00Z),"h","match",dynamic("one")
]
// Normalize Events scalar fixture inputs explicitly.
| extend User=tostring(User);
let Actual=(){
let Child = () {
let ContextSummary = () {
let SourceMatchArrivals = Events
| where Marker =~ "match"
| project EventTime_1 = ["Timestamp"], GroupHost = ["Host"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
| summarize SourceMatchCount = count() by EventTime_1, GroupHost;
union (SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime_1 + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupHost asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupHost != prev(GroupHost))
| where CountBoundaryOrder == 0
| where EventCount >= 1
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, ["Host"] = GroupHost, EventCount
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId = row_number());
let WindowSourceMatches =
CorrelationMatches | project CorrelationMatchId, CompletionTime = WindowEnd, ContextGroupHost = ["Host"], ContextPartition = 1
| join kind=inner (
Events
| where Marker =~ "match"
| extend ContextEventTime = ["Timestamp"], ContextGroupHost = ["Host"], ContextUser = ["User"]
| where isnotnull(ContextEventTime) and isnotempty(ContextGroupHost)
| extend ContextSourceRule = "source-rule"
| project ContextEventTime, ContextSourceRule, ContextGroupHost, ContextUser, ContextPartition = 1
) on ContextGroupHost
| where ContextEventTime between ((CompletionTime - 5m) .. CompletionTime);
let CompleteContextRelationships = materialize(WindowSourceMatches
| project CorrelationMatchId, ContextUser
| distinct *);
union (CorrelationMatches | extend ContextRowKind = "Summary"), (CorrelationMatches | join kind=inner (CompleteContextRelationships) on CorrelationMatchId | extend ContextRowKind = "ContextEvidence")
};
let ChildResults = materialize(Child());
let ParentSourceMatches = materialize(ChildResults
| where ["ContextRowKind"] == "ContextEvidence"
| extend ChildCorrelationMatch = strcat("Child", "_", tostring(["CorrelationMatchId"]))
| project EventTime = ["WindowEnd"], GroupUser = ["ContextUser"], ChildCorrelationMatch
| where isnotnull(EventTime) and isnotempty(GroupUser)
| extend ChildCorrelationMatch = tostring(column_ifexists("ChildCorrelationMatch", "")));
let SourceMatchArrivals = union (ParentSourceMatches | where isempty(ChildCorrelationMatch)), (ParentSourceMatches | where isnotempty(ChildCorrelationMatch) | summarize take_any(*) by ChildCorrelationMatch, GroupUser)
| summarize SourceMatchCount = count() by EventTime, GroupUser;
union (SourceMatchArrivals
| project GroupUser, CountBoundaryTime = EventTime, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupUser, CountBoundaryTime = EventTime + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupUser asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupUser != prev(GroupUser))
| where CountBoundaryOrder == 0
| where EventCount >= 1
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, ["User"] = GroupUser, EventCount
| extend ContextComplete = true
};
let Observed=Actual() | project WindowEnd, Kind=gettype(User), Value=tostring(User), EventCount;
let Expected=datatable(WindowEnd:datetime,Kind:string,Value:string,EventCount:long) [
 datetime(2026-01-01T12:00:00Z),"string","one",1,
 datetime(2026-01-01T12:00:00Z),"string","two",1
];
union (Observed | extend Delta=1), (Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowEnd,Kind,Value,EventCount
| where Delta!=0
