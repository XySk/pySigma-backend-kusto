// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
let Events=datatable(Timestamp:datetime,Case:string,Value:long,Marker:string) [
 datetime(2026-01-01T12:00:00Z),"scalar",1,"match",
 datetime(2026-01-01T12:01:00Z),"scalar",2,"match",
 datetime(2026-01-01T12:02:00Z),"scalar",2,"match",
 datetime(2026-01-01T12:03:00Z),"scalar",long(null),"match"
];
let Actual = () {
let _sigma_values = union (Events
| where Marker =~ "match"
| extend _sigma_timestamp = todatetime(["Timestamp"]), _sigma_group_0 = ["Case"], _sigma_value = ["Value"]
| extend _sigma_rule = "E")
| where isnotnull(_sigma_timestamp) and isnotempty(_sigma_group_0)
| summarize by _sigma_timestamp, _sigma_group_0, _sigma_value;
_sigma_values
| project _sigma_group_0, _sigma_window_end = _sigma_timestamp, _sigma_bin = bin(_sigma_timestamp, 5m)
| distinct *
| join kind=inner (
    _sigma_values
    | extend _sigma_bin = pack_array(bin(_sigma_timestamp, 5m), bin(_sigma_timestamp, 5m) + 5m)
    | mv-expand _sigma_bin to typeof(datetime)
) on _sigma_group_0, _sigma_bin
| where _sigma_timestamp between ((_sigma_window_end - 5m) .. _sigma_window_end)
| summarize ValueCount = count_distinctif(_sigma_value, isnotempty(_sigma_value)) by _sigma_window_end, _sigma_group_0
| where ValueCount >= 2
| project WindowStart = _sigma_window_end - 5m, WindowEnd = _sigma_window_end, ["Case"] = _sigma_group_0, ValueCount
};
let Expected=datatable(WindowStart:datetime,WindowEnd:datetime,Case:string,ValueCount:long) [
 datetime(2026-01-01T11:56:00Z),datetime(2026-01-01T12:01:00Z),"scalar",2,
 datetime(2026-01-01T11:57:00Z),datetime(2026-01-01T12:02:00Z),"scalar",2,
 datetime(2026-01-01T11:58:00Z),datetime(2026-01-01T12:03:00Z),"scalar",2];
union (Actual() | extend Case=tostring(Case) | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Case, ValueCount
| where Delta != 0
