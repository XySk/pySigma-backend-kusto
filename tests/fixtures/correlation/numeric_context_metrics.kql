let Events=datatable(Timestamp:datetime,Host:string,Marker:string,User:string,Amount:dynamic) [
 datetime(2026-01-01T12:00:00Z),"h","match","Alice",dynamic(10),
 datetime(2026-01-01T12:00:00Z),"h","match","Alice",dynamic(10),
 datetime(2026-01-01T12:00:00Z),"h","match","Alice",dynamic(20),
 datetime(2026-01-01T12:00:00Z),"h","match","Bob",dynamic(100),
 datetime(2026-01-01T12:00:00Z),"h2","match","Alice",dynamic(10),
 datetime(2026-01-01T12:00:00Z),"d","direct","Alice",dynamic(5)
]
// Normalize Events scalar fixture inputs explicitly.
| extend Amount=iff(gettype(Amount) in ("int","long","real","double","decimal"), tolong(Amount), long(null));
let Actual=(){
let _sigma_shared_child = () {
let _sigma_context_summary = () {
let SourceMatchArrivals = union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]), GroupHost = ["Host"])
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
| summarize SourceMatchCount = count() by EventTime_1, GroupHost;
union (SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime_1 + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupHost asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupHost != prev(GroupHost))
| where CountBoundaryOrder == 0
| where EventCount >= 1
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, ["Host"] = GroupHost, EventCount
};
let _sigma_context_summaries = materialize(_sigma_context_summary()
| serialize _sigma_context_id = row_number());
let _sigma_context_matches = materialize(
_sigma_context_summaries | project _sigma_context_id, _sigma_context_end = WindowEnd, _sigma_context_group = ["Host"], _sigma_context_partition = 1
| join kind=inner (
union (Events
| where Marker =~ "match"
| extend _sigma_context_timestamp = todatetime(["Timestamp"]), _sigma_context_group = ["Host"], _sigma_context_value = ["User"], _sigma_context_value_1 = ["Amount"]
| extend _sigma_context_rule = "source-rule")
| project _sigma_context_timestamp, _sigma_context_rule, _sigma_context_group, _sigma_context_value, _sigma_context_value_1, _sigma_context_partition = 1
) on _sigma_context_group
| where _sigma_context_timestamp between ((_sigma_context_end - 5m) .. _sigma_context_end)
| serialize _sigma_context_key = row_number());
let _sigma_context_rows = materialize(_sigma_context_matches
| project _sigma_context_id, _sigma_context_value, _sigma_context_value_1
| distinct *);
union (_sigma_context_summaries | extend ContextRowKind = "Summary"), (_sigma_context_summaries | join kind=inner (_sigma_context_rows) on _sigma_context_id | extend ContextRowKind = "ContextEvidence")
};
let _sigma_shared_results = materialize(_sigma_shared_child());
let _sigma_context_summary = () {
let _sigma_parent_matches = materialize(union (_sigma_shared_results
| where ["ContextRowKind"] == "ContextEvidence"
| extend _sigma_child_match = strcat("_sigma_shared_child", "_", tostring(["_sigma_context_id"]))
| project EventTime = todatetime(["WindowEnd"]), GroupActor = ["_sigma_context_value"], MeasuredEventCount = ["EventCount"], _sigma_child_match)
| extend _sigma_child_match = tostring(column_ifexists("_sigma_child_match", "")));
let SumObservations = union (_sigma_parent_matches | where isempty(_sigma_child_match)), (_sigma_parent_matches | where isnotempty(_sigma_child_match) | extend RetainedNumericValue = MeasuredEventCount | summarize take_any(*) by _sigma_child_match, GroupActor, RetainedNumericValue)
| where isnotnull(EventTime) and isnotempty(GroupActor);
let SumArrivals = SumObservations
| summarize ArrivalSum = sum(MeasuredEventCount) by EventTime, GroupActor;
union (SumArrivals
| project GroupActor, SumBoundaryTime = EventTime, SumBoundaryOrder = 0, SumDelta = ArrivalSum),
(SumArrivals
| project GroupActor, SumBoundaryTime = EventTime + 5m, SumBoundaryOrder = 1, SumDelta = -ArrivalSum)
// Arrivals evaluate before equal-time expirations, including zero and missing values.
| sort by GroupActor asc, SumBoundaryTime asc, SumBoundaryOrder asc
| extend ValueSum = row_cumsum(SumDelta, GroupActor != prev(GroupActor))
| where SumBoundaryOrder == 0
| where ValueSum >= -1
| project WindowStart = SumBoundaryTime - 5m, WindowEnd = SumBoundaryTime, ["Actor"] = GroupActor, ValueSum
};
let _sigma_context_summaries = materialize(_sigma_context_summary()
| serialize _sigma_context_id_1 = row_number());
let _sigma_context_matches = materialize(
_sigma_context_summaries | project _sigma_context_id_1, _sigma_context_end = WindowEnd, _sigma_context_group = ["Actor"], _sigma_context_partition = 1
| join kind=inner (
union (_sigma_shared_results
| where ["ContextRowKind"] == "ContextEvidence"
| extend _sigma_context_timestamp = todatetime(["WindowEnd"]), _sigma_context_group = tostring(pack_array(gettype(["_sigma_context_value"]), ["_sigma_context_value"])[1]), _sigma_context_value_1 = tolong(pack_array(gettype(["_sigma_context_value_1"]), ["_sigma_context_value_1"])[1])
| extend _sigma_context_rule = "child")
| project _sigma_context_timestamp, _sigma_context_rule, _sigma_context_group, _sigma_context_value_1, _sigma_context_partition = 1
) on _sigma_context_group
| where _sigma_context_timestamp between ((_sigma_context_end - 5m) .. _sigma_context_end)
| serialize _sigma_context_key = row_number());
let _sigma_context_rows = materialize(_sigma_context_matches
| project _sigma_context_id_1, _sigma_context_value_1
| distinct *);
let ContextValues = _sigma_context_rows
| where isnotnull(_sigma_context_value_1)
| summarize by _sigma_context_id_1, _sigma_context_value_1
| summarize DisplayedValues = make_list(_sigma_context_value_1, 1000), DistinctValueCount = count() by _sigma_context_id_1;
_sigma_context_summaries
| join kind=leftouter (ContextValues) on _sigma_context_id_1
| extend ["Amount"] = coalesce(DisplayedValues, dynamic([]))
| extend ContextComplete = coalesce(DistinctValueCount, 0) <= 1000
| project ["WindowStart"], ["WindowEnd"], ["Actor"], ["Amount"], ["ValueSum"], ["ContextComplete"]
};
let Observed=Actual() | project Actor=tostring(Actor), Metric=toreal(ValueSum);
let Expected=datatable(Actor:string, Metric:real) ["Alice",real(5), "Bob",real(4)];
union (Observed | extend Delta=1), (Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by Actor, Metric
| where Delta!=0
