let Events=datatable(Timestamp:datetime, Host:string, Marker:string, Amount:long) [datetime(2026-01-01), "h", "A", 42];
let Actual=(){
let Child = () {
let ContextSummary = () {
union (Events
| where Marker =~ "A"
| project EventTime_1 = todatetime(["Timestamp"]), SourceRule = "A"),
(Events
| where Marker =~ "B"
| project EventTime_1 = todatetime(["Timestamp"]), SourceRule = "B")
| where isnotnull(EventTime_1)
// Batch simultaneous source matches before updating inclusive trailing presence.
| summarize MatchesA = countif(SourceRule == "A") > 0, MatchesB = countif(SourceRule == "B") > 0 by EventTime_1
| sort by EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1))
| scan declare (LastATime:datetime, LastBTime:datetime) with (
    step PresenceWindow: true =>
        LastATime = iff(MatchesA, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastATime)),
        LastBTime = iff(MatchesB, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastBTime));
)
// Only source-match timestamps evaluate; expiration never creates an anchor.
| extend HasA = isnotnull(LastATime) and LastATime >= EventTime_1 - 5m, HasB = isnotnull(LastBTime) and LastBTime >= EventTime_1 - 5m
| extend RuleCount = tolong(HasA) + tolong(HasB)
| where (not(HasA) or not(HasB))
| project WindowStart = EventTime_1 - 5m, WindowEnd = EventTime_1, RuleCount
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId = row_number());
let WindowSourceMatches = materialize(
CorrelationMatches | project CorrelationMatchId, CompletionTime = WindowEnd, ContextPartition = 1
| join kind=inner (
union (Events
| where Marker =~ "A"
| extend ContextEventTime = todatetime(["Timestamp"]), ContextAmount = ["Amount"]
| extend ContextSourceRule = "A"),
(Events
| where Marker =~ "B"
| extend ContextEventTime = todatetime(["Timestamp"]), ContextAmount = ["Amount"]
| extend ContextSourceRule = "B")
| project ContextEventTime, ContextSourceRule, ContextAmount, ContextPartition = 1
) on ContextPartition
| where ContextEventTime between ((CompletionTime - 5m) .. CompletionTime));
let BooleanParticipants = materialize(WindowSourceMatches
| join kind=inner (WindowSourceMatches | summarize HasA_1 = countif(ContextSourceRule == "A") > 0, HasB_1 = countif(ContextSourceRule == "B") > 0 by CorrelationMatchId) on CorrelationMatchId
| where ((not(HasA_1) and (false)) or (not(HasB_1) and (false))));
let CompleteContextRelationships = materialize(BooleanParticipants
| project CorrelationMatchId, ContextAmount
| distinct *);
union (CorrelationMatches | extend ContextRowKind = "Summary"), (CorrelationMatches | join kind=inner (CompleteContextRelationships) on CorrelationMatchId | extend ContextRowKind = "ContextEvidence")
};
let ChildResults = materialize(Child());
let ValueCountSources = materialize(union (ChildResults
| where ["ContextRowKind"] == "ContextEvidence"
| project EventTime = todatetime(["WindowEnd"]), GroupAmount = ["ContextAmount"], CountedAmount = ["ContextAmount"])
| where isnotnull(EventTime) and isnotempty(GroupAmount));
let CountedAmountActivity = materialize(ValueCountSources
| where isnotempty(CountedAmount)
| summarize by GroupAmount, CountedAmount, EventTime
| sort by GroupAmount asc, CountedAmount asc, EventTime asc
// Repeated values whose inclusive active intervals overlap contribute only once.
| extend CountedAmountStarts = isnull(prev(EventTime)) or GroupAmount != prev(GroupAmount) or CountedAmount != prev(CountedAmount) or EventTime > prev(EventTime) + 5m,
    CountedAmountEnds = isnull(next(EventTime)) or GroupAmount != next(GroupAmount) or CountedAmount != next(CountedAmount) or next(EventTime) > EventTime + 5m);
union (ValueCountSources | summarize by GroupAmount, EventTime
| project GroupAmount, ValueBoundaryTime = EventTime, ValueBoundaryOrder = 1, CountedAmountDelta = 0),
(CountedAmountActivity | where CountedAmountStarts
| project GroupAmount, ValueBoundaryTime = EventTime, ValueBoundaryOrder = 0, CountedAmountDelta = 1),
(CountedAmountActivity | where CountedAmountEnds
| project GroupAmount, ValueBoundaryTime = EventTime + 5m, ValueBoundaryOrder = 2, CountedAmountDelta = -1)
// All interval starts precede anchors; equal-time expirations follow them.
| sort by GroupAmount asc, ValueBoundaryTime asc, ValueBoundaryOrder asc
| extend ValueCount = row_cumsum(CountedAmountDelta, GroupAmount != prev(GroupAmount))
| where ValueBoundaryOrder == 1
| where ValueCount == 0
| project WindowStart = ValueBoundaryTime - 5m, WindowEnd = ValueBoundaryTime, ["Amount"] = GroupAmount, ValueCount
| extend ContextComplete = true
};
let Observed=Actual() | project WindowEnd, Metric=toreal(ValueCount), Values=long(0), ContextComplete;
let Expected=datatable(WindowEnd:datetime, Metric:real, Values:long, ContextComplete:bool) [];
union (Observed | extend Delta=1), (Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowEnd, Metric, Values, ContextComplete
| where Delta!=0
