// Public-conversion comparison; execution status is hash-scoped in RUNTIME.md.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
// The only anchors/counts are 12:00=2, 12:05=3, 12:05:00.0000001=2, 12:20=1.
// Expiring events between these times never create evaluations. eq-zero stays empty.
let Events=datatable(Timestamp:string, Marker:string) [
    "2026-01-01T12:00:00Z", "match",
    "2026-01-01T12:00:00Z", "match",
    "2026-01-01T12:05:00Z", "match",
    "2026-01-01T12:05:00.0000001Z", "match",
    "2026-01-01T12:20:00Z", "match",
    "invalid", "match"
]
// Normalize Events scalar fixture inputs explicitly.
| extend Timestamp=todatetime(Timestamp);
let gt_2 = () {
let SourceMatchArrivals = union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]))
| where isnotnull(EventTime_1)
| summarize SourceMatchCount = count() by EventTime_1;
union (SourceMatchArrivals
| project CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project CountBoundaryTime = EventTime_1 + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta)
| where CountBoundaryOrder == 0
| where EventCount > 2
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, EventCount
};
let gte_2 = () {
let SourceMatchArrivals = union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]))
| where isnotnull(EventTime_1)
| summarize SourceMatchCount = count() by EventTime_1;
union (SourceMatchArrivals
| project CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project CountBoundaryTime = EventTime_1 + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta)
| where CountBoundaryOrder == 0
| where EventCount >= 2
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, EventCount
};
let lt_2 = () {
let SourceMatchArrivals = union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]))
| where isnotnull(EventTime_1)
| summarize SourceMatchCount = count() by EventTime_1;
union (SourceMatchArrivals
| project CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project CountBoundaryTime = EventTime_1 + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta)
| where CountBoundaryOrder == 0
| where EventCount < 2
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, EventCount
};
let lte_2 = () {
let SourceMatchArrivals = union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]))
| where isnotnull(EventTime_1)
| summarize SourceMatchCount = count() by EventTime_1;
union (SourceMatchArrivals
| project CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project CountBoundaryTime = EventTime_1 + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta)
| where CountBoundaryOrder == 0
| where EventCount <= 2
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, EventCount
};
let eq_2 = () {
let SourceMatchArrivals = union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]))
| where isnotnull(EventTime_1)
| summarize SourceMatchCount = count() by EventTime_1;
union (SourceMatchArrivals
| project CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project CountBoundaryTime = EventTime_1 + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta)
| where CountBoundaryOrder == 0
| where EventCount == 2
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, EventCount
};
let neq_2 = () {
let SourceMatchArrivals = union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]))
| where isnotnull(EventTime_1)
| summarize SourceMatchCount = count() by EventTime_1;
union (SourceMatchArrivals
| project CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project CountBoundaryTime = EventTime_1 + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta)
| where CountBoundaryOrder == 0
| where EventCount != 2
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, EventCount
};
let eq_0 = () {
let SourceMatchArrivals = union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]))
| where isnotnull(EventTime_1)
| summarize SourceMatchCount = count() by EventTime_1;
union (SourceMatchArrivals
| project CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project CountBoundaryTime = EventTime_1 + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta)
| where CountBoundaryOrder == 0
| where EventCount == 0
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, EventCount
};
let Actual = union
    (gt_2() | extend Scenario = "gt_2"),
    (gte_2() | extend Scenario = "gte_2"),
    (lt_2() | extend Scenario = "lt_2"),
    (lte_2() | extend Scenario = "lte_2"),
    (eq_2() | extend Scenario = "eq_2"),
    (neq_2() | extend Scenario = "neq_2"),
    (eq_0() | extend Scenario = "eq_0");
let Expected = datatable(Scenario:string, WindowStart:datetime, WindowEnd:datetime, EventCount:long) [
    "gt_2", datetime(2026-01-01T12:00:00Z), datetime(2026-01-01T12:05:00Z), 3,
    "gte_2", datetime(2026-01-01T11:55:00Z), datetime(2026-01-01T12:00:00Z), 2,
    "gte_2", datetime(2026-01-01T12:00:00Z), datetime(2026-01-01T12:05:00Z), 3,
    "gte_2", datetime(2026-01-01T12:00:00.0000001Z), datetime(2026-01-01T12:05:00.0000001Z), 2,
    "lt_2", datetime(2026-01-01T12:15:00Z), datetime(2026-01-01T12:20:00Z), 1,
    "lte_2", datetime(2026-01-01T11:55:00Z), datetime(2026-01-01T12:00:00Z), 2,
    "lte_2", datetime(2026-01-01T12:00:00.0000001Z), datetime(2026-01-01T12:05:00.0000001Z), 2,
    "lte_2", datetime(2026-01-01T12:15:00Z), datetime(2026-01-01T12:20:00Z), 1,
    "eq_2", datetime(2026-01-01T11:55:00Z), datetime(2026-01-01T12:00:00Z), 2,
    "eq_2", datetime(2026-01-01T12:00:00.0000001Z), datetime(2026-01-01T12:05:00.0000001Z), 2,
    "neq_2", datetime(2026-01-01T12:00:00Z), datetime(2026-01-01T12:05:00Z), 3,
    "neq_2", datetime(2026-01-01T12:15:00Z), datetime(2026-01-01T12:20:00Z), 1
];
union (Actual | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by Scenario, WindowStart, WindowEnd, EventCount
| where Delta != 0
