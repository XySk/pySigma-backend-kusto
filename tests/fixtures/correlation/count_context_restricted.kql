let Events=datatable(Timestamp:datetime,Host:string,Marker:string,User:dynamic,Server:string) [
 datetime(2026-01-01T12:00:00Z),"h","match",dynamic("Alice"),"server1",
 datetime(2026-01-01T12:00:00Z),"h","match",dynamic("Bob"),"server2",
 datetime(2026-01-01T12:00:00Z),"h","match",dynamic("Alice"),"server1",
 datetime(2026-01-01T12:00:00Z),"h2","match",dynamic("Alice"),"server1",
 datetime(2026-01-01T12:00:00Z),"d","direct",dynamic("Alice"),"server1"
]
// Normalize Events scalar fixture inputs explicitly.
| extend User=tostring(User);
let Actual=(){
let Child = () {
let ContextSummary = () {
let SourceMatchArrivals = Events
| where Marker =~ "match"
| project EventTime_1 = ["Timestamp"], GroupHost = ["Host"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
| summarize SourceMatchCount = count() by EventTime_1, GroupHost;
union (SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime_1 + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupHost asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupHost != prev(GroupHost))
| where CountBoundaryOrder == 0
| where EventCount >= 1
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, ["Host"] = GroupHost, EventCount
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId = row_number());
let WindowSourceMatches = materialize(
CorrelationMatches | project CorrelationMatchId, CompletionTime = WindowEnd, ContextGroupHost = ["Host"], ContextPartition = 1
| join kind=inner (
Events
| where Marker =~ "match"
| extend ContextEventTime = ["Timestamp"], ContextGroupHost = ["Host"], ContextUser = ["User"], ContextServer = ["Server"]
| where isnotnull(ContextEventTime) and isnotempty(ContextGroupHost)
| extend ContextSourceRule = "source-rule"
| project ContextEventTime, ContextSourceRule, ContextGroupHost, ContextUser, ContextServer, ContextPartition = 1
) on ContextGroupHost
| where ContextEventTime between ((CompletionTime - 5m) .. CompletionTime));
let CompleteContextRelationships = materialize(WindowSourceMatches
| project CorrelationMatchId, ContextUser, ContextServer
| distinct *);
union (CorrelationMatches | extend ContextRowKind = "Summary"), (CorrelationMatches | join kind=inner (CompleteContextRelationships) on CorrelationMatchId | extend ContextRowKind = "ContextEvidence")
};
let ChildResults = materialize(Child());
let ContextSummary = () {
let ValueCountSources = materialize(ChildResults
| where ["ContextRowKind"] == "ContextEvidence"
| project EventTime = ["WindowEnd"], GroupServer = ["ContextServer"], CountedUser = ["ContextUser"]
| where isnotnull(EventTime) and isnotempty(GroupServer));
let CountedUserActivity = materialize(ValueCountSources
| where isnotempty(CountedUser)
| summarize by GroupServer, CountedUser, EventTime
| sort by GroupServer asc, CountedUser asc, EventTime asc
// Repeated values whose inclusive active intervals overlap contribute only once.
| extend CountedUserStarts = isnull(prev(EventTime)) or GroupServer != prev(GroupServer) or CountedUser != prev(CountedUser) or EventTime > prev(EventTime) + 5m,
    CountedUserEnds = isnull(next(EventTime)) or GroupServer != next(GroupServer) or CountedUser != next(CountedUser) or next(EventTime) > EventTime + 5m);
union (ValueCountSources | summarize by GroupServer, EventTime
| project GroupServer, ValueBoundaryTime = EventTime, ValueBoundaryOrder = 1, CountedUserDelta = 0),
(CountedUserActivity | where CountedUserStarts
| project GroupServer, ValueBoundaryTime = EventTime, ValueBoundaryOrder = 0, CountedUserDelta = 1),
(CountedUserActivity | where CountedUserEnds
| project GroupServer, ValueBoundaryTime = EventTime + 5m, ValueBoundaryOrder = 2, CountedUserDelta = -1)
// All interval starts precede anchors; equal-time expirations follow them.
| sort by GroupServer asc, ValueBoundaryTime asc, ValueBoundaryOrder asc
| extend ValueCount = row_cumsum(CountedUserDelta, GroupServer != prev(GroupServer))
| where ValueBoundaryOrder == 1
| where ValueCount >= 1
| project WindowStart = ValueBoundaryTime - 5m, WindowEnd = ValueBoundaryTime, ["Server"] = GroupServer, ValueCount
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId = row_number());
let WindowSourceMatches = materialize(
CorrelationMatches | project CorrelationMatchId, CompletionTime = WindowEnd, ContextGroupServer = ["Server"], ContextPartition = 1
| join kind=inner (
ChildResults | where ["ContextRowKind"] == "Summary"
| project-away ["ContextUser"], ["ContextServer"]
| join kind=leftouter (ChildResults | where ["ContextRowKind"] == "ContextEvidence" | project ["CorrelationMatchId"], ["ContextUser"], ["ContextServer"], HasContextEvidence = true) on ["CorrelationMatchId"]
| extend ContextEventTime = ["WindowEnd"], ContextGroupServer = ["ContextServer"], ContextUser_1 = ["ContextUser"]
| where isnotnull(ContextEventTime) and isnotempty(ContextGroupServer)
| extend ContextSourceRule = "child"
| project ContextEventTime, ContextSourceRule, ContextGroupServer, ContextUser_1, HasContextEvidence, ContextPartition = 1
) on ContextGroupServer
| where ContextEventTime between ((CompletionTime - 5m) .. CompletionTime));
let CompleteContextRelationships = materialize(WindowSourceMatches
| where HasContextEvidence
| project CorrelationMatchId, ContextUser_1
| distinct *);
let ValuesForUser = CompleteContextRelationships
| where isnotnull(ContextUser_1)
| summarize by CorrelationMatchId, ContextUser_1
| summarize DisplayedUser = make_list(ContextUser_1, 1000), DistinctUserCount = count() by CorrelationMatchId;
CorrelationMatches
| join kind=leftouter (ValuesForUser) on CorrelationMatchId
| extend ["User"] = coalesce(DisplayedUser, dynamic([]))
| extend ContextComplete = coalesce(DistinctUserCount, 0) <= 1000
| project ["WindowStart"], ["WindowEnd"], ["Server"], ["User"], ["ValueCount"], ["ContextComplete"]
};
let Observed=Actual() | project WindowEnd, Server, Metric=ValueCount | project WindowEnd, Server=tostring(Server), Metric;
let Expected=datatable(WindowEnd:datetime, Server:dynamic, Metric:long) [datetime(2026-01-01T12:00:00Z),dynamic("server1"),1, datetime(2026-01-01T12:00:00Z),dynamic("server2"),1] | project WindowEnd, Server=tostring(Server), Metric;
union (Observed | extend Delta=1), (Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowEnd, Server, Metric
| where Delta!=0
