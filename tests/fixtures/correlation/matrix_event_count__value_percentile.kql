// Public-conversion comparison; execution status is hash-scoped in RUNTIME.md.
let Events=datatable(Timestamp:datetime,Marker:string,Amount:real) [
 datetime(2026-01-01T12:00:00Z),"match",2.5
];
let Actual=(){
let Child = () {
let ContextSummary = () {
let SourceMatchArrivals = union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]))
| where isnotnull(EventTime_1)
| summarize SourceMatchCount = count() by EventTime_1;
union (SourceMatchArrivals
| project CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project CountBoundaryTime = EventTime_1 + 1m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta)
| where CountBoundaryOrder == 0
| where EventCount >= 1
| project WindowStart = CountBoundaryTime - 1m, WindowEnd = CountBoundaryTime, EventCount
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId = row_number());
let WindowSourceMatches = materialize(
CorrelationMatches | project CorrelationMatchId, CompletionTime = WindowEnd, ContextPartition = 1
| join kind=inner (
union (Events
| where Marker =~ "match"
| extend ContextEventTime = todatetime(["Timestamp"]), ContextAmount = ["Amount"]
| extend ContextSourceRule = "source-rule")
| project ContextEventTime, ContextSourceRule, ContextAmount, ContextPartition = 1
) on ContextPartition
| where ContextEventTime between ((CompletionTime - 1m) .. CompletionTime));
let CompleteContextRelationships = materialize(WindowSourceMatches
| project CorrelationMatchId, ContextAmount
| distinct *);
union (CorrelationMatches | extend ContextRowKind = "Summary"), (CorrelationMatches | join kind=inner (CompleteContextRelationships) on CorrelationMatchId | extend ContextRowKind = "ContextEvidence")
};
let ChildResults = materialize(Child());
let ContextSummary = () {
let ParentSourceMatches = materialize(union (ChildResults | where ["ContextRowKind"] == "Summary"
| project-away ["ContextAmount"]
| join kind=leftouter (ChildResults | where ["ContextRowKind"] == "ContextEvidence" | project ["CorrelationMatchId"], ["ContextAmount"]) on ["CorrelationMatchId"]
| extend ChildCorrelationMatch = strcat("Child", "_", tostring(["CorrelationMatchId"]))
| project EventTime = todatetime(["WindowEnd"]), MeasuredAmount = ["ContextAmount"], ChildCorrelationMatch)
| extend ChildCorrelationMatch = tostring(column_ifexists("ChildCorrelationMatch", "")));
let PercentileObservations = union (ParentSourceMatches | where isempty(ChildCorrelationMatch)), (ParentSourceMatches | where isnotempty(ChildCorrelationMatch) | extend RetainedNumericValue = MeasuredAmount | summarize take_any(*) by ChildCorrelationMatch, RetainedNumericValue)
| where isnotnull(EventTime);
let PercentileWindowValues = materialize(
PercentileObservations
| project PercentileWindowEnd = EventTime, PercentileTimeBin = bin(EventTime, 5m)
| distinct *
| join kind=inner (
PercentileObservations
| where isnotnull(MeasuredAmount) and isfinite(MeasuredAmount)
| extend PercentileTimeBin = pack_array(bin(EventTime, 5m), bin(EventTime, 5m) + 5m)
| mv-expand PercentileTimeBin to typeof(datetime)
) on PercentileTimeBin
| where EventTime between ((PercentileWindowEnd - 5m) .. PercentileWindowEnd)
| project PercentileWindowEnd, MeasuredAmount
);
PercentileWindowValues
| join kind=inner (
PercentileWindowValues | summarize PercentilePopulation = count() by PercentileWindowEnd
) on PercentileWindowEnd
| project PercentileWindowEnd, MeasuredAmount, PercentilePopulation
| sort by PercentileWindowEnd asc, MeasuredAmount asc
| serialize PercentileRank = row_number(1, PercentileWindowEnd != prev(PercentileWindowEnd))
| where PercentileRank == max_of(1, (PercentilePopulation / 100) * 50 + tolong(ceiling(toreal((PercentilePopulation % 100) * 50) / 100.0)))
| extend ValuePercentile = MeasuredAmount
| where ValuePercentile >= 1
| project WindowStart = PercentileWindowEnd - 5m, WindowEnd = PercentileWindowEnd, ValuePercentile
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId_1 = row_number());
let WindowSourceMatches = materialize(
CorrelationMatches | project CorrelationMatchId_1, CompletionTime = WindowEnd, ContextPartition = 1
| join kind=inner (
union (ChildResults | where ["ContextRowKind"] == "Summary"
| project-away ["ContextAmount"]
| join kind=leftouter (ChildResults | where ["ContextRowKind"] == "ContextEvidence" | project ["CorrelationMatchId"], ["ContextAmount"], HasContextEvidence = true) on ["CorrelationMatchId"]
| extend ContextEventTime = todatetime(["WindowEnd"]), ContextAmount_1 = ["ContextAmount"]
| extend ContextSourceRule = "child")
| project ContextEventTime, ContextSourceRule, ContextAmount_1, HasContextEvidence, ContextPartition = 1
) on ContextPartition
| where ContextEventTime between ((CompletionTime - 5m) .. CompletionTime));
let CompleteContextRelationships = materialize(WindowSourceMatches
| where HasContextEvidence
| project CorrelationMatchId_1, ContextAmount_1
| distinct *);
let ValuesForAmount = CompleteContextRelationships
| where isnotnull(ContextAmount_1)
| summarize by CorrelationMatchId_1, ContextAmount_1
| summarize DisplayedAmount = make_list(ContextAmount_1, 1000), DistinctAmountCount = count() by CorrelationMatchId_1;
CorrelationMatches
| join kind=leftouter (ValuesForAmount) on CorrelationMatchId_1
| extend ["Amount"] = coalesce(DisplayedAmount, dynamic([]))
| extend ContextComplete = coalesce(DistinctAmountCount, 0) <= 1000
| project ["WindowStart"], ["WindowEnd"], ["Amount"], ["ValuePercentile"], ["ContextComplete"]
};
let Observed=Actual() | project WindowStart,WindowEnd,Metric=toreal(ValuePercentile);
let Expected=datatable(WindowStart:datetime,WindowEnd:datetime,Metric:real) [
 datetime(2026-01-01T11:55:00Z),datetime(2026-01-01T12:00:00Z),2.5
];
union (Observed | extend Delta=1),(Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowStart,WindowEnd,Metric
| where Delta!=0
