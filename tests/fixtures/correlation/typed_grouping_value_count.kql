let Events=datatable(Timestamp:datetime,Host:string,Marker:string,User:long,Server:string,Amount:long) [
 datetime(2026-01-01T12:00:00Z),"h","match",1,"server",2,
 datetime(2026-01-01T12:00:00Z),"h","match",1,"server",2,
 datetime(2026-01-01T12:00:00Z),"h","match",2,"server",3,
 datetime(null),"h","match",1,"server",100,
 datetime(2026-01-01T12:00:00Z),"h","match",long(null),"server",100,
 datetime(2026-01-01T12:00:00Z),"h","match",1,"",100
];
let Actual=(){
let ValueCountSources = materialize(Events
| where Marker =~ "match"
| project EventTime_1 = ["Timestamp"], GroupUser = ["User"], GroupServer = ["Server"], CountedUser = ["User"]
| where isnotnull(EventTime_1) and isnotempty(GroupUser) and isnotempty(GroupServer));
let CountedUserActivity = materialize(ValueCountSources
| where isnotempty(CountedUser)
| summarize by GroupUser, GroupServer, CountedUser, EventTime_1
| sort by GroupUser asc, GroupServer asc, CountedUser asc, EventTime_1 asc
// Repeated values whose inclusive active intervals overlap contribute only once.
| extend CountedUserStarts = isnull(prev(EventTime_1)) or GroupUser != prev(GroupUser) or GroupServer != prev(GroupServer) or CountedUser != prev(CountedUser) or EventTime_1 > prev(EventTime_1) + 5m,
    CountedUserEnds = isnull(next(EventTime_1)) or GroupUser != next(GroupUser) or GroupServer != next(GroupServer) or CountedUser != next(CountedUser) or next(EventTime_1) > EventTime_1 + 5m);
union (ValueCountSources | summarize by GroupUser, GroupServer, EventTime_1
| project GroupUser, GroupServer, ValueBoundaryTime = EventTime_1, ValueBoundaryOrder = 1, CountedUserDelta = 0),
(CountedUserActivity | where CountedUserStarts
| project GroupUser, GroupServer, ValueBoundaryTime = EventTime_1, ValueBoundaryOrder = 0, CountedUserDelta = 1),
(CountedUserActivity | where CountedUserEnds
| project GroupUser, GroupServer, ValueBoundaryTime = EventTime_1 + 5m, ValueBoundaryOrder = 2, CountedUserDelta = -1)
// All interval starts precede anchors; equal-time expirations follow them.
| sort by GroupUser asc, GroupServer asc, ValueBoundaryTime asc, ValueBoundaryOrder asc
| extend ValueCount = row_cumsum(CountedUserDelta, GroupUser != prev(GroupUser) or GroupServer != prev(GroupServer))
| where ValueBoundaryOrder == 1
| where ValueCount >= 1
| project WindowStart = ValueBoundaryTime - 5m, WindowEnd = ValueBoundaryTime, ["User"] = GroupUser, ["Server"] = GroupServer, ValueCount
};
let Observed=Actual() | project WindowEnd,Kind=gettype(User),Value=tostring(User),Server=tostring(Server),Metric=toreal(ValueCount);
let Expected=datatable(WindowEnd:datetime,Kind:string,Value:string,Server:string,Metric:real) [
 datetime(2026-01-01T12:00:00Z),"long","1",'server',1,
 datetime(2026-01-01T12:00:00Z),"long","2",'server',1
];
union (Observed | extend Delta=1),(Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowEnd,Kind,Value,Server,Metric
| where Delta!=0
