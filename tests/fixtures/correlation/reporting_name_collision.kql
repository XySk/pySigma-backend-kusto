let Events=datatable(Timestamp:datetime,Host:string,Marker:string,ReportStart:datetime,ReportEnd:datetime) [datetime(2026-01-01T10:18:00Z),"h","match",datetime(2030-01-01),datetime(2020-01-01)];
let Expected=datatable(WindowEnd:datetime,Host:string,EventCount:long) [datetime(2026-01-01T10:18:00Z),"h",1] | extend WindowStart=WindowEnd-5m;
let Actual0 = () {
let ReportStart_ = datetime(2026-01-01T10:18:00.0000000Z);
let ReportEnd_ = datetime(2026-01-01T10:19:00.0000000Z);
let SourceMatchArrivals = Events
| where Marker =~ "match"
| where ["Timestamp"] >= ReportStart_ - 300s and ["Timestamp"] < ReportEnd_
| project EventTime_1 = ["Timestamp"], GroupHost = ["Host"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
| summarize SourceMatchCount = count() by EventTime_1, GroupHost;
union (SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime_1 + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupHost asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupHost != prev(GroupHost))
| where CountBoundaryOrder == 0
| where EventCount >= 1
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, ["Host"] = GroupHost, EventCount
| where WindowEnd >= ReportStart_ and WindowEnd < ReportEnd_
};
union (Actual0() | extend Host=tostring(Host) | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Host, EventCount
| where Delta != 0
