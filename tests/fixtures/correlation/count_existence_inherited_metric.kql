// Public-conversion comparison; execution status is hash-scoped in RUNTIME.md.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
let Events=union
(range Match from 1 to 4 step 1 | project Timestamp=datetime(2026-01-01),Host="account",Marker="failure",Amount=tolong(99)),
(datatable(Timestamp:datetime,Host:string,Marker:string,Amount:long) [datetime(2026-01-01T00:01:00),"account","success",7]);
let Actual=() {
let ContextSummary = () {
let FailedLogonBursts = () {
let SourceMatchArrivals = Events
| where Marker =~ "failure"
| project EventTime_1 = ["Timestamp"], GroupHost = ["Host"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
| summarize SourceMatchCount = count() by EventTime_1, GroupHost;
union (SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime_1 + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupHost asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupHost != prev(GroupHost))
| where CountBoundaryOrder == 0
| where EventCount >= 3
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, ["Host"] = GroupHost, EventCount
};
// Strict sequence: "failed-logon-bursts" -> "successful-logon". Total inclusive span: 3m.
union (FailedLogonBursts()
| extend EventTime_1 = ["WindowEnd"], GroupHost = ["Host"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
| extend SourceRule = "failed-logon-bursts"),
(Events
| where Marker =~ "success"
| extend EventTime_1 = ["Timestamp"], GroupHost = ["Host"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
| extend SourceRule = "successful-logon")
// Batch equal timestamps: simultaneous source matches cannot advance strict sequence positions.
| summarize HasFailedLogonBursts = countif(SourceRule == "failed-logon-bursts") > 0, HasSuccessfulLogon = countif(SourceRule == "successful-logon") > 0 by EventTime_1, GroupHost
| sort by GroupHost asc, EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1)) or GroupHost != prev(GroupHost)
// Read preceding timestamp state for every assignment; preserve viable earlier prefixes.
| scan declare (LatestFailedLogonBurstsStart:datetime = datetime(null), CompleteNow:bool = false) with (
    step SequenceState: true =>
        CompleteNow = not(NewCorrelationGroup) and HasSuccessfulLogon and isnotnull(SequenceState.LatestFailedLogonBurstsStart) and SequenceState.LatestFailedLogonBurstsStart >= EventTime_1 - 3m,
        LatestFailedLogonBurstsStart = iff(HasFailedLogonBursts, EventTime_1, iff(NewCorrelationGroup, datetime(null), SequenceState.LatestFailedLogonBurstsStart));
)
| where CompleteNow
| project WindowStart = EventTime_1 - 3m, WindowEnd = EventTime_1, ["Host"] = GroupHost, RuleCount = tolong(2)
};
let FailedLogonBursts_1 = () {
let SourceMatchArrivals = Events
| where Marker =~ "failure"
| project EventTime_1 = ["Timestamp"], GroupHost = ["Host"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
| summarize SourceMatchCount = count() by EventTime_1, GroupHost;
union (SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime_1 + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupHost asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupHost != prev(GroupHost))
| where CountBoundaryOrder == 0
| where EventCount >= 3
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, ["Host"] = GroupHost, EventCount
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId = row_number());
let WindowSourceMatches = materialize(
CorrelationMatches | project CorrelationMatchId, CompletionTime = WindowEnd, ContextGroupHost = ["Host"], ContextPartition = 1
| join kind=inner (
union (FailedLogonBursts_1()
| extend ContextEventTime = ["WindowEnd"], ContextGroupHost = ["Host"], ContextFailureCount = ["EventCount"]
| where isnotnull(ContextEventTime) and isnotempty(ContextGroupHost)
| extend ContextSourceRule = "failed-logon-bursts"),
(Events
| where Marker =~ "success"
| extend ContextEventTime = ["Timestamp"], ContextGroupHost = ["Host"], ContextFailureCount = ["Amount"]
| where isnotnull(ContextEventTime) and isnotempty(ContextGroupHost)
| extend ContextSourceRule = "successful-logon")
| project ContextEventTime, ContextSourceRule, ContextGroupHost, ContextFailureCount, ContextPartition = 1
) on ContextGroupHost
| where ContextEventTime between ((CompletionTime - 3m) .. CompletionTime));
// Successful one/two-step completions need only endpoint participant filters.
let OrderedSourceRelationships = materialize(WindowSourceMatches
| where (ContextSourceRule == "failed-logon-bursts" and ContextEventTime < CompletionTime) or (ContextSourceRule == "successful-logon" and ContextEventTime == CompletionTime));
let CompleteContextRelationships = materialize(OrderedSourceRelationships
| project CorrelationMatchId, ContextFailureCount
| distinct *);
let ValuesForFailureCount = CompleteContextRelationships
| where isnotnull(ContextFailureCount)
| summarize by CorrelationMatchId, ContextFailureCount
| summarize DisplayedFailureCount = make_list(ContextFailureCount, 1000), DistinctFailureCountCount = count() by CorrelationMatchId;
CorrelationMatches
| join kind=leftouter (ValuesForFailureCount) on CorrelationMatchId
| extend ["FailureCount"] = coalesce(DisplayedFailureCount, dynamic([]))
| extend ContextComplete = coalesce(DistinctFailureCountCount, 0) <= 1000
| project ["WindowStart"], ["WindowEnd"], ["Host"], ["FailureCount"], ["RuleCount"], ["ContextComplete"]
| extend Counts=strcat_array(array_sort_asc(FailureCount), ",")
};
let Expected=datatable(WindowEnd:datetime,Host:string,Counts:string,ContextComplete:bool,RuleCount:long) [
 datetime(2026-01-01T00:01:00),"account","4,7",true,2
] | extend WindowStart=WindowEnd-3m;
union (Actual() | extend Host=tostring(Host) | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Host, Counts, ContextComplete, RuleCount
| where Delta != 0
