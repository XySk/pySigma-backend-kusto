 datetime(2026-01-01T00:01:00),"account","4,7",true,2
] | extend WindowStart=WindowEnd-3m;
union (Actual() | extend Host=tostring(Host) | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Host, Counts, ContextComplete, RuleCount
| where Delta != 0
