let Events=union
(range Match from 1 to 4 step 1 | project Timestamp=datetime(2026-01-01),Host="account",Marker="failure",Amount=tolong(99)),
(datatable(Timestamp:datetime,Host:string,Marker:string,Amount:long) [datetime(2026-01-01T00:01:00),"account","success",7]);
let Actual=() {
let _sigma_context_summary = () {
let _sigma_child_0 = () {
let SourceMatchArrivals = union (Events
| where Marker =~ "failure"
| project EventTime_1 = todatetime(["Timestamp"]), GroupHost = ["Host"])
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
| summarize SourceMatchCount = count() by EventTime_1, GroupHost;
union (SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime_1 + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupHost asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupHost != prev(GroupHost))
| where CountBoundaryOrder == 0
| where EventCount >= 3
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, ["Host"] = GroupHost, EventCount
};
// Strict sequence: "failed-logon-bursts" -> "successful-logon". Total inclusive span: 3m.
union (_sigma_child_0()
| extend EventTime_1 = todatetime(["WindowEnd"]), GroupHost = ["Host"]
| extend SourceRule = "failed-logon-bursts"),
(Events
| where Marker =~ "success"
| extend EventTime_1 = todatetime(["Timestamp"]), GroupHost = ["Host"]
| extend SourceRule = "successful-logon")
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
// Batch equal timestamps: simultaneous source matches cannot advance strict sequence positions.
| summarize HasFailedLogonBursts = countif(SourceRule == "failed-logon-bursts") > 0, HasSuccessfulLogon = countif(SourceRule == "successful-logon") > 0 by EventTime_1, GroupHost
| sort by GroupHost asc, EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1)) or GroupHost != prev(GroupHost)
// Read preceding timestamp state for every assignment; preserve viable earlier prefixes.
| scan declare (LatestFailedLogonBurstsStart:datetime = datetime(null), CompleteNow:bool = false) with (
    step SequenceState: true =>
        CompleteNow = not(NewCorrelationGroup) and HasSuccessfulLogon and isnotnull(SequenceState.LatestFailedLogonBurstsStart) and SequenceState.LatestFailedLogonBurstsStart >= EventTime_1 - 3m,
        LatestFailedLogonBurstsStart = iff(HasFailedLogonBursts, EventTime_1, iff(NewCorrelationGroup, datetime(null), SequenceState.LatestFailedLogonBurstsStart));
)
| where CompleteNow
| project WindowStart = EventTime_1 - 3m, WindowEnd = EventTime_1, ["Host"] = GroupHost, RuleCount = tolong(2)
};
let _sigma_child_0_1 = () {
let SourceMatchArrivals = union (Events
