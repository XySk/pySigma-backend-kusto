| summarize DisplayedValues = make_list(_sigma_context_value, 1000), DistinctValueCount = count() by _sigma_context_id;
_sigma_context_summaries
| join kind=leftouter (ContextValues) on _sigma_context_id
| extend ["Amount"] = coalesce(DisplayedValues, dynamic([]))
| extend ContextComplete = coalesce(DistinctValueCount, 0) <= 1000
| project ["WindowStart"], ["WindowEnd"], ["Amount"], ["RuleCount"], ["ContextComplete"]
};
let _sigma_validation_check_ = () {
let _sigma_values = union (Events
| where Marker =~ "match"
| extend _sigma_timestamp = todatetime(["Timestamp"]), _sigma_value = pack_array(gettype(["Amount"]), ["Amount"])
| extend _sigma_rule = "source-rule")
| where isnotnull(_sigma_timestamp)
;
let _sigma_sums = materialize(
_sigma_values
| project _sigma_window_end = _sigma_timestamp, _sigma_bin = bin(_sigma_timestamp, 1m)
| distinct *
| join kind=inner (
    _sigma_values
    | extend _sigma_bin = pack_array(bin(_sigma_timestamp, 1m), bin(_sigma_timestamp, 1m) + 1m)
    | mv-expand _sigma_bin to typeof(datetime)
) on _sigma_bin
| where _sigma_timestamp between ((_sigma_window_end - 1m) .. _sigma_window_end)
| summarize _sigma_integer_sum = sumif(todecimal(_sigma_value[1]), tostring(_sigma_value[0]) in ("int", "long")), _sigma_real_sum = sumif(toreal(_sigma_value[1]), tostring(_sigma_value[0]) in ("real", "double", "decimal") and isfinite(toreal(_sigma_value[1]))), _sigma_real_count = countif(tostring(_sigma_value[0]) in ("real", "double", "decimal") and isfinite(toreal(_sigma_value[1]))) by _sigma_window_end
);
union (_sigma_sums | where _sigma_real_count == 0 and (isnull(_sigma_integer_sum) or _sigma_integer_sum < decimal(-9223372036854775808) or _sigma_integer_sum > decimal(9223372036854775807)) | project _sigma_correlation_error = "Kusto value_sum integer overflow")
};
let _sigma_guarded_query__rows = materialize(_sigma_guarded_query_());
let _sigma_guarded_query__failure = toscalar(union (_sigma_validation_check_() | project _sigma_correlation_error_ = tostring(_sigma_correlation_error)) | summarize countif(isnotempty(_sigma_correlation_error_)));
_sigma_guarded_query__rows
| where assert(_sigma_guarded_query__failure == 0, "Kusto correlation validation failed: Kusto value_sum integer overflow; unrecognized error sentinel")
};
let Observed=Actual() | project WindowStart,WindowEnd,Metric=toreal(RuleCount);
let Expected=datatable(WindowStart:datetime,WindowEnd:datetime,Metric:real) [
 datetime(2026-01-01T11:55:00Z),datetime(2026-01-01T12:00:00Z),1
];
union (Observed | extend Delta=1),(Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowStart,WindowEnd,Metric
| where Delta!=0
