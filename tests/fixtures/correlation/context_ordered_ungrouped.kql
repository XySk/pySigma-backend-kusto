// Generated via public Sigma parsing and KustoBackend.convert. Zero differences means PASS.
let Events=datatable(Timestamp:datetime, Host:string, Marker:string, User:string, Actor:string, Server:string) [
 datetime(2026-01-01T12:00:00Z), "h", "b", "early", "early", "early-server",
 datetime(2026-01-01T12:01:00Z), "h", "a", "first", "first", "first-server",
 datetime(2026-01-01T12:02:00Z), "h", "a", "second", "second", "second-server",
 datetime(2026-01-01T12:03:00Z), "h", "b", "middle1", "middle1", "middle1-server",
 datetime(2026-01-01T12:03:00Z), "h", "b", "middle1", "middle1", "middle1-server",
 datetime(2026-01-01T12:04:00Z), "h", "b", "middle2", "middle2", "middle2-server",
 datetime(2026-01-01T12:05:00Z), "h", "a", "late", "late", "late-server",
 datetime(2026-01-01T12:05:00Z), "h", "c", "finish", "finish", "finish-server",
 datetime(2026-01-01T12:06:00Z), "h", "c", "overlap", "overlap", "overlap-server",
 datetime(2026-01-01T12:07:00Z), "h", "c", "expired", "expired", "expired-server"
];
let Actual=() {
let _sigma_context_summary = () {
// Strict sequence: "a" -> "b" -> "c". Total inclusive span: 5m.
union (Events
| where Marker =~ "a"
| extend EventTime_1 = todatetime(["Timestamp"])
| extend SourceRule = "a"),
(Events
| where Marker =~ "b"
| extend EventTime_1 = todatetime(["Timestamp"])
| extend SourceRule = "b"),
(Events
| where Marker =~ "c"
| extend EventTime_1 = todatetime(["Timestamp"])
| extend SourceRule = "c")
| where isnotnull(EventTime_1)
// Batch equal timestamps: simultaneous source matches cannot advance strict sequence positions.
| summarize HasA = countif(SourceRule == "a") > 0, HasB = countif(SourceRule == "b") > 0, HasC = countif(SourceRule == "c") > 0 by EventTime_1
| sort by EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1))
// Read preceding timestamp state for every assignment; preserve viable earlier prefixes.
| scan declare (LatestAStart:datetime = datetime(null), LatestAThenBStart:datetime = datetime(null), CompleteNow:bool = false) with (
    step SequenceState: true =>
        CompleteNow = not(NewCorrelationGroup) and HasC and isnotnull(SequenceState.LatestAThenBStart) and SequenceState.LatestAThenBStart >= EventTime_1 - 5m,
        LatestAStart = iff(HasA, EventTime_1, iff(NewCorrelationGroup, datetime(null), SequenceState.LatestAStart)),
        LatestAThenBStart = iff(NewCorrelationGroup, datetime(null), iff(HasB and isnotnull(SequenceState.LatestAStart) and SequenceState.LatestAStart >= EventTime_1 - 5m and (isnull(SequenceState.LatestAThenBStart) or SequenceState.LatestAStart > SequenceState.LatestAThenBStart), SequenceState.LatestAStart, SequenceState.LatestAThenBStart));
)
| where CompleteNow
| project WindowStart = EventTime_1 - 5m, WindowEnd = EventTime_1, RuleCount = tolong(3)
};
let _sigma_context_summaries = materialize(_sigma_context_summary()
| serialize _sigma_context_id = row_number());
let _sigma_context_matches = materialize(
_sigma_context_summaries | project _sigma_context_id, _sigma_context_end = WindowEnd, _sigma_context_partition = 1
| join kind=inner (
union (Events
| where Marker =~ "a"
| extend _sigma_context_timestamp = todatetime(["Timestamp"]), _sigma_context_value = ["User"], _sigma_context_value_1 = ["Server"]
| extend _sigma_context_rule = "a"),
(Events
| where Marker =~ "b"
| extend _sigma_context_timestamp = todatetime(["Timestamp"]), _sigma_context_value = ["User"], _sigma_context_value_1 = ["Server"]
| extend _sigma_context_rule = "b"),
(Events
| where Marker =~ "c"
| extend _sigma_context_timestamp = todatetime(["Timestamp"]), _sigma_context_value = ["User"], _sigma_context_value_1 = ["Server"]
| extend _sigma_context_rule = "c")
| project _sigma_context_timestamp, _sigma_context_rule, _sigma_context_value, _sigma_context_value_1, _sigma_context_partition = 1
) on _sigma_context_partition
| where _sigma_context_timestamp between ((_sigma_context_end - 5m) .. _sigma_context_end)
| serialize _sigma_context_key = row_number());
let _sigma_context_path = _sigma_context_matches
| where _sigma_context_rule == "a"
| project _sigma_context_id, _sigma_context_end, _sigma_context_step = _sigma_context_key, _sigma_context_step_time = _sigma_context_timestamp
| project _sigma_context_id, _sigma_context_end, _sigma_context_step, _sigma_context_previous = _sigma_context_step_time;
let _sigma_context_path_1 = _sigma_context_path
| join kind=inner (
_sigma_context_matches
| where _sigma_context_rule == "b"
| project _sigma_context_id, _sigma_context_end, _sigma_context_step_1 = _sigma_context_key, _sigma_context_step_time_1 = _sigma_context_timestamp
) on _sigma_context_id
| where _sigma_context_step_time_1 > _sigma_context_previous
| project _sigma_context_id, _sigma_context_end, _sigma_context_step, _sigma_context_step_1, _sigma_context_previous = _sigma_context_step_time_1;
let _sigma_context_path_2 = _sigma_context_path_1
| join kind=inner (
_sigma_context_matches
| where _sigma_context_rule == "c"
| project _sigma_context_id, _sigma_context_end, _sigma_context_step_2 = _sigma_context_key, _sigma_context_step_time_2 = _sigma_context_timestamp
) on _sigma_context_id
| where _sigma_context_step_time_2 > _sigma_context_previous
| where _sigma_context_step_time_2 == _sigma_context_end
| project _sigma_context_id, _sigma_context_end, _sigma_context_step, _sigma_context_step_1, _sigma_context_step_2, _sigma_context_previous = _sigma_context_step_time_2;
let _sigma_context_participating = union (_sigma_context_path_2 | project _sigma_context_id, _sigma_context_key = _sigma_context_step), (_sigma_context_path_2 | project _sigma_context_id, _sigma_context_key = _sigma_context_step_1), (_sigma_context_path_2 | project _sigma_context_id, _sigma_context_key = _sigma_context_step_2)
| distinct _sigma_context_id, _sigma_context_key;
let _sigma_context_selected = materialize(_sigma_context_matches
| join kind=leftsemi (_sigma_context_participating) on _sigma_context_id, _sigma_context_key);
let _sigma_context_rows = materialize(_sigma_context_selected
| project _sigma_context_id, _sigma_context_value, _sigma_context_value_1
| distinct *);
let ContextValues = _sigma_context_rows
| where isnotnull(_sigma_context_value)
| summarize by _sigma_context_id, _sigma_context_value
| summarize DisplayedValues = make_list(_sigma_context_value, 1000), DistinctValueCount = count() by _sigma_context_id;
let ContextValues_1 = _sigma_context_rows
| where isnotnull(_sigma_context_value_1)
| summarize by _sigma_context_id, _sigma_context_value_1
| summarize DisplayedValues_1 = make_list(_sigma_context_value_1, 1000), DistinctValueCount_1 = count() by _sigma_context_id;
_sigma_context_summaries
| join kind=leftouter (ContextValues) on _sigma_context_id
| extend ["User"] = coalesce(DisplayedValues, dynamic([]))
| join kind=leftouter (ContextValues_1) on _sigma_context_id
| extend ["Server"] = coalesce(DisplayedValues_1, dynamic([]))
| extend ContextComplete = coalesce(DistinctValueCount, 0) <= 1000 and coalesce(DistinctValueCount_1, 0) <= 1000
| project ["WindowStart"], ["WindowEnd"], ["User"], ["Server"], ["RuleCount"], ["ContextComplete"]
};
let Observed=Actual()
| project WindowEnd, Users=tostring(array_sort_asc(User)), Servers=tostring(array_sort_asc(Server)), Values=array_length(User), RuleCount, ContextComplete;
let Expected=datatable(WindowEnd:datetime, Users:string, Servers:string, Values:long, RuleCount:long, ContextComplete:bool) [
 datetime(2026-01-01T12:05:00Z), '["finish","first","middle1","middle2","second"]', '["finish-server","first-server","middle1-server","middle2-server","second-server"]', 5, 3, true,
 datetime(2026-01-01T12:06:00Z), '["first","middle1","middle2","overlap","second"]', '["first-server","middle1-server","middle2-server","overlap-server","second-server"]', 5, 3, true,
 datetime(2026-01-01T12:07:00Z), '["expired","middle1","middle2","second"]', '["expired-server","middle1-server","middle2-server","second-server"]', 4, 3, true
];
union (Observed | extend Delta=1), (Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowEnd,Users,Servers,Values,RuleCount,ContextComplete
| where Delta!=0
