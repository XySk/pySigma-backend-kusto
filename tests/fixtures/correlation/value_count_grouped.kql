let Actual = () {
let ValueCountSources = materialize(union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["ProcessTime"]), GroupCase = ["Case"], GroupHost = ["ProcessHost"], CountedActor = ["ProcessUser"]),
(Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["ProcessTime"]), GroupCase = ["Case"], GroupHost = ["ProcessHost"], CountedActor = ["ProcessUser"]),
(OtherEvents
| where Marker =~ "match"
| project EventTime_1 = todatetime(["NetworkTime"]), GroupCase = ["Case"], GroupHost = ["NetworkHost"], CountedActor = ["NetworkUser"]),
(OtherEvents
| where Marker =~ "match"
| project EventTime_1 = todatetime(["NetworkTime"]), GroupCase = ["Case"], GroupHost = ["NetworkHost"], CountedActor = ["NetworkUser"])
| where isnotnull(EventTime_1) and isnotempty(GroupCase) and isnotempty(GroupHost));
let CountedActorActivity = materialize(ValueCountSources
| where isnotempty(CountedActor)
| summarize by GroupCase, GroupHost, CountedActor, EventTime_1
| sort by GroupCase asc, GroupHost asc, CountedActor asc, EventTime_1 asc
// Repeated values whose inclusive active intervals overlap contribute only once.
| extend CountedActorStarts = isnull(prev(EventTime_1)) or GroupCase != prev(GroupCase) or GroupHost != prev(GroupHost) or CountedActor != prev(CountedActor) or EventTime_1 > prev(EventTime_1) + 5m,
    CountedActorEnds = isnull(next(EventTime_1)) or GroupCase != next(GroupCase) or GroupHost != next(GroupHost) or CountedActor != next(CountedActor) or next(EventTime_1) > EventTime_1 + 5m);
union (ValueCountSources | summarize by GroupCase, GroupHost, EventTime_1
| project GroupCase, GroupHost, ValueBoundaryTime = EventTime_1, ValueBoundaryOrder = 1, CountedActorDelta = 0),
(CountedActorActivity | where CountedActorStarts
| project GroupCase, GroupHost, ValueBoundaryTime = EventTime_1, ValueBoundaryOrder = 0, CountedActorDelta = 1),
(CountedActorActivity | where CountedActorEnds
| project GroupCase, GroupHost, ValueBoundaryTime = EventTime_1 + 5m, ValueBoundaryOrder = 2, CountedActorDelta = -1)
// All interval starts precede anchors; equal-time expirations follow them.
| sort by GroupCase asc, GroupHost asc, ValueBoundaryTime asc, ValueBoundaryOrder asc
| extend ValueCount = row_cumsum(CountedActorDelta, GroupCase != prev(GroupCase) or GroupHost != prev(GroupHost))
| where ValueBoundaryOrder == 1
| where ValueCount >= 2
| project WindowStart = ValueBoundaryTime - 5m, WindowEnd = ValueBoundaryTime, ["Case"] = GroupCase, ["Host"] = GroupHost, ValueCount
};
let Expected = datatable(WindowStart:datetime, WindowEnd:datetime, Case:string, Host:string, ValueCount:long) [
    datetime(2026-01-01T12:00:01Z), datetime(2026-01-01T12:05:01Z), "boundary", "host", 3,
