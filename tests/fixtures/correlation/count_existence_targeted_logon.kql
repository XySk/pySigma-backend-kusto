// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
let SecurityEvent = union
(range Minute from 0 to 9 step 1 | project TimeGenerated=datetime(2026-01-01)+Minute*1m,
 EventID=tolong(4625),TargetUserName="distributed",Computer=strcat("host-",Minute),SubjectUserName="system"),
(datatable(TimeGenerated:datetime,EventID:long,TargetUserName:string,Computer:string,SubjectUserName:string) [
 datetime(2026-01-01T00:18:00),4624,"distributed","success-host","other-subject",
 datetime(2026-01-01T00:19:00),4624,"distributed","another-host","other-subject",
 datetime(2026-01-01T00:19:00.0000001),4624,"distributed","late-host","other-subject"
]),
(range Match from 1 to 10 step 1 | project TimeGenerated=datetime(2026-01-01T00:00:00),
 EventID=tolong(4625),TargetUserName="tied-only",Computer="failure-host",SubjectUserName="system"),
(datatable(TimeGenerated:datetime,EventID:long,TargetUserName:string,Computer:string,SubjectUserName:string) [
 datetime(2026-01-01T00:00:00),4624,"tied-only","success-host","system",
 datetime(2026-01-01T00:00:00.0000001),4624,"tied-only","success-host","system"
]),
(range Match from 1 to 10 step 1 | project TimeGenerated=datetime(2026-01-01T00:00:00),
 EventID=tolong(4625),TargetUserName="older-burst",Computer="first-host",SubjectUserName="system"),
(range Match from 1 to 10 step 1 | project TimeGenerated=datetime(2026-01-01T00:05:00),
 EventID=tolong(4625),TargetUserName="older-burst",Computer="second-host",SubjectUserName="system"),
(datatable(TimeGenerated:datetime,EventID:long,TargetUserName:string,Computer:string,SubjectUserName:string) [
 datetime(2026-01-01T00:05:00),4624,"older-burst","success-host","system"
]);
let Specialized = () {
let _sigma_child_0 = () {
union (SecurityEvent
| where EventID == 4625
| project EventTime_1 = todatetime(["TimeGenerated"]), GroupUser = ["TargetUserName"])
| where isnotnull(EventTime_1) and isnotempty(GroupUser)
// Preserve individual source matches, including timestamp ties, before the threshold lookup.
| sort by GroupUser asc, EventTime_1 asc
| extend ThresholdPredecessorTime = prev(EventTime_1, 9)
| where ThresholdPredecessorTime >= EventTime_1 - 10m and GroupUser == prev(GroupUser, 9)
| distinct EventTime_1, GroupUser
| project WindowStart = EventTime_1 - 10m, WindowEnd = EventTime_1, ["User"] = GroupUser
};
// Strict sequence: "failed-logon-bursts" -> "successful-logon". Total inclusive span: 10m.
union (_sigma_child_0()
| extend EventTime_1 = todatetime(["WindowEnd"]), GroupUser = ["User"]
| extend SourceRule = "failed-logon-bursts"),
(SecurityEvent
| where EventID == 4624
| extend EventTime_1 = todatetime(["TimeGenerated"]), GroupUser = ["TargetUserName"]
| extend SourceRule = "successful-logon")
| where isnotnull(EventTime_1) and isnotempty(GroupUser)
// Batch equal timestamps: simultaneous source matches cannot advance strict sequence positions.
| summarize HasFailedLogonBursts = countif(SourceRule == "failed-logon-bursts") > 0, HasSuccessfulLogon = countif(SourceRule == "successful-logon") > 0 by EventTime_1, GroupUser
| sort by GroupUser asc, EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1)) or GroupUser != prev(GroupUser)
// Read preceding timestamp state for every assignment; preserve viable earlier prefixes.
| scan declare (LatestFailedLogonBurstsStart:datetime = datetime(null), CompleteNow:bool = false) with (
    step SequenceState: true =>
        CompleteNow = not(NewCorrelationGroup) and HasSuccessfulLogon and isnotnull(SequenceState.LatestFailedLogonBurstsStart) and SequenceState.LatestFailedLogonBurstsStart >= EventTime_1 - 10m,
        LatestFailedLogonBurstsStart = iff(HasFailedLogonBursts, EventTime_1, iff(NewCorrelationGroup, datetime(null), SequenceState.LatestFailedLogonBurstsStart));
)
| where CompleteNow
| project WindowStart = EventTime_1 - 10m, WindowEnd = EventTime_1, ["User"] = GroupUser, RuleCount = tolong(2)
};
let General = () {
let _sigma_child_0 = () {
let SourceMatchArrivals = union (SecurityEvent
| where EventID == 4625
| project EventTime_1 = todatetime(["TimeGenerated"]), GroupUser = ["TargetUserName"])
| where isnotnull(EventTime_1) and isnotempty(GroupUser)
| summarize SourceMatchCount = count() by EventTime_1, GroupUser;
union (SourceMatchArrivals
| project GroupUser, CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupUser, CountBoundaryTime = EventTime_1 + 10m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupUser asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupUser != prev(GroupUser))
| where CountBoundaryOrder == 0
| where EventCount >= 10
| project WindowStart = CountBoundaryTime - 10m, WindowEnd = CountBoundaryTime, ["User"] = GroupUser, EventCount
};
// Strict sequence: "failed-logon-bursts" -> "successful-logon". Total inclusive span: 10m.
union (_sigma_child_0()
| extend EventTime_1 = todatetime(["WindowEnd"]), GroupUser = ["User"]
| extend SourceRule = "failed-logon-bursts"),
(SecurityEvent
| where EventID == 4624
| extend EventTime_1 = todatetime(["TimeGenerated"]), GroupUser = ["TargetUserName"]
| extend SourceRule = "successful-logon")
| where isnotnull(EventTime_1) and isnotempty(GroupUser)
// Batch equal timestamps: simultaneous source matches cannot advance strict sequence positions.
| summarize HasFailedLogonBursts = countif(SourceRule == "failed-logon-bursts") > 0, HasSuccessfulLogon = countif(SourceRule == "successful-logon") > 0 by EventTime_1, GroupUser
| sort by GroupUser asc, EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1)) or GroupUser != prev(GroupUser)
// Read preceding timestamp state for every assignment; preserve viable earlier prefixes.
| scan declare (LatestFailedLogonBurstsStart:datetime = datetime(null), CompleteNow:bool = false) with (
    step SequenceState: true =>
        CompleteNow = not(NewCorrelationGroup) and HasSuccessfulLogon and isnotnull(SequenceState.LatestFailedLogonBurstsStart) and SequenceState.LatestFailedLogonBurstsStart >= EventTime_1 - 10m,
        LatestFailedLogonBurstsStart = iff(HasFailedLogonBursts, EventTime_1, iff(NewCorrelationGroup, datetime(null), SequenceState.LatestFailedLogonBurstsStart));
)
| where CompleteNow
| project WindowStart = EventTime_1 - 10m, WindowEnd = EventTime_1, ["User"] = GroupUser, RuleCount = tolong(2)
};
let Expected = datatable(WindowEnd:datetime,User:string) [
 datetime(2026-01-01T00:18:00),"distributed",
 datetime(2026-01-01T00:19:00),"distributed",
 datetime(2026-01-01T00:00:00.0000001),"tied-only",
 datetime(2026-01-01T00:05:00),"older-burst"
] | extend WindowStart=WindowEnd-10m,RuleCount=tolong(2);
let Actual=union (Specialized() | extend Plan="specialized"),(General() | extend Plan="general");
let BothExpected=union (Expected | extend Plan="specialized"),(Expected | extend Plan="general");
union (Actual | extend User=tostring(User) | extend Delta = 1), (BothExpected | extend Delta = -1)
| summarize Delta = sum(Delta) by Plan, WindowStart, WindowEnd, User, RuleCount
| where Delta != 0
