// Public-conversion comparison; execution status is hash-scoped in RUNTIME.md.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
// Both group equality and counted-value equality follow native summarize, including NaN.
let Population=datatable(Timestamp:datetime,Value:real,Other:real) [
 datetime(2026-01-01T00:00:00),real(nan),real(0),
 datetime(2026-01-01T00:01:00),real(nan),real(1),
 datetime(2026-01-01T00:02:00),real(+inf),real(1),
 datetime(2026-01-01T00:05:00),real(-inf),real(null),
 datetime(2026-01-01T00:06:00),real(null),real(null),
 datetime(2026-01-01T00:06:00.0000001),real(-0.0),real(null),
 datetime(2026-01-01T00:07:00),real(+0.0),real(null),
 datetime(2026-01-01T00:20:00),real(null),real(null)
];
let Events=union (Population | extend Group=real(nan)),(Population | extend Group=real(+inf)),
 (Population | extend Group=real(-inf)),(Population | extend Group=real(0))
 | extend Marker="match";
let Actual=(){
let ValueCountSources = materialize(Events
| where Marker =~ "match"
| project EventTime_1 = ["Timestamp"], GroupGroup = ["Group"], CountedValue = ["Value"], CountedOther = ["Other"]
| where isnotnull(EventTime_1) and isnotempty(GroupGroup));
let CountedValueActivity = materialize(ValueCountSources
| where isnotempty(CountedValue)
| summarize by GroupGroup, CountedValue, EventTime_1
| sort by GroupGroup asc, CountedValue asc, EventTime_1 asc
// Repeated values whose inclusive active intervals overlap contribute only once.
| extend CountedValueStarts = isnull(prev(EventTime_1)) or (GroupGroup != prev(GroupGroup) and not(isnan(GroupGroup) and isnan(prev(GroupGroup)))) or (CountedValue != prev(CountedValue) and not(isnan(CountedValue) and isnan(prev(CountedValue)))) or EventTime_1 > prev(EventTime_1) + 5m,
    CountedValueEnds = isnull(next(EventTime_1)) or (GroupGroup != next(GroupGroup) and not(isnan(GroupGroup) and isnan(next(GroupGroup)))) or (CountedValue != next(CountedValue) and not(isnan(CountedValue) and isnan(next(CountedValue)))) or next(EventTime_1) > EventTime_1 + 5m);
let CountedOtherActivity = materialize(ValueCountSources
| where isnotempty(CountedOther)
| summarize by GroupGroup, CountedOther, EventTime_1
| sort by GroupGroup asc, CountedOther asc, EventTime_1 asc
// Repeated values whose inclusive active intervals overlap contribute only once.
| extend CountedOtherStarts = isnull(prev(EventTime_1)) or (GroupGroup != prev(GroupGroup) and not(isnan(GroupGroup) and isnan(prev(GroupGroup)))) or (CountedOther != prev(CountedOther) and not(isnan(CountedOther) and isnan(prev(CountedOther)))) or EventTime_1 > prev(EventTime_1) + 5m,
    CountedOtherEnds = isnull(next(EventTime_1)) or (GroupGroup != next(GroupGroup) and not(isnan(GroupGroup) and isnan(next(GroupGroup)))) or (CountedOther != next(CountedOther) and not(isnan(CountedOther) and isnan(next(CountedOther)))) or next(EventTime_1) > EventTime_1 + 5m);
union (ValueCountSources | summarize by GroupGroup, EventTime_1
| project GroupGroup, ValueBoundaryTime = EventTime_1, ValueBoundaryOrder = 1, CountedValueDelta = 0, CountedOtherDelta = 0),
(CountedValueActivity | where CountedValueStarts
| project GroupGroup, ValueBoundaryTime = EventTime_1, ValueBoundaryOrder = 0, CountedValueDelta = 1, CountedOtherDelta = 0),
(CountedValueActivity | where CountedValueEnds
| project GroupGroup, ValueBoundaryTime = EventTime_1 + 5m, ValueBoundaryOrder = 2, CountedValueDelta = -1, CountedOtherDelta = 0),
(CountedOtherActivity | where CountedOtherStarts
| project GroupGroup, ValueBoundaryTime = EventTime_1, ValueBoundaryOrder = 0, CountedValueDelta = 0, CountedOtherDelta = 1),
(CountedOtherActivity | where CountedOtherEnds
| project GroupGroup, ValueBoundaryTime = EventTime_1 + 5m, ValueBoundaryOrder = 2, CountedValueDelta = 0, CountedOtherDelta = -1)
// All interval starts precede anchors; equal-time expirations follow them.
| sort by GroupGroup asc, ValueBoundaryTime asc, ValueBoundaryOrder asc
| extend ["ValueCount_Value"] = row_cumsum(CountedValueDelta, (GroupGroup != prev(GroupGroup) and not(isnan(GroupGroup) and isnan(prev(GroupGroup))))), ["ValueCount_Other"] = row_cumsum(CountedOtherDelta, (GroupGroup != prev(GroupGroup) and not(isnan(GroupGroup) and isnan(prev(GroupGroup)))))
| where ValueBoundaryOrder == 1
| where ["ValueCount_Value"] >= 0 and ["ValueCount_Other"] >= 0
| project WindowStart = ValueBoundaryTime - 5m, WindowEnd = ValueBoundaryTime, ["Group"] = GroupGroup, ["ValueCount_Value"], ["ValueCount_Other"]
};
let Expected=datatable(WindowEnd:datetime,ValueCount_Value:long,ValueCount_Other:long) [
 datetime(2026-01-01T00:00:00),1,1,
 datetime(2026-01-01T00:01:00),1,2,
 datetime(2026-01-01T00:02:00),2,2,
 datetime(2026-01-01T00:05:00),3,2,
 datetime(2026-01-01T00:06:00),3,1,
 datetime(2026-01-01T00:06:00.0000001),3,1,
 datetime(2026-01-01T00:07:00),3,1,
 datetime(2026-01-01T00:20:00),0,0
] | extend Keys=dynamic(["NaN","inf","-inf","0.0"])
 | mv-expand Group=Keys to typeof(string) | project-away Keys;
let Observed=Actual() | project WindowEnd,ValueCount_Value,ValueCount_Other,Group=tostring(Group);
union (Observed | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowEnd, Group, ValueCount_Value, ValueCount_Other
| where Delta != 0
