let Actual = union (p_gt() | project Scenario="gt", WindowStart, WindowEnd, Host, ValuePercentile=toreal(ValuePercentile)),
(p_gte() | project Scenario="gte", WindowStart, WindowEnd, Host, ValuePercentile=toreal(ValuePercentile)),
(p_lt() | project Scenario="lt", WindowStart, WindowEnd, Host, ValuePercentile=toreal(ValuePercentile)),
