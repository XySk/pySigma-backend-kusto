let Events=datatable(Timestamp:datetime, Host:string, Marker:string, Amount:long) [datetime(2026-01-01), "h", "A", 42];
let Actual=(){
let Child = () {
let ContextSummary = () {
union (Events
| where Marker =~ "A"
| project EventTime_1 = ["Timestamp"], SourceRule = "A"
| where isnotnull(EventTime_1)),
(Events
| where Marker =~ "B"
| project EventTime_1 = ["Timestamp"], SourceRule = "B"
| where isnotnull(EventTime_1))
// Batch simultaneous source matches before updating inclusive trailing presence.
| summarize MatchesA = countif(SourceRule == "A") > 0, MatchesB = countif(SourceRule == "B") > 0 by EventTime_1
| sort by EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1))
| scan declare (LastATime:datetime, LastBTime:datetime) with (
    step PresenceWindow: true =>
        LastATime = iff(MatchesA, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastATime)),
        LastBTime = iff(MatchesB, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastBTime));
)
// Only source-match timestamps evaluate; expiration never creates an anchor.
| extend HasA = isnotnull(LastATime) and LastATime >= EventTime_1 - 5m, HasB = isnotnull(LastBTime) and LastBTime >= EventTime_1 - 5m
| extend RuleCount = tolong(HasA) + tolong(HasB)
| where (not(HasA) or not(HasB))
| project WindowStart = EventTime_1 - 5m, WindowEnd = EventTime_1, RuleCount
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId = row_number());
let WindowSourceMatches = materialize(
CorrelationMatches | project CorrelationMatchId, CompletionTime = WindowEnd, ContextPartition = 1
| join kind=inner (
union (Events
| where Marker =~ "A"
| extend ContextEventTime = ["Timestamp"], ContextAmount = ["Amount"]
| where isnotnull(ContextEventTime)
| extend ContextSourceRule = "A"),
(Events
| where Marker =~ "B"
| extend ContextEventTime = ["Timestamp"], ContextAmount = ["Amount"]
| where isnotnull(ContextEventTime)
| extend ContextSourceRule = "B")
| project ContextEventTime, ContextSourceRule, ContextAmount, ContextPartition = 1
) on ContextPartition
| where ContextEventTime between ((CompletionTime - 5m) .. CompletionTime));
let BooleanParticipants = WindowSourceMatches
| join kind=inner (WindowSourceMatches | summarize HasA_1 = countif(ContextSourceRule == "A") > 0, HasB_1 = countif(ContextSourceRule == "B") > 0 by CorrelationMatchId) on CorrelationMatchId
| where ((not(HasA_1) and (false)) or (not(HasB_1) and (false)));
let CompleteContextRelationships = materialize(BooleanParticipants
| project CorrelationMatchId, ContextAmount
| distinct *);
union (CorrelationMatches | extend ContextRowKind = "Summary"), (CorrelationMatches | join kind=inner (CompleteContextRelationships) on CorrelationMatchId | extend ContextRowKind = "ContextEvidence")
};
let ChildResults = materialize(Child());
let ContextSummary = () {
let ParentSourceMatches = materialize(ChildResults | where ["ContextRowKind"] == "Summary"
| project-away ["ContextAmount"]
| join kind=leftouter (ChildResults | where ["ContextRowKind"] == "ContextEvidence" | project ["CorrelationMatchId"], ["ContextAmount"]) on ["CorrelationMatchId"]
| extend ChildCorrelationMatch = strcat("Child", "_", tostring(["CorrelationMatchId"]))
| project EventTime = ["WindowEnd"], GroupChildRuleCount = ["RuleCount"], MeasuredAmount = ["ContextAmount"], ChildCorrelationMatch
| where isnotnull(EventTime) and isnotempty(GroupChildRuleCount)
| extend ChildCorrelationMatch = tostring(column_ifexists("ChildCorrelationMatch", "")));
let SumObservations = union (ParentSourceMatches | where isempty(ChildCorrelationMatch)), (ParentSourceMatches | where isnotempty(ChildCorrelationMatch) | extend RetainedNumericValue = MeasuredAmount | summarize take_any(*) by ChildCorrelationMatch, GroupChildRuleCount, RetainedNumericValue);
let SumArrivals = SumObservations
| summarize ArrivalSum = sum(MeasuredAmount) by EventTime, GroupChildRuleCount;
union (SumArrivals
| project GroupChildRuleCount, SumBoundaryTime = EventTime, SumBoundaryOrder = 0, SumDelta = ArrivalSum),
(SumArrivals
| project GroupChildRuleCount, SumBoundaryTime = EventTime + 5m, SumBoundaryOrder = 1, SumDelta = -ArrivalSum)
// Arrivals evaluate before equal-time expirations, including zero and missing values.
| sort by GroupChildRuleCount asc, SumBoundaryTime asc, SumBoundaryOrder asc
| extend ValueSum = row_cumsum(SumDelta, GroupChildRuleCount != prev(GroupChildRuleCount))
| where SumBoundaryOrder == 0
| where ValueSum == 0
| project WindowStart = SumBoundaryTime - 5m, WindowEnd = SumBoundaryTime, ["ChildRuleCount"] = GroupChildRuleCount, ValueSum
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId_1 = row_number());
let WindowSourceMatches =
CorrelationMatches | project CorrelationMatchId_1, CompletionTime = WindowEnd, ContextGroupChildRuleCount = ["ChildRuleCount"], ContextPartition = 1
| join kind=inner (
ChildResults | where ["ContextRowKind"] == "Summary"
| project-away ["ContextAmount"]
| join kind=leftouter (ChildResults | where ["ContextRowKind"] == "ContextEvidence" | project ["CorrelationMatchId"], ["ContextAmount"], HasContextEvidence = true) on ["CorrelationMatchId"]
| extend ContextEventTime = ["WindowEnd"], ContextGroupChildRuleCount = ["RuleCount"], ContextAmount_1 = ["ContextAmount"]
| where isnotnull(ContextEventTime) and isnotempty(ContextGroupChildRuleCount)
| extend ContextSourceRule = "child"
| project ContextEventTime, ContextSourceRule, ContextGroupChildRuleCount, ContextAmount_1, HasContextEvidence, ContextPartition = 1
) on ContextGroupChildRuleCount
| where ContextEventTime between ((CompletionTime - 5m) .. CompletionTime);
let CompleteContextRelationships = WindowSourceMatches
| where HasContextEvidence
| project CorrelationMatchId_1, ContextAmount_1
| distinct *;
let ValuesForAmount = CompleteContextRelationships
| where isnotnull(ContextAmount_1)
| summarize by CorrelationMatchId_1, ContextAmount_1
| summarize DisplayedAmount = make_list(ContextAmount_1, 1000), DistinctAmountCount = count() by CorrelationMatchId_1;
CorrelationMatches
| join kind=leftouter (ValuesForAmount) on CorrelationMatchId_1
| extend ["Amount"] = coalesce(DisplayedAmount, dynamic([]))
| extend ContextComplete = coalesce(DistinctAmountCount, 0) <= 1000
| project ["WindowStart"], ["WindowEnd"], ["ChildRuleCount"], ["Amount"], ["ValueSum"], ["ContextComplete"]
};
let Observed=Actual() | project WindowEnd, Metric=toreal(ValueSum), Values=array_length(Amount), ContextComplete, Group=tostring(ChildRuleCount);
let Expected=datatable(WindowEnd:datetime, Metric:real, Values:long, ContextComplete:bool, Group:string) [datetime(2026-01-01), 0, 0, true, "1"];
union (Observed | extend Delta=1), (Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowEnd, Metric, Values, ContextComplete, Group
| where Delta!=0
