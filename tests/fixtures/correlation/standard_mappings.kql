// Generated public conversion; two process searches contribute separately.
let Events=datatable(['Process Time']:datetime, ['Process Host']:string, ['Process Actor']:string,
 ['Process Amount']:long, ['Process Marker']:string) [
 datetime(2026-01-01T12:00:00Z), "h", "Alice", 10, "match",
 datetime(2026-01-01T12:00:00Z), "h", "ignored", 100, "other"
];
let NetworkEvents=datatable(['Network Time']:datetime, ['Network Host']:string, ['Network Actor']:string,
 ['Network Amount']:long, ['Network Marker']:string) [
 datetime(2026-01-01T12:00:00Z), "h", "Bob", 20, "match"
];
let Actual=() {
let ContextSummary = () {
let SumObservations = union (Events
| where ["Process Marker"] =~ "match"
| project EventTime_1 = ["Process Time"], GroupHost = ["Process Host"], MeasuredAmount = ["Process Amount"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost)),
(Events
| where ["Process Marker"] =~ "match"
| project EventTime_1 = ["Process Time"], GroupHost = ["Process Host"], MeasuredAmount = ["Process Amount"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost)),
(NetworkEvents
| where ["Network Marker"] =~ "match"
| project EventTime_1 = ["Network Time"], GroupHost = ["Network Host"], MeasuredAmount = ["Network Amount"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost));
let SumArrivals = SumObservations
| summarize ArrivalSum = sum(MeasuredAmount) by EventTime_1, GroupHost;
union (SumArrivals
| project GroupHost, SumBoundaryTime = EventTime_1, SumBoundaryOrder = 0, SumDelta = ArrivalSum),
(SumArrivals
| project GroupHost, SumBoundaryTime = EventTime_1 + 5m, SumBoundaryOrder = 1, SumDelta = -ArrivalSum)
// Arrivals evaluate before equal-time expirations, including zero and missing values.
| sort by GroupHost asc, SumBoundaryTime asc, SumBoundaryOrder asc
| extend ValueSum = row_cumsum(SumDelta, GroupHost != prev(GroupHost))
| where SumBoundaryOrder == 0
| where ValueSum >= 0
| project WindowStart = SumBoundaryTime - 5m, WindowEnd = SumBoundaryTime, ["Host"] = GroupHost, ValueSum
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId = row_number());
let WindowSourceMatches =
CorrelationMatches | project CorrelationMatchId, CompletionTime = WindowEnd, ContextGroupHost = ["Host"], ContextPartition = 1
| join kind=inner (
union (Events
| where ["Process Marker"] =~ "match"
| extend ContextEventTime = ["Process Time"], ContextGroupHost = ["Process Host"], ContextUser = ["Process Actor"]
| where isnotnull(ContextEventTime) and isnotempty(ContextGroupHost)
| extend ContextSourceRule = "source-rule"),
(Events
| where ["Process Marker"] =~ "match"
| extend ContextEventTime = ["Process Time"], ContextGroupHost = ["Process Host"], ContextUser = ["Process Actor"]
| where isnotnull(ContextEventTime) and isnotempty(ContextGroupHost)
| extend ContextSourceRule = "source-rule"),
(NetworkEvents
| where ["Network Marker"] =~ "match"
| extend ContextEventTime = ["Network Time"], ContextGroupHost = ["Network Host"], ContextUser = ["Network Actor"]
| where isnotnull(ContextEventTime) and isnotempty(ContextGroupHost)
| extend ContextSourceRule = "network-rule")
| project ContextEventTime, ContextSourceRule, ContextGroupHost, ContextUser, ContextPartition = 1
) on ContextGroupHost
| where ContextEventTime between ((CompletionTime - 5m) .. CompletionTime);
let CompleteContextRelationships = WindowSourceMatches
| project CorrelationMatchId, ContextUser
| distinct *;
let ValuesForUser = CompleteContextRelationships
| where isnotnull(ContextUser)
| summarize by CorrelationMatchId, ContextUser
| summarize DisplayedUser = make_list(ContextUser, 1000), DistinctUserCount = count() by CorrelationMatchId;
CorrelationMatches
| join kind=leftouter (ValuesForUser) on CorrelationMatchId
| extend ["User"] = coalesce(DisplayedUser, dynamic([]))
| extend ContextComplete = coalesce(DistinctUserCount, 0) <= 1000
| project ["WindowStart"], ["WindowEnd"], ["Host"], ["User"], ["ValueSum"], ["ContextComplete"]
};
let Observed=Actual() | project WindowStart, WindowEnd, Host=tostring(Host), Metric=tostring(ValueSum),
 Users=array_length(User), Alice=set_has_element(User,"Alice"), Bob=set_has_element(User,"Bob");
let Expected=datatable(WindowStart:datetime, WindowEnd:datetime, Host:string, Metric:string,
 Users:long, Alice:bool, Bob:bool) [
 datetime(2026-01-01T11:55:00Z), datetime(2026-01-01T12:00:00Z), "h", "40", 2, true, true
];
union (Observed | extend Delta=1), (Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowStart, WindowEnd, Host, Metric, Users, Alice, Bob
| where Delta!=0
