// Deterministic fixture; see RUNTIME.md for recorded engine execution.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
let Events = datatable(Timestamp:datetime, Host:string, Amount:long, Marker:string) [
    datetime(2026-01-01T12:00:00Z), "maximum", 9223372036854775807, "match",
    datetime(2026-01-01T12:00:00Z), "maximum", 9223372036854775807, "match",
    datetime(2026-01-01T12:00:00Z), "cancel", 9223372036854775807, "match",
    datetime(2026-01-01T12:00:00Z), "cancel", -9223372036854775807, "match"
];
let Expected = datatable(WindowStart:datetime, WindowEnd:datetime, Host:string, ValueAvg:real) [
    datetime(2026-01-01T11:55:00Z), datetime(2026-01-01T12:00:00Z), "maximum", 9.223372036854776e18,
    datetime(2026-01-01T11:55:00Z), datetime(2026-01-01T12:00:00Z), "cancel", 0.0
];
let Actual = () {
let AverageObservations = union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]), GroupHost = ["Host"], MeasuredAmount = ["Amount"])
| where isnotnull(EventTime_1) and isnotempty(GroupHost);
AverageObservations
| summarize by GroupHost, AverageWindowEnd = EventTime_1, AverageTimeBin = bin(EventTime_1, 5m)
| join kind=inner (
AverageObservations
| extend AverageTimeBin = pack_array(bin(EventTime_1, 5m), bin(EventTime_1, 5m) + 5m)
| mv-expand AverageTimeBin to typeof(datetime)
) on GroupHost, AverageTimeBin
| where EventTime_1 between ((AverageWindowEnd - 5m) .. AverageWindowEnd)
| summarize ValueAvg = avgif(toreal(MeasuredAmount), isfinite(toreal(MeasuredAmount))) by AverageWindowEnd, GroupHost
| where isfinite(ValueAvg) and ValueAvg >= -1
| project WindowStart = AverageWindowEnd - 5m, WindowEnd = AverageWindowEnd, ["Host"] = GroupHost, ValueAvg
};
union (Actual() | extend Host=tostring(Host) | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Host, ValueAvg
| where Delta != 0
