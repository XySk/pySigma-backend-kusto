let Events=datatable(Timestamp:datetime,Case:string,Value:long,Payload:dynamic,Marker:string) [
 datetime(2026-01-01T12:00:00Z),"both",1,dynamic({"a":10}),"match",
 datetime(2026-01-01T12:01:00Z),"both",2,dynamic({"a":10}),"match",
 datetime(2026-01-01T12:02:00Z),"both",1,dynamic({"a":20}),"match",
 datetime(2026-01-01T12:03:00Z),"both",long(null),dynamic(null),"match"
] | extend Other=tolong(Payload.a);
let Actual = () {
let _sigma_values = union (Events
| where Marker =~ "match"
| extend _sigma_timestamp = todatetime(["Timestamp"]), _sigma_group_0 = ["Case"], _sigma_value_0 = ["Value"], _sigma_value_1 = ["Other"]
| extend _sigma_rule = "E")
| where isnotnull(_sigma_timestamp) and isnotempty(_sigma_group_0)
| summarize by _sigma_timestamp, _sigma_group_0, _sigma_value_0, _sigma_value_1;
_sigma_values
| project _sigma_group_0, _sigma_window_end = _sigma_timestamp, _sigma_bin = bin(_sigma_timestamp, 5m)
| distinct *
| join kind=inner (
    _sigma_values
    | extend _sigma_bin = pack_array(bin(_sigma_timestamp, 5m), bin(_sigma_timestamp, 5m) + 5m)
    | mv-expand _sigma_bin to typeof(datetime)
) on _sigma_group_0, _sigma_bin
| where _sigma_timestamp between ((_sigma_window_end - 5m) .. _sigma_window_end)
| summarize ["ValueCount_Value"] = count_distinctif(_sigma_value_0, isnotempty(_sigma_value_0)), ["ValueCount_Other"] = count_distinctif(_sigma_value_1, isnotempty(_sigma_value_1)) by _sigma_window_end, _sigma_group_0
| where ["ValueCount_Value"] >= 2 and ["ValueCount_Other"] >= 2
| project WindowStart = _sigma_window_end - 5m, WindowEnd = _sigma_window_end, ["Case"] = _sigma_group_0, ["ValueCount_Value"], ["ValueCount_Other"]
};
