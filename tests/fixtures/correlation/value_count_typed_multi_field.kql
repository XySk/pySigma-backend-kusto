// Prepared deterministic fixture; live engine execution has not been performed.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
let Events=datatable(Timestamp:datetime,Case:string,Value:long,Payload:dynamic,Marker:string) [
 datetime(2026-01-01T12:00:00Z),"both",1,dynamic({"a":10}),"match",
 datetime(2026-01-01T12:01:00Z),"both",2,dynamic({"a":10}),"match",
 datetime(2026-01-01T12:02:00Z),"both",1,dynamic({"a":20}),"match",
 datetime(2026-01-01T12:03:00Z),"both",long(null),dynamic(null),"match"
] | extend Other=tolong(Payload.a);
let Actual = () {
let ValueCountSources = materialize(union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]), GroupCase = ["Case"], CountedValue = ["Value"], CountedOther = ["Other"])
| where isnotnull(EventTime_1) and isnotempty(GroupCase));
let CountedValueActivity = materialize(ValueCountSources
| where isnotempty(CountedValue)
| summarize by GroupCase, CountedValue, EventTime_1
| sort by GroupCase asc, CountedValue asc, EventTime_1 asc
// Repeated values whose inclusive active intervals overlap contribute only once.
| extend CountedValueStarts = isnull(prev(EventTime_1)) or GroupCase != prev(GroupCase) or CountedValue != prev(CountedValue) or EventTime_1 > prev(EventTime_1) + 5m,
    CountedValueEnds = isnull(next(EventTime_1)) or GroupCase != next(GroupCase) or CountedValue != next(CountedValue) or next(EventTime_1) > EventTime_1 + 5m);
let CountedOtherActivity = materialize(ValueCountSources
| where isnotempty(CountedOther)
| summarize by GroupCase, CountedOther, EventTime_1
| sort by GroupCase asc, CountedOther asc, EventTime_1 asc
// Repeated values whose inclusive active intervals overlap contribute only once.
| extend CountedOtherStarts = isnull(prev(EventTime_1)) or GroupCase != prev(GroupCase) or CountedOther != prev(CountedOther) or EventTime_1 > prev(EventTime_1) + 5m,
    CountedOtherEnds = isnull(next(EventTime_1)) or GroupCase != next(GroupCase) or CountedOther != next(CountedOther) or next(EventTime_1) > EventTime_1 + 5m);
union (ValueCountSources | summarize by GroupCase, EventTime_1
| project GroupCase, ValueBoundaryTime = EventTime_1, ValueBoundaryOrder = 1, CountedValueDelta = 0, CountedOtherDelta = 0),
(CountedValueActivity | where CountedValueStarts
| project GroupCase, ValueBoundaryTime = EventTime_1, ValueBoundaryOrder = 0, CountedValueDelta = 1, CountedOtherDelta = 0),
(CountedValueActivity | where CountedValueEnds
| project GroupCase, ValueBoundaryTime = EventTime_1 + 5m, ValueBoundaryOrder = 2, CountedValueDelta = -1, CountedOtherDelta = 0),
(CountedOtherActivity | where CountedOtherStarts
| project GroupCase, ValueBoundaryTime = EventTime_1, ValueBoundaryOrder = 0, CountedValueDelta = 0, CountedOtherDelta = 1),
(CountedOtherActivity | where CountedOtherEnds
| project GroupCase, ValueBoundaryTime = EventTime_1 + 5m, ValueBoundaryOrder = 2, CountedValueDelta = 0, CountedOtherDelta = -1)
// All interval starts precede anchors; equal-time expirations follow them.
| sort by GroupCase asc, ValueBoundaryTime asc, ValueBoundaryOrder asc
| extend ["ValueCount_Value"] = row_cumsum(CountedValueDelta, GroupCase != prev(GroupCase)), ["ValueCount_Other"] = row_cumsum(CountedOtherDelta, GroupCase != prev(GroupCase))
| where ValueBoundaryOrder == 1
| where ["ValueCount_Value"] >= 2 and ["ValueCount_Other"] >= 2
| project WindowStart = ValueBoundaryTime - 5m, WindowEnd = ValueBoundaryTime, ["Case"] = GroupCase, ["ValueCount_Value"], ["ValueCount_Other"]
};
let Expected=datatable(WindowStart:datetime,WindowEnd:datetime,Case:string,ValueCount_Value:long,ValueCount_Other:long) [
 datetime(2026-01-01T11:57:00Z),datetime(2026-01-01T12:02:00Z),"both",2,2,
 datetime(2026-01-01T11:58:00Z),datetime(2026-01-01T12:03:00Z),"both",2,2];
union (Actual() | extend Case=tostring(Case) | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Case, ValueCount_Value, ValueCount_Other
| where Delta != 0
