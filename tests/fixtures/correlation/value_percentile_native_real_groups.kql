// Public-conversion comparison; execution status is hash-scoped in RUNTIME.md.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
let Events=datatable(Timestamp:datetime,Group:real,Amount:long,Marker:string)[
 datetime(2026-01-01T12:00:00Z),real(nan),1,"match",
 datetime(2026-01-01T12:00:00Z),real(nan),2,"match",
 datetime(2026-01-01T12:00:00Z),real(nan),100,"match",
 datetime(2026-01-01T12:00:00Z),real(nan),200,"match",
 datetime(2026-01-01T12:00:00Z),real(+inf),1,"match",
 datetime(2026-01-01T12:00:00Z),real(+inf),2,"match",
 datetime(2026-01-01T12:00:00Z),real(+inf),100,"match",
 datetime(2026-01-01T12:00:00Z),real(+inf),200,"match",
 datetime(2026-01-01T12:00:00Z),real(-inf),1,"match",
 datetime(2026-01-01T12:00:00Z),real(-inf),2,"match",
 datetime(2026-01-01T12:00:00Z),real(-inf),100,"match",
 datetime(2026-01-01T12:00:00Z),real(-inf),200,"match",
 datetime(2026-01-01T12:00:00Z),real(-0.0),1,"match",
 datetime(2026-01-01T12:00:00Z),real(+0.0),2,"match",
 datetime(2026-01-01T12:00:00Z),real(-0.0),100,"match",
 datetime(2026-01-01T12:00:00Z),real(+0.0),200,"match"
];
let Actual=(){
let PercentileObservations = union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]), GroupGroup = ["Group"], MeasuredAmount = ["Amount"])
| where isnotnull(EventTime_1) and isnotempty(GroupGroup);
let PercentileWindowValues = materialize(
PercentileObservations
| project GroupGroup, PercentileWindowEnd = EventTime_1, PercentileTimeBin = bin(EventTime_1, 5m)
| distinct *
| join kind=inner (
PercentileObservations
| where isnotnull(MeasuredAmount)
| extend PercentileTimeBin = pack_array(bin(EventTime_1, 5m), bin(EventTime_1, 5m) + 5m)
| mv-expand PercentileTimeBin to typeof(datetime)
) on GroupGroup, PercentileTimeBin
| where EventTime_1 between ((PercentileWindowEnd - 5m) .. PercentileWindowEnd)
| project GroupGroup, PercentileWindowEnd, MeasuredAmount
);
PercentileWindowValues
| join kind=inner (
PercentileWindowValues | summarize PercentilePopulation = count() by GroupGroup, PercentileWindowEnd
) on GroupGroup, PercentileWindowEnd
| project GroupGroup, PercentileWindowEnd, MeasuredAmount, PercentilePopulation
| sort by GroupGroup asc, PercentileWindowEnd asc, MeasuredAmount asc
| serialize PercentileRank = row_number(1, (GroupGroup != prev(GroupGroup) and not(isnan(GroupGroup) and isnan(prev(GroupGroup)))) or PercentileWindowEnd != prev(PercentileWindowEnd))
| where PercentileRank == max_of(1, (PercentilePopulation / 100) * 50 + tolong(ceiling(toreal((PercentilePopulation % 100) * 50) / 100.0)))
| extend ValuePercentile = MeasuredAmount
| where ValuePercentile >= 0
| project WindowStart = PercentileWindowEnd - 5m, WindowEnd = PercentileWindowEnd, ["Group"] = GroupGroup, ValuePercentile
};
let Expected=datatable(Group:string)["NaN","inf","-inf","0.0"]
| extend WindowStart=datetime(2026-01-01T11:55:00Z),WindowEnd=datetime(2026-01-01T12:00:00Z),ValuePercentile=long(2);
let Observed=Actual() | extend Group=tostring(Group);
union (Observed | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Group, ValuePercentile
| where Delta != 0
