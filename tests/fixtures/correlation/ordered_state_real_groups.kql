// Prepared deterministic fixture; live engine execution has not been performed.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
// Each complete native group has a@0, b@1, c@2. Group 2 has c only.
// The oracle uses native summarize grouping, independently of scan resets.
let Kinds=datatable(Group:real) [real(nan),real(+inf),real(-inf),real(-0.0),real(1.0)];
let Events=union
 (Kinds | extend Timestamp=datetime(2026-01-01T00:00:00),Marker="a"),
 (Kinds | extend Timestamp=datetime(2026-01-01T00:01:00),Marker="b"),
 (Kinds | extend Timestamp=datetime(2026-01-01T00:02:00),Marker="c"),
 (datatable(Group:real,Timestamp:datetime,Marker:string) [2.0,datetime(2026-01-01T00:03:00),"c"]);
let Expected=Events
| summarize RuleCount=count_distinct(Marker),WindowEnd=max(Timestamp) by Group
| where RuleCount==3
| extend WindowStart=WindowEnd-5m;
let Actual=(){
// Strict sequence: "a" -> "b" -> "c". Total inclusive span: 5m.
union (Events
| where Marker =~ "a"
| extend EventTime_1 = todatetime(["Timestamp"]), GroupGroup = ["Group"]
| extend SourceRule = "a"),
(Events
| where Marker =~ "b"
| extend EventTime_1 = todatetime(["Timestamp"]), GroupGroup = ["Group"]
| extend SourceRule = "b"),
(Events
| where Marker =~ "c"
| extend EventTime_1 = todatetime(["Timestamp"]), GroupGroup = ["Group"]
| extend SourceRule = "c")
| where isnotnull(EventTime_1) and isnotempty(GroupGroup)
// Batch equal timestamps: simultaneous source matches cannot advance strict sequence positions.
| summarize HasA = countif(SourceRule == "a") > 0, HasB = countif(SourceRule == "b") > 0, HasC = countif(SourceRule == "c") > 0 by EventTime_1, GroupGroup
| sort by GroupGroup asc, EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1)) or (GroupGroup != prev(GroupGroup) and not(isnan(GroupGroup) and isnan(prev(GroupGroup))))
// Read preceding timestamp state for every assignment; preserve viable earlier prefixes.
| scan declare (LatestAStart:datetime = datetime(null), LatestAThenBStart:datetime = datetime(null), CompleteNow:bool = false) with (
    step SequenceState: true =>
        CompleteNow = not(NewCorrelationGroup) and HasC and isnotnull(SequenceState.LatestAThenBStart) and SequenceState.LatestAThenBStart >= EventTime_1 - 5m,
        LatestAStart = iff(HasA, EventTime_1, iff(NewCorrelationGroup, datetime(null), SequenceState.LatestAStart)),
        LatestAThenBStart = iff(NewCorrelationGroup, datetime(null), iff(HasB and isnotnull(SequenceState.LatestAStart) and SequenceState.LatestAStart >= EventTime_1 - 5m and (isnull(SequenceState.LatestAThenBStart) or SequenceState.LatestAStart > SequenceState.LatestAThenBStart), SequenceState.LatestAStart, SequenceState.LatestAThenBStart));
)
| where CompleteNow
| project WindowStart = EventTime_1 - 5m, WindowEnd = EventTime_1, ["Group"] = GroupGroup, RuleCount = tolong(3)
};
union (Actual() | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Group, RuleCount
| where Delta != 0
