// Prepared acceptance fixture; runtime PENDING.
let Events=datatable(Timestamp:datetime,Marker:string,Amount:real) [
 datetime(2026-01-01T12:00:00Z),"match",2.5
];
let Actual=(){
let _sigma_shared_child = () {
let _sigma_context_summary = () {
// Strict sequence: "source-rule". Total inclusive span: 1m.
union (Events
| where Marker =~ "match"
| extend EventTime_1 = todatetime(["Timestamp"])
| extend SourceRule = "source-rule")
| where isnotnull(EventTime_1)
// Batch equal timestamps: simultaneous source matches cannot advance strict sequence positions.
| summarize by EventTime_1
| project WindowStart = EventTime_1 - 1m, WindowEnd = EventTime_1, RuleCount = tolong(1)
};
let _sigma_context_summaries = materialize(_sigma_context_summary()
| serialize _sigma_context_id = row_number());
let _sigma_context_matches = materialize(
_sigma_context_summaries | project _sigma_context_id, _sigma_context_end = WindowEnd, _sigma_context_partition = 1
| join kind=inner (
union (Events
| where Marker =~ "match"
| extend _sigma_context_timestamp = todatetime(["Timestamp"]), _sigma_context_value = ["Amount"]
| extend _sigma_context_rule = "source-rule")
| project _sigma_context_timestamp, _sigma_context_rule, _sigma_context_value, _sigma_context_partition = 1
) on _sigma_context_partition
| where _sigma_context_timestamp between ((_sigma_context_end - 1m) .. _sigma_context_end)
| serialize _sigma_context_key = row_number());
let _sigma_context_path = _sigma_context_matches
| where _sigma_context_rule == "source-rule"
| project _sigma_context_id, _sigma_context_end, _sigma_context_step = _sigma_context_key, _sigma_context_step_time = _sigma_context_timestamp
| where _sigma_context_step_time == _sigma_context_end
| project _sigma_context_id, _sigma_context_end, _sigma_context_step, _sigma_context_previous = _sigma_context_step_time;
let _sigma_context_participating = union (_sigma_context_path | project _sigma_context_id, _sigma_context_key = _sigma_context_step)
| distinct _sigma_context_id, _sigma_context_key;
let _sigma_context_selected = materialize(_sigma_context_matches
| join kind=leftsemi (_sigma_context_participating) on _sigma_context_id, _sigma_context_key);
let _sigma_context_rows = materialize(_sigma_context_selected
| project _sigma_context_id, _sigma_context_value
| distinct *);
union (_sigma_context_summaries | extend ContextRowKind = "Summary"), (_sigma_context_summaries | join kind=inner (_sigma_context_rows) on _sigma_context_id | extend ContextRowKind = "ContextEvidence")
};
let _sigma_shared_results = materialize(_sigma_shared_child());
let _sigma_context_summary = () {
let _sigma_parent_matches = materialize(union (_sigma_shared_results | where ["ContextRowKind"] == "Summary"
| project-away ["_sigma_context_value"]
| join kind=leftouter (_sigma_shared_results | where ["ContextRowKind"] == "ContextEvidence" | project ["_sigma_context_id"], ["_sigma_context_value"]) on ["_sigma_context_id"]
| extend _sigma_child_match = strcat("_sigma_shared_child", "_", tostring(["_sigma_context_id"]))
| extend _sigma_timestamp = todatetime(["WindowEnd"]), _sigma_value = pack_array(gettype(["_sigma_context_value"]), ["_sigma_context_value"])
| extend _sigma_rule = "child")
| extend _sigma_child_match = tostring(column_ifexists("_sigma_child_match", "")));
let _sigma_values = union (_sigma_parent_matches | where isempty(_sigma_child_match)), (_sigma_parent_matches | where isnotempty(_sigma_child_match) | extend RetainedNumericValue = toreal(_sigma_value[1]) | summarize take_any(*) by _sigma_child_match, RetainedNumericValue)
| where isnotnull(_sigma_timestamp)
;
_sigma_values
| project _sigma_window_end = _sigma_timestamp, _sigma_bin = bin(_sigma_timestamp, 5m)
| distinct *
| join kind=inner (
    _sigma_values
    | extend _sigma_bin = pack_array(bin(_sigma_timestamp, 5m), bin(_sigma_timestamp, 5m) + 5m)
    | mv-expand _sigma_bin to typeof(datetime)
) on _sigma_bin
| where _sigma_timestamp between ((_sigma_window_end - 5m) .. _sigma_window_end)
| summarize ValueAvg = avgif(toreal(_sigma_value[1]), tostring(_sigma_value[0]) in ("int", "long", "real", "double", "decimal") and isfinite(toreal(_sigma_value[1]))), _sigma_numeric_count = countif(tostring(_sigma_value[0]) in ("int", "long", "real", "double", "decimal") and isfinite(toreal(_sigma_value[1]))) by _sigma_window_end
| where _sigma_numeric_count > 0 and ValueAvg >= 1
| project WindowStart = _sigma_window_end - 5m, WindowEnd = _sigma_window_end, ValueAvg
};
let _sigma_context_summaries = materialize(_sigma_context_summary()
| serialize _sigma_context_id_1 = row_number());
let _sigma_context_matches = materialize(
_sigma_context_summaries | project _sigma_context_id_1, _sigma_context_end = WindowEnd, _sigma_context_partition = 1
| join kind=inner (
union (_sigma_shared_results
| where ["ContextRowKind"] == "ContextEvidence"
| extend _sigma_context_timestamp = todatetime(["WindowEnd"]), _sigma_context_value_1 = toreal(pack_array(gettype(["_sigma_context_value"]), ["_sigma_context_value"])[1])
| extend _sigma_context_rule = "child")
| project _sigma_context_timestamp, _sigma_context_rule, _sigma_context_value_1, _sigma_context_partition = 1
) on _sigma_context_partition
| where _sigma_context_timestamp between ((_sigma_context_end - 5m) .. _sigma_context_end)
| serialize _sigma_context_key = row_number());
let _sigma_context_rows = materialize(_sigma_context_matches
| project _sigma_context_id_1, _sigma_context_value_1
| distinct *);
let ContextValues = _sigma_context_rows
| where isnotnull(_sigma_context_value_1)
| summarize by _sigma_context_id_1, _sigma_context_value_1
| summarize DisplayedValues = make_list(_sigma_context_value_1, 1000), DistinctValueCount = count() by _sigma_context_id_1;
_sigma_context_summaries
| join kind=leftouter (ContextValues) on _sigma_context_id_1
| extend ["Amount"] = coalesce(DisplayedValues, dynamic([]))
| extend ContextComplete = coalesce(DistinctValueCount, 0) <= 1000
| project ["WindowStart"], ["WindowEnd"], ["Amount"], ["ValueAvg"], ["ContextComplete"]
};
let Observed=Actual() | project WindowStart,WindowEnd,Metric=toreal(ValueAvg);
let Expected=datatable(WindowStart:datetime,WindowEnd:datetime,Metric:real) [
 datetime(2026-01-01T11:55:00Z),datetime(2026-01-01T12:00:00Z),2.5
];
union (Observed | extend Delta=1),(Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowStart,WindowEnd,Metric
| where Delta!=0
