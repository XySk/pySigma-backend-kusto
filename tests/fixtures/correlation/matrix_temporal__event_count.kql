// Public-conversion comparison; execution status is hash-scoped in RUNTIME.md.
let Events=datatable(Timestamp:datetime,Marker:string,Amount:real) [
 datetime(2026-01-01T12:00:00Z),"match",2.5
];
let Actual=(){
let Child = () {
let ContextSummary = () {
Events
| where Marker =~ "match"
| project EventTime_1 = ["Timestamp"], SourceRule = "source-rule"
| where isnotnull(EventTime_1)
// Batch simultaneous source matches before updating inclusive trailing presence.
| summarize MatchesSourcerule = countif(SourceRule == "source-rule") > 0 by EventTime_1
| sort by EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1))
| scan declare (LastSourceruleTime:datetime) with (
    step PresenceWindow: true =>
        LastSourceruleTime = iff(MatchesSourcerule, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastSourceruleTime));
)
// Only source-match timestamps evaluate; expiration never creates an anchor.
| extend HasSourcerule = isnotnull(LastSourceruleTime) and LastSourceruleTime >= EventTime_1 - 1m
| extend RuleCount = tolong(HasSourcerule)
| where RuleCount >= 1
| project WindowStart = EventTime_1 - 1m, WindowEnd = EventTime_1, RuleCount
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId = row_number());
let WindowSourceMatches = materialize(
CorrelationMatches | project CorrelationMatchId, CompletionTime = WindowEnd, ContextPartition = 1
| join kind=inner (
Events
| where Marker =~ "match"
| extend ContextEventTime = ["Timestamp"], ContextAmount = ["Amount"]
| where isnotnull(ContextEventTime)
| extend ContextSourceRule = "source-rule"
| project ContextEventTime, ContextSourceRule, ContextAmount, ContextPartition = 1
) on ContextPartition
| where ContextEventTime between ((CompletionTime - 1m) .. CompletionTime));
let CompleteContextRelationships = materialize(WindowSourceMatches
| project CorrelationMatchId, ContextAmount
| distinct *);
union (CorrelationMatches | extend ContextRowKind = "Summary"), (CorrelationMatches | join kind=inner (CompleteContextRelationships) on CorrelationMatchId | extend ContextRowKind = "ContextEvidence")
};
let ChildResults = materialize(Child());
let ContextSummary = () {
let SourceMatchArrivals = ChildResults
| where ["ContextRowKind"] == "Summary"
| extend ChildCorrelationMatch = strcat("Child", "_", tostring(["CorrelationMatchId"]))
| project EventTime = ["WindowEnd"], ChildCorrelationMatch
| where isnotnull(EventTime)
| summarize SourceMatchCount = count() by EventTime;
union (SourceMatchArrivals
| project CountBoundaryTime = EventTime, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project CountBoundaryTime = EventTime + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta)
| where CountBoundaryOrder == 0
| where EventCount >= 1
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, EventCount
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId_1 = row_number());
let WindowSourceMatches = materialize(
CorrelationMatches | project CorrelationMatchId_1, CompletionTime = WindowEnd, ContextPartition = 1
| join kind=inner (
ChildResults | where ["ContextRowKind"] == "Summary"
| project-away ["ContextAmount"]
| join kind=leftouter (ChildResults | where ["ContextRowKind"] == "ContextEvidence" | project ["CorrelationMatchId"], ["ContextAmount"], HasContextEvidence = true) on ["CorrelationMatchId"]
| extend ContextEventTime = ["WindowEnd"], ContextAmount = ["ContextAmount"]
| where isnotnull(ContextEventTime)
| extend ContextSourceRule = "child"
| project ContextEventTime, ContextSourceRule, ContextAmount, HasContextEvidence, ContextPartition = 1
) on ContextPartition
| where ContextEventTime between ((CompletionTime - 5m) .. CompletionTime));
let CompleteContextRelationships = materialize(WindowSourceMatches
| where HasContextEvidence
| project CorrelationMatchId_1, ContextAmount
| distinct *);
let ValuesForAmount = CompleteContextRelationships
| where isnotnull(ContextAmount)
| summarize by CorrelationMatchId_1, ContextAmount
| summarize DisplayedAmount = make_list(ContextAmount, 1000), DistinctAmountCount = count() by CorrelationMatchId_1;
CorrelationMatches
| join kind=leftouter (ValuesForAmount) on CorrelationMatchId_1
| extend ["Amount"] = coalesce(DisplayedAmount, dynamic([]))
| extend ContextComplete = coalesce(DistinctAmountCount, 0) <= 1000
| project ["WindowStart"], ["WindowEnd"], ["Amount"], ["EventCount"], ["ContextComplete"]
};
let Observed=Actual() | project WindowStart,WindowEnd,Metric=toreal(EventCount);
let Expected=datatable(WindowStart:datetime,WindowEnd:datetime,Metric:real) [
 datetime(2026-01-01T11:55:00Z),datetime(2026-01-01T12:00:00Z),1
];
union (Observed | extend Delta=1),(Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowStart,WindowEnd,Metric
| where Delta!=0
