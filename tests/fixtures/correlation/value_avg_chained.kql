// Public-conversion comparison; execution status is hash-scoped in RUNTIME.md.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
// Child means 2 and 4 contribute once, alongside direct 9: parent 2 then 5.
let Events=datatable(Timestamp:datetime, Host:string, Amount:dynamic, Marker:string) [
    datetime(2026-01-01T12:00:00Z), "h", dynamic(2), "child",
    datetime(2026-01-01T12:01:00Z), "h", dynamic(6), "child",
    datetime(2026-01-01T12:01:00Z), "h", dynamic(9), "direct"
]
// Normalize Events scalar fixture inputs explicitly.
| extend Amount=iff(gettype(Amount) in ("int","long","real","double","decimal"), toreal(Amount), real(null));
let Actual = () {
let Child = () {
let AverageObservations = Events
| where Marker =~ "child"
| project EventTime_1 = ["Timestamp"], GroupHost = ["Host"], MeasuredAmount = ["Amount"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost);
AverageObservations
| summarize by GroupHost, AverageWindowEnd = EventTime_1, AverageTimeBin = bin(EventTime_1, 5m)
| join kind=inner (
AverageObservations
| extend AverageTimeBin = pack_array(bin(EventTime_1, 5m), bin(EventTime_1, 5m) + 5m)
| mv-expand AverageTimeBin to typeof(datetime)
) on GroupHost, AverageTimeBin
| where EventTime_1 between ((AverageWindowEnd - 5m) .. AverageWindowEnd)
| summarize ValueAvg = avgif(toreal(MeasuredAmount), isfinite(toreal(MeasuredAmount))) by AverageWindowEnd, GroupHost
| where isfinite(ValueAvg) and ValueAvg >= 0
| project WindowStart = AverageWindowEnd - 5m, WindowEnd = AverageWindowEnd, ["Host"] = GroupHost, ValueAvg
};
let AverageObservations = union (Child()
| project EventTime_1 = ["WindowEnd"], GroupHost = ["Host"], MeasuredMeasured = ["ValueAvg"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost)),
(Events
| where Marker =~ "direct"
| project EventTime_1 = ["Timestamp"], GroupHost = ["Host"], MeasuredMeasured = ["Amount"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost));
AverageObservations
| summarize by GroupHost, AverageWindowEnd = EventTime_1, AverageTimeBin = bin(EventTime_1, 5m)
| join kind=inner (
AverageObservations
| extend AverageTimeBin = pack_array(bin(EventTime_1, 5m), bin(EventTime_1, 5m) + 5m)
| mv-expand AverageTimeBin to typeof(datetime)
) on GroupHost, AverageTimeBin
| where EventTime_1 between ((AverageWindowEnd - 5m) .. AverageWindowEnd)
| summarize ValueAvg = avgif(toreal(MeasuredMeasured), isfinite(toreal(MeasuredMeasured))) by AverageWindowEnd, GroupHost
| where isfinite(ValueAvg) and ValueAvg >= 0
| project WindowStart = AverageWindowEnd - 5m, WindowEnd = AverageWindowEnd, ["Host"] = GroupHost, ValueAvg
};
let Expected = datatable(WindowStart:datetime, WindowEnd:datetime, Host:string, ValueAvg:real) [
    datetime(2026-01-01T11:55:00Z), datetime(2026-01-01T12:00:00Z), "h", 2.0,
    datetime(2026-01-01T11:56:00Z), datetime(2026-01-01T12:01:00Z), "h", 5.0
];
union (Actual() | extend Host=tostring(Host) | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Host, ValueAvg
| where Delta != 0
