let Events=datatable(Timestamp:datetime,Host:string,Marker:string,User:long,Server:string,Amount:long) [
 datetime(2026-01-01T12:00:00Z),"h","match",1,"server",2,
 datetime(2026-01-01T12:00:00Z),"h","match",1,"server",2,
 datetime(2026-01-01T12:00:00Z),"h","match",2,"server",3,
 datetime(null),"h","match",1,"server",100,
 datetime(2026-01-01T12:00:00Z),"h","match",long(null),"server",100,
 datetime(2026-01-01T12:00:00Z),"h","match",1,"",100
];
let Actual=(){
union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]), GroupUser = ["User"], GroupServer = ["Server"], SourceRule = "source-rule")
| where isnotnull(EventTime_1) and isnotempty(GroupUser) and isnotempty(GroupServer)
// Batch simultaneous source matches before updating inclusive trailing presence.
| summarize MatchesSourcerule = countif(SourceRule == "source-rule") > 0 by GroupUser, GroupServer, EventTime_1
| sort by GroupUser asc, GroupServer asc, EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1)) or GroupUser != prev(GroupUser) or GroupServer != prev(GroupServer)
| scan declare (LastSourceruleTime:datetime) with (
    step PresenceWindow: true =>
        LastSourceruleTime = iff(MatchesSourcerule, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastSourceruleTime));
)
// Only source-match timestamps evaluate; expiration never creates an anchor.
| extend HasSourcerule = isnotnull(LastSourceruleTime) and LastSourceruleTime >= EventTime_1 - 5m
| extend RuleCount = tolong(HasSourcerule)
| where RuleCount >= 1
| project WindowStart = EventTime_1 - 5m, WindowEnd = EventTime_1, ["User"] = GroupUser, ["Server"] = GroupServer, RuleCount
};
let Observed=Actual() | project WindowEnd,Kind=gettype(User),Value=tostring(User),Server=tostring(Server),Metric=toreal(RuleCount);
let Expected=datatable(WindowEnd:datetime,Kind:string,Value:string,Server:string,Metric:real) [
 datetime(2026-01-01T12:00:00Z),"long","1",'server',1,
 datetime(2026-01-01T12:00:00Z),"long","2",'server',1
];
union (Observed | extend Delta=1),(Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowEnd,Kind,Value,Server,Metric
| where Delta!=0
