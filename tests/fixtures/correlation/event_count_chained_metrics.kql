// Normalize Events scalar fixture inputs explicitly.
| extend ProcessTime=todatetime(ProcessTime);
let Actual = () {
let ChildRule = () {
let SourceMatchArrivals = union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["ProcessTime"]), GroupCase = ["Case"], GroupActor = ["ProcessUser"], GroupHost = ["ProcessHost"])
| where isnotnull(EventTime_1) and isnotempty(GroupCase) and isnotempty(GroupActor) and isnotempty(GroupHost)
| summarize SourceMatchCount = count() by EventTime_1, GroupCase, GroupActor, GroupHost;
union (SourceMatchArrivals
| project GroupCase, GroupActor, GroupHost, CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupCase, GroupActor, GroupHost, CountBoundaryTime = EventTime_1 + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupCase asc, GroupActor asc, GroupHost asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupCase != prev(GroupCase) or GroupActor != prev(GroupActor) or GroupHost != prev(GroupHost))
| where CountBoundaryOrder == 0
| where EventCount >= 2
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, ["Case"] = GroupCase, ["Actor"] = GroupActor, ["Host"] = GroupHost, EventCount
};
let SourceMatchArrivals = union (ChildRule()
| project EventTime = todatetime(["WindowEnd"]), GroupCase = ["Case"], GroupActor = ["Actor"], GroupChildCount = ["EventCount"])
| where isnotnull(EventTime) and isnotempty(GroupCase) and isnotempty(GroupActor) and isnotempty(GroupChildCount)
| summarize SourceMatchCount = count() by EventTime, GroupCase, GroupActor, GroupChildCount;
union (SourceMatchArrivals
| project GroupCase, GroupActor, GroupChildCount, CountBoundaryTime = EventTime, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupCase, GroupActor, GroupChildCount, CountBoundaryTime = EventTime + 10m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupCase asc, GroupActor asc, GroupChildCount asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupCase != prev(GroupCase) or GroupActor != prev(GroupActor) or GroupChildCount != prev(GroupChildCount))
| where CountBoundaryOrder == 0
| where EventCount >= 2
| project WindowStart = CountBoundaryTime - 10m, WindowEnd = CountBoundaryTime, ["Case"] = GroupCase, ["Actor"] = GroupActor, ["ChildCount"] = GroupChildCount, EventCount
};
let Expected = datatable(WindowStart:datetime, WindowEnd:datetime, Case:string, Actor:string, ChildCount:string, EventCount:long) [
    datetime(2026-01-01T11:55:00.0000001Z), datetime(2026-01-01T12:05:00.0000001Z), "metric", "alice", "2", 2
];
