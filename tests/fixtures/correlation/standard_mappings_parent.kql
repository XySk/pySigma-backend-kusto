// Generated public conversion; two process searches contribute separately.
let Events=datatable(['Process Time']:datetime, ['Process Host']:string, ['Process Actor']:string,
 ['Process Amount']:long, ['Process Marker']:string) [
 datetime(2026-01-01T12:00:00Z), "h", "Alice", 10, "match",
 datetime(2026-01-01T12:00:00Z), "h", "ignored", 100, "other"
];
let NetworkEvents=datatable(['Network Time']:datetime, ['Network Host']:string, ['Network Actor']:string,
 ['Network Amount']:long, ['Network Marker']:string) [
 datetime(2026-01-01T12:00:00Z), "h", "Bob", 20, "match"
];
let Actual=() {
let Mapped = () {
let ContextSummary = () {
let SumObservations = union (Events
| where ["Process Marker"] =~ "match"
| project EventTime_1 = todatetime(["Process Time"]), GroupHost = ["Process Host"], MeasuredAmount = ["Process Amount"]),
(Events
| where ["Process Marker"] =~ "match"
| project EventTime_1 = todatetime(["Process Time"]), GroupHost = ["Process Host"], MeasuredAmount = ["Process Amount"]),
(NetworkEvents
| where ["Network Marker"] =~ "match"
| project EventTime_1 = todatetime(["Network Time"]), GroupHost = ["Network Host"], MeasuredAmount = ["Network Amount"])
| where isnotnull(EventTime_1) and isnotempty(GroupHost);
let SumArrivals = SumObservations
| summarize ArrivalSum = sum(MeasuredAmount) by EventTime_1, GroupHost;
union (SumArrivals
| project GroupHost, SumBoundaryTime = EventTime_1, SumBoundaryOrder = 0, SumDelta = ArrivalSum),
(SumArrivals
| project GroupHost, SumBoundaryTime = EventTime_1 + 5m, SumBoundaryOrder = 1, SumDelta = -ArrivalSum)
// Arrivals evaluate before equal-time expirations, including zero and missing values.
| sort by GroupHost asc, SumBoundaryTime asc, SumBoundaryOrder asc
| extend ValueSum = row_cumsum(SumDelta, GroupHost != prev(GroupHost))
| where SumBoundaryOrder == 0
| where ValueSum >= 0
| project WindowStart = SumBoundaryTime - 5m, WindowEnd = SumBoundaryTime, ["Host"] = GroupHost, ValueSum
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId = row_number());
let WindowSourceMatches = materialize(
CorrelationMatches | project CorrelationMatchId, CompletionTime = WindowEnd, ContextGroupHost = ["Host"], ContextPartition = 1
| join kind=inner (
union (Events
| where ["Process Marker"] =~ "match"
| extend ContextEventTime = todatetime(["Process Time"]), ContextGroupHost = ["Process Host"], ContextUser = ["Process Actor"]
| extend ContextSourceRule = "source-rule"),
(Events
| where ["Process Marker"] =~ "match"
| extend ContextEventTime = todatetime(["Process Time"]), ContextGroupHost = ["Process Host"], ContextUser = ["Process Actor"]
| extend ContextSourceRule = "source-rule"),
(NetworkEvents
| where ["Network Marker"] =~ "match"
| extend ContextEventTime = todatetime(["Network Time"]), ContextGroupHost = ["Network Host"], ContextUser = ["Network Actor"]
| extend ContextSourceRule = "network-rule")
| project ContextEventTime, ContextSourceRule, ContextGroupHost, ContextUser, ContextPartition = 1
) on ContextGroupHost
| where ContextEventTime between ((CompletionTime - 5m) .. CompletionTime));
let CompleteContextRelationships = materialize(WindowSourceMatches
| project CorrelationMatchId, ContextUser
| distinct *);
union (CorrelationMatches | extend ContextRowKind = "Summary"), (CorrelationMatches | join kind=inner (CompleteContextRelationships) on CorrelationMatchId | extend ContextRowKind = "ContextEvidence")
};
let MappedResults = materialize(Mapped());
let ParentSourceMatches = materialize(union (MappedResults
| where ["ContextRowKind"] == "ContextEvidence"
| extend ChildCorrelationMatch = strcat("Mapped", "_", tostring(["CorrelationMatchId"]))
| project EventTime = todatetime(["WindowEnd"]), GroupHost = ["Host"], GroupUser = ["ContextUser"], ChildCorrelationMatch)
| extend ChildCorrelationMatch = tostring(column_ifexists("ChildCorrelationMatch", "")));
let SourceMatchArrivals = union (ParentSourceMatches | where isempty(ChildCorrelationMatch)), (ParentSourceMatches | where isnotempty(ChildCorrelationMatch) | summarize take_any(*) by ChildCorrelationMatch, GroupHost, GroupUser)
| where isnotnull(EventTime) and isnotempty(GroupHost) and isnotempty(GroupUser)
| summarize SourceMatchCount = count() by EventTime, GroupHost, GroupUser;
union (SourceMatchArrivals
| project GroupHost, GroupUser, CountBoundaryTime = EventTime, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupHost, GroupUser, CountBoundaryTime = EventTime + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupHost asc, GroupUser asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupHost != prev(GroupHost) or GroupUser != prev(GroupUser))
| where CountBoundaryOrder == 0
| where EventCount >= 1
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, ["Host"] = GroupHost, ["User"] = GroupUser, EventCount
| extend ContextComplete = true
};
let Observed=Actual() | project WindowStart, WindowEnd, Host=tostring(Host), Actor=tostring(User), EventCount;
let Expected=datatable(WindowStart:datetime, WindowEnd:datetime, Host:string, Actor:string, EventCount:long) [
 datetime(2026-01-01T11:55:00Z), datetime(2026-01-01T12:00:00Z), "h", "Alice", 1,
 datetime(2026-01-01T11:55:00Z), datetime(2026-01-01T12:00:00Z), "h", "Bob", 1
];
union (Observed | extend Delta=1), (Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowStart, WindowEnd, Host, Actor, EventCount
| where Delta!=0
