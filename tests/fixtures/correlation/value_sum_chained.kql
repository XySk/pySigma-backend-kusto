// Public-conversion comparison; execution status is hash-scoped in RUNTIME.md.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
// Child summaries are 2 at 12:00 and 5 at 12:01.
// The parent counts each child summary once and adds direct amount 4 at 12:01.
let Events=datatable(Timestamp:string, Host:string, Amount:dynamic, Marker:string) [
    "2026-01-01T12:00:00Z", "h", dynamic(2), "child",
    "2026-01-01T12:01:00Z", "h", dynamic(3), "child",
    "2026-01-01T12:01:00Z", "h", dynamic(4), "direct"
]
// Normalize Events scalar fixture inputs explicitly.
| extend Amount=iff(gettype(Amount) in ("int","long","real","double","decimal"), tolong(Amount), long(null)), Timestamp=todatetime(Timestamp);
let Actual = () {
let Child = () {
let SumObservations = Events
| where Marker =~ "child"
| project EventTime_1 = ["Timestamp"], GroupHost = ["Host"], MeasuredAmount = ["Amount"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost);
let SumArrivals = SumObservations
| summarize ArrivalSum = sum(MeasuredAmount) by EventTime_1, GroupHost;
union (SumArrivals
| project GroupHost, SumBoundaryTime = EventTime_1, SumBoundaryOrder = 0, SumDelta = ArrivalSum),
(SumArrivals
| project GroupHost, SumBoundaryTime = EventTime_1 + 5m, SumBoundaryOrder = 1, SumDelta = -ArrivalSum)
// Arrivals evaluate before equal-time expirations, including zero and missing values.
| sort by GroupHost asc, SumBoundaryTime asc, SumBoundaryOrder asc
| extend ValueSum = row_cumsum(SumDelta, GroupHost != prev(GroupHost))
| where SumBoundaryOrder == 0
| where ValueSum >= 0
| project WindowStart = SumBoundaryTime - 5m, WindowEnd = SumBoundaryTime, ["Host"] = GroupHost, ValueSum
};
let SumObservations = union (Child()
| project EventTime_1 = ["WindowEnd"], GroupHost = ["Host"], MeasuredMeasured = ["ValueSum"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost)),
(Events
| where Marker =~ "direct"
| project EventTime_1 = ["Timestamp"], GroupHost = ["Host"], MeasuredMeasured = ["Amount"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost));
let SumArrivals = SumObservations
| summarize ArrivalSum = sum(MeasuredMeasured) by EventTime_1, GroupHost;
union (SumArrivals
| project GroupHost, SumBoundaryTime = EventTime_1, SumBoundaryOrder = 0, SumDelta = ArrivalSum),
(SumArrivals
| project GroupHost, SumBoundaryTime = EventTime_1 + 5m, SumBoundaryOrder = 1, SumDelta = -ArrivalSum)
// Arrivals evaluate before equal-time expirations, including zero and missing values.
| sort by GroupHost asc, SumBoundaryTime asc, SumBoundaryOrder asc
| extend ValueSum = row_cumsum(SumDelta, GroupHost != prev(GroupHost))
| where SumBoundaryOrder == 0
| where ValueSum >= 0
| project WindowStart = SumBoundaryTime - 5m, WindowEnd = SumBoundaryTime, ["Host"] = GroupHost, ValueSum
| project WindowStart, WindowEnd, Host, ValueSum = tolong(ValueSum)
};
let Expected = datatable(WindowStart:datetime, WindowEnd:datetime, Host:string, ValueSum:long) [
    datetime(2026-01-01T11:55:00Z), datetime(2026-01-01T12:00:00Z), "h", 2,
    datetime(2026-01-01T11:56:00Z), datetime(2026-01-01T12:01:00Z), "h", 11
];
union (Actual() | extend Host=tostring(Host) | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Host, ValueSum
| where Delta != 0
