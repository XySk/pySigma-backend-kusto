// Public-conversion comparison; execution status is hash-scoped in RUNTIME.md.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
let Events=datatable(Timestamp:datetime,Group:real,Amount:long,Marker:string) [
 datetime(2026-01-01T00:00:00),real(nan),2,"match",
 datetime(2026-01-01T00:01:00),real(nan),3,"match",
 datetime(2026-01-01T00:00:00),real(+inf),2,"match",
 datetime(2026-01-01T00:01:00),real(+inf),3,"match",
 datetime(2026-01-01T00:00:00),real(-inf),2,"match",
 datetime(2026-01-01T00:01:00),real(-inf),3,"match",
 datetime(2026-01-01T00:00:00),real(-0.0),2,"match",
 datetime(2026-01-01T00:01:00),real(+0.0),3,"match"
];
let Actual=(){
let SumObservations = Events
| where Marker =~ "match"
| project EventTime_1 = ["Timestamp"], GroupGroup = ["Group"], MeasuredAmount = ["Amount"]
| where isnotnull(EventTime_1) and isnotempty(GroupGroup);
let SumArrivals = SumObservations
| summarize ArrivalSum = sum(MeasuredAmount) by EventTime_1, GroupGroup;
union (SumArrivals
| project GroupGroup, SumBoundaryTime = EventTime_1, SumBoundaryOrder = 0, SumDelta = ArrivalSum),
(SumArrivals
| project GroupGroup, SumBoundaryTime = EventTime_1 + 5m, SumBoundaryOrder = 1, SumDelta = -ArrivalSum)
// Arrivals evaluate before equal-time expirations, including zero and missing values.
| sort by GroupGroup asc, SumBoundaryTime asc, SumBoundaryOrder asc
| extend ValueSum = row_cumsum(SumDelta, (GroupGroup != prev(GroupGroup) and not(isnan(GroupGroup) and isnan(prev(GroupGroup)))))
| where SumBoundaryOrder == 0
| where ValueSum >= 0
| project WindowStart = SumBoundaryTime - 5m, WindowEnd = SumBoundaryTime, ["Group"] = GroupGroup, ValueSum
};
let Expected=datatable(WindowEnd:datetime,ValueSum:real) [
 datetime(2026-01-01T00:00:00),2,datetime(2026-01-01T00:01:00),5
]
| extend Keys=dynamic(["NaN","inf","-inf","0.0"])
| mv-expand Group=Keys to typeof(string)
| project WindowEnd,ValueSum,Group;
let Observed=Actual() | project WindowEnd,ValueSum=toreal(ValueSum),Group=tostring(Group);
union (Expected | extend Delta=-1),(Observed | extend Delta=1)
| summarize Delta=sum(Delta) by WindowEnd,ValueSum,Group
| where Delta!=0
