// Prepared deterministic fixture; live engine execution has not been performed.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
let Events = datatable(Timestamp:datetime, Marker:string) [
 datetime(2026-01-01T00:00:00),"failure",
 datetime(2026-01-01T00:00:00),"failure",
 datetime(2026-01-01T00:01:00),"failure",
 datetime(2026-01-01T00:01:00),"success",
 datetime(2026-01-01T00:01:00.0000001),"success"
] | extend Groups=dynamic(["NaN","inf","-inf","0.0"])
| mv-expand GroupText=Groups to typeof(string)
| extend Group=case(GroupText=="NaN",real(nan),GroupText=="inf",real(+inf),GroupText=="-inf",real(-inf),iff(Timestamp==datetime(2026-01-01),real(+0.0),real(-0.0)))
| project Timestamp,Marker,Group;
let specialized_1=() {
let FailedLogonBursts = () {
union (Events
| where Marker =~ "failure"
| project EventTime_1 = todatetime(["Timestamp"]), GroupGroup = ["Group"])
| where isnotnull(EventTime_1) and isnotempty(GroupGroup)
| distinct EventTime_1, GroupGroup
| project WindowStart = EventTime_1 - 5m, WindowEnd = EventTime_1, ["Group"] = GroupGroup
};
// Strict sequence: "failed-logon-bursts" -> "successful-logon". Total inclusive span: 3m.
union (FailedLogonBursts()
| extend EventTime_1 = todatetime(["WindowEnd"]), GroupGroup = ["Group"]
| extend SourceRule = "failed-logon-bursts"),
(Events
| where Marker =~ "success"
| extend EventTime_1 = todatetime(["Timestamp"]), GroupGroup = ["Group"]
| extend SourceRule = "successful-logon")
| where isnotnull(EventTime_1) and isnotempty(GroupGroup)
// Batch equal timestamps: simultaneous source matches cannot advance strict sequence positions.
| summarize HasFailedLogonBursts = countif(SourceRule == "failed-logon-bursts") > 0, HasSuccessfulLogon = countif(SourceRule == "successful-logon") > 0 by EventTime_1, GroupGroup
| sort by GroupGroup asc, EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1)) or (GroupGroup != prev(GroupGroup) and not(isnan(GroupGroup) and isnan(prev(GroupGroup))))
// Read preceding timestamp state for every assignment; preserve viable earlier prefixes.
| scan declare (LastFailedLogonBurstTime:datetime = datetime(null), CompleteNow:bool = false) with (
    step SequenceState: true =>
        CompleteNow = not(NewCorrelationGroup) and HasSuccessfulLogon and isnotnull(SequenceState.LastFailedLogonBurstTime) and SequenceState.LastFailedLogonBurstTime >= EventTime_1 - 3m,
        LastFailedLogonBurstTime = iff(HasFailedLogonBursts, EventTime_1, iff(NewCorrelationGroup, datetime(null), SequenceState.LastFailedLogonBurstTime));
)
| where CompleteNow
| project WindowStart = EventTime_1 - 3m, WindowEnd = EventTime_1, ["Group"] = GroupGroup, RuleCount = tolong(2)
};
