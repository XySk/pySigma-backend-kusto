let Actual=union (specialized_1() | project Plan="specialized_1",WindowStart,WindowEnd,Group=iff(Group==real(0),"0.0",tostring(Group)),RuleCount),(general_1() | project Plan="general_1",WindowStart,WindowEnd,Group=iff(Group==real(0),"0.0",tostring(Group)),RuleCount),(specialized_3() | project Plan="specialized_3",WindowStart,WindowEnd,Group=iff(Group==real(0),"0.0",tostring(Group)),RuleCount),(general_3() | project Plan="general_3",WindowStart,WindowEnd,Group=iff(Group==real(0),"0.0",tostring(Group)),RuleCount);
