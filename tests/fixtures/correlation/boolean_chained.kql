// Generated through SigmaCollection.from_yaml and KustoBackend.convert.
// Run the complete file. PASS = zero output rows (exact summary multiset).
// Runtime evidence and engine version: RUNTIME.md.
let Events = datatable(Timestamp:datetime, Case:string, Marker:string) [

    datetime(2026-01-01T12:00:00Z), "child", "A",
    datetime(2026-01-01T12:01:00Z), "child", "A",
    datetime(2026-01-01T12:02:00Z), "child", "B",
    datetime(2026-01-01T12:07:00Z), "child", "A",
    datetime(2026-01-01T12:07:00.0000001Z), "child", "A"

];
let Actual = () {
let _sigma_child_0 = () {
let SourceMatchArrivals = union (Events
| where Marker =~ "A"
| project EventTime_1 = todatetime(["Timestamp"]), GroupCase = ["Case"])
| where isnotnull(EventTime_1) and isnotempty(GroupCase)
| summarize SourceMatchCount = count() by EventTime_1, GroupCase;
union (SourceMatchArrivals
| project GroupCase, CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupCase, CountBoundaryTime = EventTime_1 + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupCase asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupCase != prev(GroupCase))
| where CountBoundaryOrder == 0
| where EventCount >= 1
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, ["Case"] = GroupCase, EventCount
};
union (_sigma_child_0()
| project EventTime_1 = todatetime(["WindowEnd"]), GroupCase = ["Case"], SourceRule = "child"),
(Events
| where Marker =~ "B"
| project EventTime_1 = todatetime(["Timestamp"]), GroupCase = ["Case"], SourceRule = "B")
| where isnotnull(EventTime_1) and isnotempty(GroupCase)
// Batch simultaneous source matches before updating inclusive trailing presence.
| summarize MatchesChild = countif(SourceRule == "child") > 0, MatchesB = countif(SourceRule == "B") > 0 by GroupCase, EventTime_1
| sort by GroupCase asc, EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1)) or GroupCase != prev(GroupCase)
| scan declare (LastChildTime:datetime, LastBTime:datetime) with (
    step PresenceWindow: true =>
        LastChildTime = iff(MatchesChild, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastChildTime)),
        LastBTime = iff(MatchesB, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastBTime));
)
// Only source-match timestamps evaluate; expiration never creates an anchor.
| extend HasChild = isnotnull(LastChildTime) and LastChildTime >= EventTime_1 - 5m, HasB = isnotnull(LastBTime) and LastBTime >= EventTime_1 - 5m
| extend RuleCount = tolong(HasChild) + tolong(HasB)
| where (HasChild and not(HasB))
| project WindowStart = EventTime_1 - 5m, WindowEnd = EventTime_1, ["Case"] = GroupCase, RuleCount
};
let Expected = datatable(WindowEnd:datetime, Case:string, RuleCount:long) [

    datetime(2026-01-01T12:00:00Z), "child", 1,
    datetime(2026-01-01T12:01:00Z), "child", 1,
    datetime(2026-01-01T12:07:00.0000001Z), "child", 1

]
| extend WindowStart = WindowEnd - 5m;
union (Actual() | extend Case=tostring(Case) | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Case, RuleCount
| where Delta != 0
