    datetime(2026-01-01T11:59:00Z), datetime(2026-01-01T12:01:00Z), "ten", "alice", 2
];
union (Actual() | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Case, Actor, EventCount
| where Delta != 0
