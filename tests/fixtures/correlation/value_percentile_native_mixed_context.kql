| extend HasContextEvidence = true)
| project ContextEventTime, ContextSourceRule, ContextGroupHost, ContextMeasurement, HasContextEvidence, ContextPartition = 1
) on ContextGroupHost
| where ContextEventTime between ((CompletionTime - 5m) .. CompletionTime));
let CompleteContextRelationships = materialize(WindowSourceMatches
| where HasContextEvidence
| project CorrelationMatchId_1, ContextMeasurement
| distinct *);
let ValuesForMeasurement = CompleteContextRelationships
| where isnotnull(ContextMeasurement)
| summarize by CorrelationMatchId_1, ContextMeasurement
| summarize DisplayedMeasurement = make_list(ContextMeasurement, 1000), DistinctMeasurementCount = count() by CorrelationMatchId_1;
CorrelationMatches
| join kind=leftouter (ValuesForMeasurement) on CorrelationMatchId_1
| extend ["Measurement"] = coalesce(DisplayedMeasurement, dynamic([]))
| extend ContextComplete = coalesce(DistinctMeasurementCount, 0) <= 1000
| project ["WindowStart"], ["WindowEnd"], ["Host"], ["Measurement"], ["ValuePercentile"], ["ContextComplete"]
};
