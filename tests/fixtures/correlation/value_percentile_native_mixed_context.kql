| extend ChildCorrelationMatch = strcat("Child", "_", tostring(["CorrelationMatchId"]))
| project EventTime_1 = todatetime(["WindowEnd"]), GroupHost = ["Host"], MeasuredMeasurement = ["ContextAmount"], ChildCorrelationMatch),
(Events
| where Marker =~ "direct"
| project EventTime_1 = todatetime(["Timestamp"]), GroupHost = ["Host"], MeasuredMeasurement = ["Size"])
| extend ChildCorrelationMatch = tostring(column_ifexists("ChildCorrelationMatch", "")));
let PercentileObservations = union (ParentSourceMatches | where isempty(ChildCorrelationMatch)), (ParentSourceMatches | where isnotempty(ChildCorrelationMatch) | extend RetainedNumericValue = MeasuredMeasurement | summarize take_any(*) by ChildCorrelationMatch, GroupHost, RetainedNumericValue)
| where isnotnull(EventTime_1) and isnotempty(GroupHost);
let PercentileWindowValues = materialize(
PercentileObservations
| project GroupHost, PercentileWindowEnd = EventTime_1, PercentileTimeBin = bin(EventTime_1, 5m)
| distinct *
| join kind=inner (
PercentileObservations
| where isnotnull(MeasuredMeasurement)
| extend PercentileTimeBin = pack_array(bin(EventTime_1, 5m), bin(EventTime_1, 5m) + 5m)
| mv-expand PercentileTimeBin to typeof(datetime)
) on GroupHost, PercentileTimeBin
| where EventTime_1 between ((PercentileWindowEnd - 5m) .. PercentileWindowEnd)
| project GroupHost, PercentileWindowEnd, MeasuredMeasurement
);
PercentileWindowValues
