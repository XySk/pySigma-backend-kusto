let Events=datatable(Timestamp:datetime,Host:string,Marker:string,User:string) [
datetime(2026-01-01T10:00:00Z), "h", "match", "a",
datetime(2026-01-01T10:01:00Z), "h", "match", "b",
datetime(2026-01-01T10:02:00Z), "h", "match", "c",
datetime(2026-01-01T10:08:00Z), "h", "success", "s"
];
let Expected=datatable(WindowEnd:datetime,Host:string,ValueCount:long) [datetime(2026-01-01T10:08:00Z), "h", 3] | extend WindowStart=WindowEnd-2m;
let Actual0 = () {
let ReportStart = datetime(2026-01-01T10:08:00.0000000Z);
let ReportEnd = datetime(2026-01-01T10:09:00.0000000Z);
let ContextSummary = () {
let SourceMatchArrivals = Events
| where Marker =~ "match"
| where ["Timestamp"] >= ReportStart - 720s and ["Timestamp"] < ReportEnd
| project EventTime_1 = ["Timestamp"], GroupHost = ["Host"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
| summarize SourceMatchCount = count() by EventTime_1, GroupHost;
union (SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime_1 + 3m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupHost asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupHost != prev(GroupHost))
| where CountBoundaryOrder == 0
| where EventCount >= 1
| project WindowStart = CountBoundaryTime - 3m, WindowEnd = CountBoundaryTime, ["Host"] = GroupHost, EventCount
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId = row_number());
let WindowSourceMatches =
CorrelationMatches | project CorrelationMatchId, CompletionTime = WindowEnd, ContextGroupHost = ["Host"], ContextPartition = 1
| join kind=inner (
Events
| where Marker =~ "match"
| where ["Timestamp"] >= ReportStart - 720s and ["Timestamp"] < ReportEnd
| extend ContextEventTime = ["Timestamp"], ContextGroupHost = ["Host"], ContextUser = ["User"]
| where isnotnull(ContextEventTime) and isnotempty(ContextGroupHost)
| extend ContextSourceRule = "source-rule"
| project ContextEventTime, ContextSourceRule, ContextGroupHost, ContextUser, ContextPartition = 1
) on ContextGroupHost
| where ContextEventTime between ((CompletionTime - 3m) .. CompletionTime);
let CompleteContextRelationships = materialize(WindowSourceMatches
| project CorrelationMatchId, ContextUser
| distinct *);
let ValuesForUser = CompleteContextRelationships
| where isnotnull(ContextUser)
| summarize by CorrelationMatchId, ContextUser
| summarize DisplayedUser = make_list(ContextUser, 1), DistinctUserCount = count() by CorrelationMatchId;
CorrelationMatches
| join kind=leftouter (ValuesForUser) on CorrelationMatchId
| extend ["User"] = coalesce(DisplayedUser, dynamic([]))
| extend ContextComplete = coalesce(DistinctUserCount, 0) <= 1
| project ["WindowStart"], ["WindowEnd"], ["Host"], ["User"], ["EventCount"], ["ContextComplete"]
| where WindowEnd >= ReportStart and WindowEnd < ReportEnd
| extend EventCount=EventCount+10
| where EventCount == 12
};
