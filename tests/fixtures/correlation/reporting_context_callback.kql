| extend ContextComplete = coalesce(DistinctUserCount, 0) <= 1
| project ["WindowStart"], ["WindowEnd"], ["Host"], ["User"], ["RuleCount"], ["ContextComplete"]
| where WindowEnd >= ReportStart_ and WindowEnd < ReportEnd_
};
