    CountedUserEnds = isnull(next(EventTime)) or GroupHost != next(GroupHost) or CountedUser != next(CountedUser) or next(EventTime) > EventTime + 2m);
union (ValueCountSources | summarize by GroupHost, EventTime
| project GroupHost, ValueBoundaryTime = EventTime, ValueBoundaryOrder = 1, CountedUserDelta = 0),
(CountedUserActivity | where CountedUserStarts
| project GroupHost, ValueBoundaryTime = EventTime, ValueBoundaryOrder = 0, CountedUserDelta = 1),
(CountedUserActivity | where CountedUserEnds
| project GroupHost, ValueBoundaryTime = EventTime + 2m, ValueBoundaryOrder = 2, CountedUserDelta = -1)
// All interval starts precede anchors; equal-time expirations follow them.
| sort by GroupHost asc, ValueBoundaryTime asc, ValueBoundaryOrder asc
| extend ValueCount = row_cumsum(CountedUserDelta, GroupHost != prev(GroupHost))
| where ValueBoundaryOrder == 1
| where ValueCount == 3
| project WindowStart = ValueBoundaryTime - 2m, WindowEnd = ValueBoundaryTime, ["Host"] = GroupHost, ValueCount
};
let _sigma_context_summaries = materialize(_sigma_context_summary()
| serialize _sigma_context_id_1 = row_number());
let _sigma_context_matches = materialize(
_sigma_context_summaries | project _sigma_context_id_1, _sigma_context_end = WindowEnd, _sigma_context_group = ["Host"], _sigma_context_partition = 1
| join kind=inner (
union (_sigma_shared_results_1
| where ["ContextRowKind_1"] == "ContextEvidence"
| extend _sigma_context_timestamp = todatetime(["WindowEnd"]), _sigma_context_group = ["Host"], _sigma_context_value_1 = tostring(pack_array(gettype(["_sigma_context_value"]), ["_sigma_context_value"])[1])
| extend _sigma_context_rule = "middle")
| project _sigma_context_timestamp, _sigma_context_rule, _sigma_context_group, _sigma_context_value_1, _sigma_context_partition = 1
) on _sigma_context_group
| where _sigma_context_timestamp between ((_sigma_context_end - 2m) .. _sigma_context_end)
| serialize _sigma_context_key = row_number());
let _sigma_context_rows = materialize(_sigma_context_matches
| project _sigma_context_id_1, _sigma_context_value_1
| distinct *);
let ContextValues = _sigma_context_rows
| where isnotnull(_sigma_context_value_1)
| summarize by _sigma_context_id_1, _sigma_context_value_1
| summarize DisplayedValues = make_list(_sigma_context_value_1, 1), DistinctValueCount = count() by _sigma_context_id_1;
_sigma_context_summaries
| join kind=leftouter (ContextValues) on _sigma_context_id_1
| extend ["User"] = coalesce(DisplayedValues, dynamic([]))
| extend ContextComplete = coalesce(DistinctValueCount, 0) <= 1
| project ["WindowStart"], ["WindowEnd"], ["Host"], ["User"], ["ValueCount"], ["ContextComplete"]
| where WindowEnd >= ReportStart__ and WindowEnd < ReportEnd__
};
let ChildRows=Actual0() | count;
let MiddleInvalid=Actual1() | where ContextComplete or array_length(User) != 1 | count;
union (Actual2() | project WindowStart,WindowEnd,Host,ValueCount | extend Host=tostring(Host) | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Host, ValueCount
| where Delta != 0
| union (ChildRows | where Count != 0 | project WindowStart=datetime(null), WindowEnd=datetime(null), Host="child-public", ValueCount=Count, Delta=long(1))
| union (MiddleInvalid | where Count != 0 | project WindowStart=datetime(null), WindowEnd=datetime(null), Host="middle-display", ValueCount=Count, Delta=long(1))
