let MiddleInvalid=Actual1() | summarize Rows=count(), Invalid=countif(ContextComplete or array_length(User) != 1 or WindowEnd != datetime(2026-01-01T10:08:00Z) or WindowStart != datetime(2026-01-01T10:01:00Z) or Host != "h" or RuleCount != 2);
