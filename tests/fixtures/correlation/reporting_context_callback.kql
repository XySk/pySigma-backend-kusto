let ChildResults = materialize(Child());
let ContextSummary = () {
// Strict sequence: "child" -> "success". Total inclusive span: 7m.
union (ChildResults
| where ["ContextRowKind"] == "Summary"
| extend EventTime_1 = ["WindowEnd"], GroupHost = ["Host"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
| extend SourceRule = "child"),
(Events
| where Marker =~ "success"
| where ["Timestamp"] >= ReportStart_ - 540s and ["Timestamp"] < ReportEnd_
| extend EventTime_1 = ["Timestamp"], GroupHost = ["Host"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
| extend SourceRule = "success")
// Batch equal timestamps: simultaneous source matches cannot advance strict sequence positions.
| summarize HasChild = countif(SourceRule == "child") > 0, HasSuccess = countif(SourceRule == "success") > 0 by EventTime_1, GroupHost
| sort by GroupHost asc, EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1)) or GroupHost != prev(GroupHost)
// Read preceding timestamp state for every assignment; preserve viable earlier prefixes.
| scan declare (LatestChildStart:datetime = datetime(null), CompleteNow:bool = false) with (
    step SequenceState: true =>
        CompleteNow = not(NewCorrelationGroup) and HasSuccess and isnotnull(SequenceState.LatestChildStart) and SequenceState.LatestChildStart >= EventTime_1 - 7m,
        LatestChildStart = iff(HasChild, EventTime_1, iff(NewCorrelationGroup, datetime(null), SequenceState.LatestChildStart));
)
| where CompleteNow
| project WindowStart = EventTime_1 - 7m, WindowEnd = EventTime_1, ["Host"] = GroupHost, RuleCount = tolong(2)
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId = row_number());
let WindowSourceMatches =
CorrelationMatches | project CorrelationMatchId, CompletionTime = WindowEnd, ContextGroupHost = ["Host"], ContextPartition = 1
| join kind=inner (
union (ChildResults | where ["ContextRowKind"] == "Summary"
| project-away ["ContextUser"]
| join kind=leftouter (ChildResults | where ["ContextRowKind"] == "ContextEvidence" | project ["CorrelationMatchId"], ["ContextUser"], HasContextEvidence = true) on ["CorrelationMatchId"]
| extend ContextEventTime = ["WindowEnd"], ContextGroupHost = ["Host"], ContextUser = ["ContextUser"]
| where isnotnull(ContextEventTime) and isnotempty(ContextGroupHost)
| extend ContextSourceRule = "child"),
((Events
| where Marker =~ "success"
| where ["Timestamp"] >= ReportStart_ - 540s and ["Timestamp"] < ReportEnd_
| extend ContextEventTime = ["Timestamp"], ContextGroupHost = ["Host"], ContextUser = ["User"]
| where isnotnull(ContextEventTime) and isnotempty(ContextGroupHost)
| extend ContextSourceRule = "success")
| extend HasContextEvidence = true)
| project ContextEventTime, ContextSourceRule, ContextGroupHost, ContextUser, HasContextEvidence, ContextPartition = 1
) on ContextGroupHost
| where ContextEventTime between ((CompletionTime - 7m) .. CompletionTime);
// Successful one/two-step completions need only endpoint participant filters.
let OrderedSourceRelationships = WindowSourceMatches
| where (ContextSourceRule == "child" and ContextEventTime < CompletionTime) or (ContextSourceRule == "success" and ContextEventTime == CompletionTime);
let CompleteContextRelationships = materialize(OrderedSourceRelationships
| where HasContextEvidence
| project CorrelationMatchId, ContextUser
| distinct *);
let ValuesForUser = CompleteContextRelationships
