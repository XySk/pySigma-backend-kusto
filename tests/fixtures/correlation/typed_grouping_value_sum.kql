let Events=datatable(Timestamp:datetime,Host:string,Marker:string,User:long,Server:string,Amount:long) [
 datetime(2026-01-01T12:00:00Z),"h","match",1,"server",2,
 datetime(2026-01-01T12:00:00Z),"h","match",1,"server",2,
 datetime(2026-01-01T12:00:00Z),"h","match",2,"server",3,
 datetime(null),"h","match",1,"server",100,
 datetime(2026-01-01T12:00:00Z),"h","match",long(null),"server",100,
 datetime(2026-01-01T12:00:00Z),"h","match",1,"",100
];
let Actual=(){
let SumObservations = union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]), GroupUser = ["User"], GroupServer = ["Server"], MeasuredAmount = ["Amount"])
| where isnotnull(EventTime_1) and isnotempty(GroupUser) and isnotempty(GroupServer);
let SumArrivals = SumObservations
| summarize ArrivalSum = sum(MeasuredAmount) by EventTime_1, GroupUser, GroupServer;
union (SumArrivals
| project GroupUser, GroupServer, SumBoundaryTime = EventTime_1, SumBoundaryOrder = 0, SumDelta = ArrivalSum),
(SumArrivals
| project GroupUser, GroupServer, SumBoundaryTime = EventTime_1 + 5m, SumBoundaryOrder = 1, SumDelta = -ArrivalSum)
// Arrivals evaluate before equal-time expirations, including zero and missing values.
| sort by GroupUser asc, GroupServer asc, SumBoundaryTime asc, SumBoundaryOrder asc
| extend ValueSum = row_cumsum(SumDelta, GroupUser != prev(GroupUser) or GroupServer != prev(GroupServer))
| where SumBoundaryOrder == 0
| where ValueSum >= 1
| project WindowStart = SumBoundaryTime - 5m, WindowEnd = SumBoundaryTime, ["User"] = GroupUser, ["Server"] = GroupServer, ValueSum
};
let Observed=Actual() | project WindowEnd,Kind=gettype(User),Value=tostring(User),Server=tostring(Server),Metric=toreal(ValueSum);
let Expected=datatable(WindowEnd:datetime,Kind:string,Value:string,Server:string,Metric:real) [
 datetime(2026-01-01T12:00:00Z),"long","1",'server',4,
 datetime(2026-01-01T12:00:00Z),"long","2",'server',3
];
union (Observed | extend Delta=1),(Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowEnd,Kind,Value,Server,Metric
| where Delta!=0
