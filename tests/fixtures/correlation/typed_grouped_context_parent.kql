let Events=datatable(Timestamp:datetime,Host:string,Region:string,Marker:string,User:string,Server:string) [
 datetime(2026-01-01T12:00:00Z),"one","east","match","Alice","server1",
 datetime(2026-01-01T12:00:00Z),"one","east","match","Bob","server2",
 datetime(2026-01-01T12:00:00Z),"two","east","match","Carol","server3",
 datetime(2026-01-01T12:00:00Z),"one","west","match","Dave","server4"
];
let Actual=(){
let Child = () {
let ContextSummary = () {
let SourceMatchArrivals = Events
| where Marker =~ "match"
| project EventTime_1 = ["Timestamp"], GroupHost = ["Host"], GroupRegion = ["Region"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost) and isnotempty(GroupRegion)
| summarize SourceMatchCount = count() by EventTime_1, GroupHost, GroupRegion;
union (SourceMatchArrivals
| project GroupHost, GroupRegion, CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupHost, GroupRegion, CountBoundaryTime = EventTime_1 + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupHost asc, GroupRegion asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupHost != prev(GroupHost) or GroupRegion != prev(GroupRegion))
| where CountBoundaryOrder == 0
| where EventCount >= 1
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, ["Host"] = GroupHost, ["Region"] = GroupRegion, EventCount
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId = row_number());
let WindowSourceMatches =
CorrelationMatches | project CorrelationMatchId, CompletionTime = WindowEnd, ContextGroupHost = ["Host"], ContextGroupRegion = ["Region"], ContextPartition = 1
| join kind=inner (
Events
| where Marker =~ "match"
| extend ContextEventTime = ["Timestamp"], ContextGroupHost = ["Host"], ContextGroupRegion = ["Region"], ContextUser = ["User"], ContextServer = ["Server"]
| where isnotnull(ContextEventTime) and isnotempty(ContextGroupHost) and isnotempty(ContextGroupRegion)
| extend ContextSourceRule = "source-rule"
| project ContextEventTime, ContextSourceRule, ContextGroupHost, ContextGroupRegion, ContextUser, ContextServer, ContextPartition = 1
) on ContextGroupHost, ContextGroupRegion
| where ContextEventTime between ((CompletionTime - 5m) .. CompletionTime);
let CompleteContextRelationships = materialize(WindowSourceMatches
| project CorrelationMatchId, ContextUser, ContextServer
| distinct *);
union (CorrelationMatches | extend ContextRowKind = "Summary"), (CorrelationMatches | join kind=inner (CompleteContextRelationships) on CorrelationMatchId | extend ContextRowKind = "ContextEvidence")
};
let ChildResults = materialize(Child());
let ParentSourceMatches = materialize(ChildResults
| where ["ContextRowKind"] == "ContextEvidence"
| extend ChildCorrelationMatch = strcat("Child", "_", tostring(["CorrelationMatchId"]))
| project EventTime = ["WindowEnd"], GroupHost = ["Host"], GroupRegion = ["Region"], GroupUser = ["ContextUser"], GroupServer = ["ContextServer"], ChildCorrelationMatch
| where isnotnull(EventTime) and isnotempty(GroupHost) and isnotempty(GroupRegion) and isnotempty(GroupUser) and isnotempty(GroupServer)
| extend ChildCorrelationMatch = tostring(column_ifexists("ChildCorrelationMatch", "")));
let SourceMatchArrivals = union (ParentSourceMatches | where isempty(ChildCorrelationMatch)), (ParentSourceMatches | where isnotempty(ChildCorrelationMatch) | summarize take_any(*) by ChildCorrelationMatch, GroupHost, GroupRegion, GroupUser, GroupServer)
| summarize SourceMatchCount = count() by EventTime, GroupHost, GroupRegion, GroupUser, GroupServer;
union (SourceMatchArrivals
| project GroupHost, GroupRegion, GroupUser, GroupServer, CountBoundaryTime = EventTime, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupHost, GroupRegion, GroupUser, GroupServer, CountBoundaryTime = EventTime + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupHost asc, GroupRegion asc, GroupUser asc, GroupServer asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupHost != prev(GroupHost) or GroupRegion != prev(GroupRegion) or GroupUser != prev(GroupUser) or GroupServer != prev(GroupServer))
| where CountBoundaryOrder == 0
| where EventCount >= 1
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, ["Host"] = GroupHost, ["Region"] = GroupRegion, ["User"] = GroupUser, ["Server"] = GroupServer, EventCount
| extend ContextComplete = true
};
let Observed=Actual() | project WindowEnd,Kind=gettype(Host),Host=tostring(Host),Region=tostring(Region),
 User=tostring(User),Server=tostring(Server),EventCount;
let Expected=datatable(WindowEnd:datetime,Kind:string,Host:string,Region:string,User:string,Server:string,EventCount:long) [
 datetime(2026-01-01T12:00:00Z),"string","one","east","Alice","server1",1,
 datetime(2026-01-01T12:00:00Z),"string","one","east","Bob","server2",1,
 datetime(2026-01-01T12:00:00Z),"string","two","east","Carol","server3",1,
 datetime(2026-01-01T12:00:00Z),"string","one","west","Dave","server4",1
];
union (Observed | extend Delta=1),(Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowEnd,Kind,Host,Region,User,Server,EventCount
| where Delta!=0
