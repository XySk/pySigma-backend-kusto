let Events=datatable(Timestamp:datetime,Host:string,Marker:string,User:dynamic,Server:string) [
 datetime(2026-01-01T12:00:00Z),"h","match",dynamic("Alice"),"server1",
 datetime(2026-01-01T12:00:00Z),"h","match",dynamic("Bob"),"server2",
 datetime(2026-01-01T12:00:00Z),"h","match",dynamic("Alice"),"server1",
 datetime(2026-01-01T12:00:00Z),"h2","match",dynamic("Alice"),"server1",
 datetime(2026-01-01T12:00:00Z),"d","direct",dynamic("Alice"),"server1"
]
// Normalize Events scalar fixture inputs explicitly.
| extend User=tostring(User);
let Actual=(){
let Child = () {
let ContextSummary = () {
let SourceMatchArrivals = union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]), GroupHost = ["Host"])
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
| summarize SourceMatchCount = count() by EventTime_1, GroupHost;
union (SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime_1 + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupHost asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupHost != prev(GroupHost))
| where CountBoundaryOrder == 0
| where EventCount >= 1
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, ["Host"] = GroupHost, EventCount
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId = row_number());
let WindowSourceMatches = materialize(
CorrelationMatches | project CorrelationMatchId, CompletionTime = WindowEnd, ContextGroupHost = ["Host"], ContextPartition = 1
| join kind=inner (
union (Events
| where Marker =~ "match"
| extend ContextEventTime = todatetime(["Timestamp"]), ContextGroupHost = ["Host"], ContextUser = ["User"], ContextServer = ["Server"]
| extend ContextSourceRule = "source-rule")
| project ContextEventTime, ContextSourceRule, ContextGroupHost, ContextUser, ContextServer, ContextPartition = 1
) on ContextGroupHost
| where ContextEventTime between ((CompletionTime - 5m) .. CompletionTime));
let CompleteContextRelationships = materialize(WindowSourceMatches
| project CorrelationMatchId, ContextUser, ContextServer
| distinct *);
union (CorrelationMatches | extend ContextRowKind = "Summary"), (CorrelationMatches | join kind=inner (CompleteContextRelationships) on CorrelationMatchId | extend ContextRowKind = "ContextEvidence")
};
let ChildResults = materialize(Child());
let ContextSummary = () {
let ValueCountSources = materialize(union (ChildResults | where ["ContextRowKind"] == "Summary"
| project-away ["ContextUser"], ["ContextServer"]
| join kind=leftouter (ChildResults | where ["ContextRowKind"] == "ContextEvidence" | project ["CorrelationMatchId"], ["ContextUser"], ["ContextServer"]) on ["CorrelationMatchId"]
| project EventTime = todatetime(["WindowEnd"]), CountedUser = ["ContextUser"])
| where isnotnull(EventTime));
let CountedUserActivity = materialize(ValueCountSources
| where isnotempty(CountedUser)
| summarize by CountedUser, EventTime
| sort by CountedUser asc, EventTime asc
// Repeated values whose inclusive active intervals overlap contribute only once.
| extend CountedUserStarts = isnull(prev(EventTime)) or CountedUser != prev(CountedUser) or EventTime > prev(EventTime) + 5m,
    CountedUserEnds = isnull(next(EventTime)) or CountedUser != next(CountedUser) or next(EventTime) > EventTime + 5m);
union (ValueCountSources | summarize by EventTime
| project ValueBoundaryTime = EventTime, ValueBoundaryOrder = 1, CountedUserDelta = 0),
(CountedUserActivity | where CountedUserStarts
| project ValueBoundaryTime = EventTime, ValueBoundaryOrder = 0, CountedUserDelta = 1),
(CountedUserActivity | where CountedUserEnds
| project ValueBoundaryTime = EventTime + 5m, ValueBoundaryOrder = 2, CountedUserDelta = -1)
// All interval starts precede anchors; equal-time expirations follow them.
| sort by ValueBoundaryTime asc, ValueBoundaryOrder asc
| extend ValueCount = row_cumsum(CountedUserDelta)
| where ValueBoundaryOrder == 1
| where ValueCount >= 1
| project WindowStart = ValueBoundaryTime - 5m, WindowEnd = ValueBoundaryTime, ValueCount
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId_1 = row_number());
let WindowSourceMatches = materialize(
CorrelationMatches | project CorrelationMatchId_1, CompletionTime = WindowEnd, ContextPartition = 1
| join kind=inner (
union (ChildResults | where ["ContextRowKind"] == "Summary"
| project-away ["ContextUser"], ["ContextServer"]
| join kind=leftouter (ChildResults | where ["ContextRowKind"] == "ContextEvidence" | project ["CorrelationMatchId"], ["ContextUser"], ["ContextServer"], HasContextEvidence = true) on ["CorrelationMatchId"]
| extend ContextEventTime = todatetime(["WindowEnd"]), ContextUser_1 = ["ContextUser"], ContextServer_1 = ["ContextServer"]
| extend ContextSourceRule = "child")
| project ContextEventTime, ContextSourceRule, ContextUser_1, ContextServer_1, HasContextEvidence, ContextPartition = 1
) on ContextPartition
| where ContextEventTime between ((CompletionTime - 5m) .. CompletionTime));
let CompleteContextRelationships = materialize(WindowSourceMatches
| where HasContextEvidence
| project CorrelationMatchId_1, ContextUser_1, ContextServer_1
| distinct *);
let ValuesForUser = CompleteContextRelationships
| where isnotnull(ContextUser_1)
| summarize by CorrelationMatchId_1, ContextUser_1
| summarize DisplayedUser = make_list(ContextUser_1, 1000), DistinctUserCount = count() by CorrelationMatchId_1;
let ValuesForServer = CompleteContextRelationships
| where isnotnull(ContextServer_1)
| summarize by CorrelationMatchId_1, ContextServer_1
| summarize DisplayedServer = make_list(ContextServer_1, 1000), DistinctServerCount = count() by CorrelationMatchId_1;
CorrelationMatches
| join kind=leftouter (ValuesForUser) on CorrelationMatchId_1
| extend ["User"] = coalesce(DisplayedUser, dynamic([]))
| join kind=leftouter (ValuesForServer) on CorrelationMatchId_1
| extend ["Server"] = coalesce(DisplayedServer, dynamic([]))
| extend ContextComplete = coalesce(DistinctUserCount, 0) <= 1000 and coalesce(DistinctServerCount, 0) <= 1000
| project ["WindowStart"], ["WindowEnd"], ["User"], ["Server"], ["ValueCount"], ["ContextComplete"]
};
let Observed=Actual() | project WindowEnd, Metric=ValueCount | project WindowEnd, Metric;
let Expected=datatable(WindowEnd:datetime, Metric:long) [datetime(2026-01-01T12:00:00Z),2] | project WindowEnd, Metric;
union (Observed | extend Delta=1), (Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowEnd, Metric
| where Delta!=0
