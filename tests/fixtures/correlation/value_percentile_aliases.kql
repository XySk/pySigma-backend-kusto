let Events = datatable(Timestamp:datetime, Host:string, Low:long, Marker:string) [
datetime(2026-01-01T12:00:00Z), "alice", 1, "a"
];
let NetworkEvents = datatable(Timestamp:datetime, Account:string, High:long, Marker:string) [
datetime(2026-01-01T12:00:00Z), "alice", 100, "b",
datetime(2026-01-01T12:00:00Z), "alice", 200, "b",
datetime(2026-01-01T12:01:00Z), "alice", 300, "b"
];
let Actual = () {
let _sigma_values = union (Events
| where Marker =~ "a"
| extend _sigma_timestamp = todatetime(["Timestamp"]), _sigma_group_0 = ["Host"], _sigma_value = pack_array(gettype(["Low"]), ["Low"])
| extend _sigma_rule = "first"),
(Events
| where Marker =~ "a"
| extend _sigma_timestamp = todatetime(["Timestamp"]), _sigma_group_0 = ["Host"], _sigma_value = pack_array(gettype(["Low"]), ["Low"])
| extend _sigma_rule = "first"),
(NetworkEvents
| where Marker =~ "b"
| extend _sigma_timestamp = todatetime(["Timestamp"]), _sigma_group_0 = ["Account"], _sigma_value = pack_array(gettype(["High"]), ["High"])
| extend _sigma_rule = "second")
| where isnotnull(_sigma_timestamp) and isnotempty(_sigma_group_0);
let _sigma_ranked = materialize(
_sigma_values
| project _sigma_group_0, _sigma_window_end = _sigma_timestamp, _sigma_bin = bin(_sigma_timestamp, 5m)
| distinct *
| join kind=inner (
_sigma_values
| extend _sigma_bin = pack_array(bin(_sigma_timestamp, 5m), bin(_sigma_timestamp, 5m) + 5m)
| mv-expand _sigma_bin to typeof(datetime)
) on _sigma_group_0, _sigma_bin
| where _sigma_timestamp between ((_sigma_window_end - 5m) .. _sigma_window_end)
| where tostring(_sigma_value[0]) in ("int", "long", "real", "double", "decimal") and isfinite(toreal(_sigma_value[1]))
| extend _sigma_partition = tostring(pack_array(_sigma_window_end, _sigma_group_0)), _sigma_numeric = toreal(_sigma_value[1]), _sigma_precise = todecimal(_sigma_value[1])
| sort by _sigma_partition asc, _sigma_numeric asc, _sigma_precise asc
| serialize _sigma_rank = row_number(1, _sigma_partition != prev(_sigma_partition))
);
_sigma_ranked
| join kind=inner (
_sigma_ranked | summarize _sigma_population = max(_sigma_rank) by _sigma_partition
) on _sigma_partition
| where _sigma_rank == max_of(1, (_sigma_population / 100) * 50 + tolong(ceiling(toreal((_sigma_population % 100) * 50) / 100.0)))
| extend ValuePercentile = tolong(_sigma_value[1])
| where (gettype(ValuePercentile) in ("int", "long") and todecimal(ValuePercentile) >= decimal(0)) or (gettype(ValuePercentile) in ("real", "double", "decimal") and toreal(ValuePercentile) >= 0)
| project WindowStart = _sigma_window_end - 5m, WindowEnd = _sigma_window_end, ["Actor"] = _sigma_group_0, ValuePercentile
};
let Expected = datatable(WindowStart:datetime, WindowEnd:datetime, Actor:string, ValuePercentile:long) [
datetime(2026-01-01T11:55:00Z), datetime(2026-01-01T12:00:00Z), "alice", 1,
datetime(2026-01-01T11:56:00Z), datetime(2026-01-01T12:01:00Z), "alice", 100
];
union (Actual() | project WindowStart, WindowEnd, Actor, ValuePercentile=tolong(ValuePercentile) | extend Actor=tostring(Actor) | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Actor, ValuePercentile
| where Delta != 0
