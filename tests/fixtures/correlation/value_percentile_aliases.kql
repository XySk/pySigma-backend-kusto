// Nonempty rows identify a missing, additional, or duplicated summary.
let Events = datatable(Timestamp:datetime, Host:string, Low:long, Marker:string) [
datetime(2026-01-01T12:00:00Z), "alice", 1, "a"
];
let NetworkEvents = datatable(Timestamp:datetime, Account:string, High:long, Marker:string) [
datetime(2026-01-01T12:00:00Z), "alice", 100, "b",
datetime(2026-01-01T12:00:00Z), "alice", 200, "b",
datetime(2026-01-01T12:01:00Z), "alice", 300, "b"
];
let Actual = () {
let PercentileObservations = union (Events
| where Marker =~ "a"
| project EventTime_1 = todatetime(["Timestamp"]), GroupActor = ["Host"], MeasuredMeasurement = ["Low"]),
(Events
| where Marker =~ "a"
| project EventTime_1 = todatetime(["Timestamp"]), GroupActor = ["Host"], MeasuredMeasurement = ["Low"]),
(NetworkEvents
| where Marker =~ "b"
| project EventTime_1 = todatetime(["Timestamp"]), GroupActor = ["Account"], MeasuredMeasurement = ["High"])
| where isnotnull(EventTime_1) and isnotempty(GroupActor);
let PercentileWindowValues = materialize(
PercentileObservations
| project GroupActor, PercentileWindowEnd = EventTime_1, PercentileTimeBin = bin(EventTime_1, 5m)
| distinct *
| join kind=inner (
PercentileObservations
| where isnotnull(MeasuredMeasurement)
| extend PercentileTimeBin = pack_array(bin(EventTime_1, 5m), bin(EventTime_1, 5m) + 5m)
| mv-expand PercentileTimeBin to typeof(datetime)
) on GroupActor, PercentileTimeBin
| where EventTime_1 between ((PercentileWindowEnd - 5m) .. PercentileWindowEnd)
| project GroupActor, PercentileWindowEnd, MeasuredMeasurement
);
PercentileWindowValues
| join kind=inner (
PercentileWindowValues | summarize PercentilePopulation = count() by GroupActor, PercentileWindowEnd
) on GroupActor, PercentileWindowEnd
| project GroupActor, PercentileWindowEnd, MeasuredMeasurement, PercentilePopulation
| sort by GroupActor asc, PercentileWindowEnd asc, MeasuredMeasurement asc
| serialize PercentileRank = row_number(1, GroupActor != prev(GroupActor) or PercentileWindowEnd != prev(PercentileWindowEnd))
| where PercentileRank == max_of(1, (PercentilePopulation / 100) * 50 + tolong(ceiling(toreal((PercentilePopulation % 100) * 50) / 100.0)))
| extend ValuePercentile = MeasuredMeasurement
| where ValuePercentile >= 0
| project WindowStart = PercentileWindowEnd - 5m, WindowEnd = PercentileWindowEnd, ["Actor"] = GroupActor, ValuePercentile
};
let Expected = datatable(WindowStart:datetime, WindowEnd:datetime, Actor:string, ValuePercentile:long) [
datetime(2026-01-01T11:55:00Z), datetime(2026-01-01T12:00:00Z), "alice", 1,
datetime(2026-01-01T11:56:00Z), datetime(2026-01-01T12:01:00Z), "alice", 100
];
union (Actual() | project WindowStart, WindowEnd, Actor, ValuePercentile=tolong(ValuePercentile) | extend Actor=tostring(Actor) | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Actor, ValuePercentile
| where Delta != 0
