let Events=datatable(Timestamp:datetime,Host:string,Region:string,Marker:string,User:string,Server:string) [
 datetime(2026-01-01T12:00:00Z),"one","east","match","Alice","server1",
 datetime(2026-01-01T12:00:00Z),"one","east","match","Bob","server2",
 datetime(2026-01-01T12:00:00Z),"two","east","match","Carol","server3",
 datetime(2026-01-01T12:00:00Z),"one","west","match","Dave","server4"
];
let Actual=(){
let ContextSummary = () {
let SourceMatchArrivals = union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]), GroupHost = ["Host"], GroupRegion = ["Region"])
| where isnotnull(EventTime_1) and isnotempty(GroupHost) and isnotempty(GroupRegion)
| summarize SourceMatchCount = count() by EventTime_1, GroupHost, GroupRegion;
union (SourceMatchArrivals
| project GroupHost, GroupRegion, CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupHost, GroupRegion, CountBoundaryTime = EventTime_1 + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupHost asc, GroupRegion asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupHost != prev(GroupHost) or GroupRegion != prev(GroupRegion))
| where CountBoundaryOrder == 0
| where EventCount >= 1
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, ["Host"] = GroupHost, ["Region"] = GroupRegion, EventCount
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId = row_number());
let WindowSourceMatches = materialize(
CorrelationMatches | project CorrelationMatchId, CompletionTime = WindowEnd, ContextGroupHost = ["Host"], ContextGroupRegion = ["Region"], ContextPartition = 1
| join kind=inner (
union (Events
| where Marker =~ "match"
| extend ContextEventTime = todatetime(["Timestamp"]), ContextGroupHost = ["Host"], ContextGroupRegion = ["Region"], ContextUser = ["User"], ContextServer = ["Server"]
| extend ContextSourceRule = "source-rule")
| project ContextEventTime, ContextSourceRule, ContextGroupHost, ContextGroupRegion, ContextUser, ContextServer, ContextPartition = 1
) on ContextGroupHost, ContextGroupRegion
| where ContextEventTime between ((CompletionTime - 5m) .. CompletionTime));
let CompleteContextRelationships = materialize(WindowSourceMatches
| project CorrelationMatchId, ContextUser, ContextServer
| distinct *);
let ValuesForUser = CompleteContextRelationships
| where isnotnull(ContextUser)
| summarize by CorrelationMatchId, ContextUser
| summarize DisplayedUser = make_list(ContextUser, 1000), DistinctUserCount = count() by CorrelationMatchId;
let ValuesForServer = CompleteContextRelationships
| where isnotnull(ContextServer)
| summarize by CorrelationMatchId, ContextServer
| summarize DisplayedServer = make_list(ContextServer, 1000), DistinctServerCount = count() by CorrelationMatchId;
CorrelationMatches
| join kind=leftouter (ValuesForUser) on CorrelationMatchId
| extend ["User"] = coalesce(DisplayedUser, dynamic([]))
| join kind=leftouter (ValuesForServer) on CorrelationMatchId
| extend ["Server"] = coalesce(DisplayedServer, dynamic([]))
| extend ContextComplete = coalesce(DistinctUserCount, 0) <= 1000 and coalesce(DistinctServerCount, 0) <= 1000
| project ["WindowStart"], ["WindowEnd"], ["Host"], ["Region"], ["User"], ["Server"], ["EventCount"], ["ContextComplete"]
};
let Observed=Actual() | project WindowEnd,Kind=gettype(Host),Host=tostring(Host),Region=tostring(Region),EventCount,
 Users=tostring(array_sort_asc(User)),Servers=tostring(array_sort_asc(Server));
let Expected=datatable(WindowEnd:datetime,Kind:string,Host:string,Region:string,EventCount:long,Users:string,Servers:string) [
 datetime(2026-01-01T12:00:00Z),"string","one","east",2,'["Alice","Bob"]','["server1","server2"]',
 datetime(2026-01-01T12:00:00Z),"string","two","east",1,'["Carol"]','["server3"]',
 datetime(2026-01-01T12:00:00Z),"string","one","west",1,'["Dave"]','["server4"]'
];
union (Observed | extend Delta=1),(Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowEnd,Kind,Host,Region,EventCount,Users,Servers
| where Delta!=0
