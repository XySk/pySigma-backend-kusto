let Events=datatable(Timestamp:datetime,Host:string,Marker:string,User:long,Server:string,Amount:long) [
 datetime(2026-01-01T12:00:00Z),"h","match",1,"server",2,
 datetime(2026-01-01T12:00:00Z),"h","match",1,"server",2,
 datetime(2026-01-01T12:00:00Z),"h","match",2,"server",3,
 datetime(null),"h","match",1,"server",100,
 datetime(2026-01-01T12:00:00Z),"h","match",long(null),"server",100,
 datetime(2026-01-01T12:00:00Z),"h","match",1,"",100
];
let Actual=(){
let PercentileObservations = union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]), GroupUser = ["User"], GroupServer = ["Server"], MeasuredAmount = ["Amount"])
| where isnotnull(EventTime_1) and isnotempty(GroupUser) and isnotempty(GroupServer);
let PercentileWindowValues = materialize(
PercentileObservations
| project GroupUser, GroupServer, PercentileWindowEnd = EventTime_1, PercentileTimeBin = bin(EventTime_1, 5m)
| distinct *
| join kind=inner (
PercentileObservations
| where isnotnull(MeasuredAmount)
| extend PercentileTimeBin = pack_array(bin(EventTime_1, 5m), bin(EventTime_1, 5m) + 5m)
| mv-expand PercentileTimeBin to typeof(datetime)
) on GroupUser, GroupServer, PercentileTimeBin
| where EventTime_1 between ((PercentileWindowEnd - 5m) .. PercentileWindowEnd)
| project GroupUser, GroupServer, PercentileWindowEnd, MeasuredAmount
);
PercentileWindowValues
| join kind=inner (
PercentileWindowValues | summarize PercentilePopulation = count() by GroupUser, GroupServer, PercentileWindowEnd
) on GroupUser, GroupServer, PercentileWindowEnd
| project GroupUser, GroupServer, PercentileWindowEnd, MeasuredAmount, PercentilePopulation
| sort by GroupUser asc, GroupServer asc, PercentileWindowEnd asc, MeasuredAmount asc
| serialize PercentileRank = row_number(1, GroupUser != prev(GroupUser) or GroupServer != prev(GroupServer) or PercentileWindowEnd != prev(PercentileWindowEnd))
| where PercentileRank == max_of(1, (PercentilePopulation / 100) * 50 + tolong(ceiling(toreal((PercentilePopulation % 100) * 50) / 100.0)))
| extend ValuePercentile = MeasuredAmount
| where ValuePercentile >= 1
| project WindowStart = PercentileWindowEnd - 5m, WindowEnd = PercentileWindowEnd, ["User"] = GroupUser, ["Server"] = GroupServer, ValuePercentile
};
let Observed=Actual() | project WindowEnd,Kind=gettype(User),Value=tostring(User),Server=tostring(Server),Metric=toreal(ValuePercentile);
let Expected=datatable(WindowEnd:datetime,Kind:string,Value:string,Server:string,Metric:real) [
 datetime(2026-01-01T12:00:00Z),"long","1",'server',2,
 datetime(2026-01-01T12:00:00Z),"long","2",'server',3
];
union (Observed | extend Delta=1),(Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowEnd,Kind,Value,Server,Metric
| where Delta!=0
