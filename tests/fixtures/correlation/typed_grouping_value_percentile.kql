let Events=datatable(Timestamp:datetime,Host:string,Marker:string,User:dynamic,Server:dynamic,Amount:long) [
 datetime(2026-01-01T12:00:00Z),"h","match",dynamic(1),dynamic({"x":[1,"a"]}),2,
 datetime(2026-01-01T12:00:00Z),"h","match",dynamic(1),dynamic({"x":[1,"a"]}),2,
 datetime(2026-01-01T12:00:00Z),"h","match",dynamic("1"),dynamic({"x":[1,"a"]}),3,
 datetime(null),"h","match",dynamic(1),dynamic({"x":[1,"a"]}),100,
 datetime(2026-01-01T12:00:00Z),"h","match",dynamic(null),dynamic({"x":[1,"a"]}),100,
 datetime(2026-01-01T12:00:00Z),"h","match",dynamic(""),dynamic({"x":[1,"a"]}),100
];
let Actual=(){
let _sigma_group_input = materialize(union (Events
| where Marker =~ "match"
| extend _sigma_timestamp = todatetime(["Timestamp"]), _sigma_group_0 = pack_array(gettype(["User"]), ["User"]), _sigma_group_1 = pack_array(gettype(["Server"]), ["Server"]), _sigma_value = pack_array(gettype(["Amount"]), ["Amount"])
| extend _sigma_rule = "source-rule")
| where isnotempty(tostring(_sigma_group_0[1])) and isnotempty(tostring(_sigma_group_1[1]))
| extend _sigma_group_tuple = pack_array("array", pack_array(_sigma_group_0, _sigma_group_1))
| serialize _sigma_group_row = row_number());
let _sigma_group_components = materialize(_sigma_group_input
| mv-expand with_itemindex=_sigma_group_component _sigma_group_box = pack_array(_sigma_group_tuple)
| where _sigma_group_component == 0 or isnotempty(tostring(_sigma_group_box[1]))
| serialize _sigma_group_component_id = row_number());
let _sigma_identity_input = materialize(_sigma_group_components
| project _sigma_group_component_id, _sigma_group_component, _sigma_identity_leaf = _sigma_group_box[1]
| extend _sigma_identity_bound = 3 * strlen(dynamic_to_json(_sigma_identity_leaf)) + 3);
let _sigma_identity_steps = materialize(_sigma_identity_input
| where assert(toscalar(_sigma_identity_input | summarize coalesce(max(_sigma_identity_bound), 0)) <= 1048575, 'Kusto dynamic identity traversal exceeds range limit')
| mv-expand _sigma_identity_iteration = range(0, _sigma_identity_bound, 1) to typeof(long)
| sort by _sigma_group_component_id asc, _sigma_identity_iteration asc
| scan declare (_sigma_identity_stack:dynamic = dynamic([])) with (step s: true => _sigma_identity_stack = case(
    _sigma_identity_iteration == 0, pack_array(bag_pack('v', _sigma_identity_leaf, 'p', '$', 'i', 0, 'k', bag_keys(_sigma_identity_leaf))),
    array_length(s._sigma_identity_stack) == 0, s._sigma_identity_stack,
    gettype(s._sigma_identity_stack[-1].v) == 'dictionary' and tolong(s._sigma_identity_stack[-1].i) < array_length(s._sigma_identity_stack[-1].k), array_concat(array_slice(s._sigma_identity_stack, 0, -2), pack_array(bag_pack('v', s._sigma_identity_stack[-1].v, 'p', s._sigma_identity_stack[-1].p, 'i', tolong(s._sigma_identity_stack[-1].i) + 1, 'k', s._sigma_identity_stack[-1].k)), pack_array(bag_pack('v', s._sigma_identity_stack[-1].v[tostring(s._sigma_identity_stack[-1].k[tolong(s._sigma_identity_stack[-1].i)])], 'p', strcat(tostring(s._sigma_identity_stack[-1].p), 'k', dynamic_to_json(pack_array(s._sigma_identity_stack[-1].k[tolong(s._sigma_identity_stack[-1].i)]))), 'i', 0, 'k', bag_keys(s._sigma_identity_stack[-1].v[tostring(s._sigma_identity_stack[-1].k[tolong(s._sigma_identity_stack[-1].i)])])))),
    gettype(s._sigma_identity_stack[-1].v) == 'array' and tolong(s._sigma_identity_stack[-1].i) < array_length(s._sigma_identity_stack[-1].v), array_concat(array_slice(s._sigma_identity_stack, 0, -2), pack_array(bag_pack('v', s._sigma_identity_stack[-1].v, 'p', s._sigma_identity_stack[-1].p, 'i', tolong(s._sigma_identity_stack[-1].i) + 1, 'k', s._sigma_identity_stack[-1].k)), pack_array(bag_pack('v', s._sigma_identity_stack[-1].v[tolong(s._sigma_identity_stack[-1].i)], 'p', strcat(tostring(s._sigma_identity_stack[-1].p), 'a', tostring(s._sigma_identity_stack[-1].i), ';'), 'i', 0, 'k', bag_keys(s._sigma_identity_stack[-1].v[tolong(s._sigma_identity_stack[-1].i)])))),
    array_slice(s._sigma_identity_stack, 0, -2));)
| extend _sigma_identity_frame = _sigma_identity_stack[-1]
| extend _sigma_identity_type = gettype(_sigma_identity_frame.v), _sigma_identity_terminal = _sigma_identity_iteration == _sigma_identity_bound, _sigma_identity_finished = array_length(_sigma_identity_stack) == 0
| where _sigma_identity_terminal or (not(_sigma_identity_finished) and (_sigma_identity_type !in ('array', 'dictionary') or (_sigma_identity_type == 'array' and array_length(_sigma_identity_frame.v) == 0) or (_sigma_identity_type == 'dictionary' and array_length(bag_keys(_sigma_identity_frame.v)) == 0)))
| project _sigma_group_component_id, _sigma_group_component, _sigma_identity_path = tostring(_sigma_identity_frame.p), _sigma_identity_type, _sigma_identity_leaf = _sigma_identity_frame.v, _sigma_identity_terminal, _sigma_identity_finished);
let _sigma_identity_leaves = _sigma_identity_steps
| where assert(toscalar(_sigma_identity_steps | summarize countif(_sigma_identity_terminal and not(_sigma_identity_finished))) == 0, 'Kusto dynamic identity traversal incomplete')
| where not(_sigma_identity_terminal);
let _sigma_identity_counts = _sigma_identity_leaves | summarize _sigma_identity_count = count() by _sigma_group_component_id;
let _sigma_identity_relation = _sigma_identity_leaves
| join kind=inner (_sigma_identity_leaves | project _sigma_group_component, _sigma_identity_path, _sigma_identity_type, _sigma_identity_other_id = _sigma_group_component_id, _sigma_identity_other_leaf = _sigma_identity_leaf) on _sigma_group_component, _sigma_identity_path, _sigma_identity_type
| where case(_sigma_identity_type == 'double', (toreal(_sigma_identity_leaf) == toreal(_sigma_identity_other_leaf) or (isnan(toreal(_sigma_identity_leaf)) and isnan(toreal(_sigma_identity_other_leaf)))), _sigma_identity_type == 'long', tolong(_sigma_identity_leaf) == tolong(_sigma_identity_other_leaf), _sigma_identity_type == 'decimal', todecimal(_sigma_identity_leaf) == todecimal(_sigma_identity_other_leaf), tostring(_sigma_identity_leaf) == tostring(_sigma_identity_other_leaf))
| summarize _sigma_identity_hits = count() by _sigma_group_component_id, _sigma_identity_other_id
| join kind=inner (_sigma_identity_counts) on _sigma_group_component_id
| join kind=inner (_sigma_identity_counts | project _sigma_identity_other_id = _sigma_group_component_id, _sigma_identity_other_count = _sigma_identity_count) on _sigma_identity_other_id
| where _sigma_identity_hits == _sigma_identity_count and _sigma_identity_hits == _sigma_identity_other_count
| summarize _sigma_identity_identity = min(_sigma_identity_other_id) by _sigma_group_component_id;
let _sigma_group_identity_cache = materialize(_sigma_group_components | join kind=inner (_sigma_identity_relation) on _sigma_group_component_id
| project _sigma_group_row, _sigma_group_component, _sigma_identity_identity);
let _sigma_group_lookup = materialize(_sigma_group_input | join kind=inner (_sigma_group_identity_cache | where _sigma_group_component == 0) on _sigma_group_row
| summarize _sigma_group_original = take_any(_sigma_group_0), _sigma_group_original_1 = take_any(_sigma_group_1) by _sigma_identity_identity);
let _sigma_values = _sigma_group_input
| join kind=inner (_sigma_group_identity_cache | where _sigma_group_component == 0 | project _sigma_group_row, _sigma_group_key = _sigma_identity_identity) on _sigma_group_row
| extend _sigma_group_0 = _sigma_group_key, _sigma_group_1 = _sigma_group_key
| where isnotnull(_sigma_timestamp) and isnotempty(_sigma_group_0) and isnotempty(_sigma_group_1);
let _sigma_ranked = materialize(
_sigma_values
| project _sigma_group_0, _sigma_group_1, _sigma_window_end = _sigma_timestamp, _sigma_bin = bin(_sigma_timestamp, 5m)
| distinct *
| join kind=inner (
_sigma_values
| extend _sigma_bin = pack_array(bin(_sigma_timestamp, 5m), bin(_sigma_timestamp, 5m) + 5m)
| mv-expand _sigma_bin to typeof(datetime)
) on _sigma_group_0, _sigma_group_1, _sigma_bin
| where _sigma_timestamp between ((_sigma_window_end - 5m) .. _sigma_window_end)
| where tostring(_sigma_value[0]) in ("int", "long", "real", "double", "decimal") and isfinite(toreal(_sigma_value[1]))
| extend _sigma_partition = tostring(pack_array(_sigma_window_end, _sigma_group_0, _sigma_group_1)), _sigma_numeric = toreal(_sigma_value[1]), _sigma_precise = todecimal(_sigma_value[1])
| sort by _sigma_partition asc, _sigma_numeric asc, _sigma_precise asc
| serialize _sigma_rank = row_number(1, _sigma_partition != prev(_sigma_partition))
);
_sigma_ranked
| join kind=inner (
_sigma_ranked | summarize _sigma_population = max(_sigma_rank) by _sigma_partition
) on _sigma_partition
| where _sigma_rank == max_of(1, (_sigma_population / 100) * 50 + tolong(ceiling(toreal((_sigma_population % 100) * 50) / 100.0)))
| extend ValuePercentile = _sigma_value[1]
| where (gettype(ValuePercentile) in ("int", "long") and todecimal(ValuePercentile) >= decimal(1)) or (gettype(ValuePercentile) in ("real", "double", "decimal") and toreal(ValuePercentile) >= 1)
| project WindowStart = _sigma_window_end - 5m, WindowEnd = _sigma_window_end, ["User"] = _sigma_group_0, ["Server"] = _sigma_group_1, ValuePercentile
| join kind=inner (_sigma_group_lookup | project ["User"] = _sigma_identity_identity, _sigma_group_original) on ["User"]
| extend ["User"] = _sigma_group_original[1]
| project-away _sigma_group_original
| join kind=inner (_sigma_group_lookup | project ["Server"] = _sigma_identity_identity, _sigma_group_original_1) on ["Server"]
| extend ["Server"] = _sigma_group_original_1[1]
| project-away _sigma_group_original_1
| project ["WindowStart"], ["WindowEnd"], ["User"], ["Server"], ["ValuePercentile"]
};
let Observed=Actual() | project WindowEnd,Kind=gettype(User),Value=tostring(User),Server=tostring(Server),Metric=toreal(ValuePercentile);
let Expected=datatable(WindowEnd:datetime,Kind:string,Value:string,Server:string,Metric:real) [
 datetime(2026-01-01T12:00:00Z),"long","1",'{"x":[1,"a"]}',2,
 datetime(2026-01-01T12:00:00Z),"string","1",'{"x":[1,"a"]}',3
];
union (Observed | extend Delta=1),(Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowEnd,Kind,Value,Server,Metric
| where Delta!=0
