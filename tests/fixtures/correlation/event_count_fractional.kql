let Actual = union (gt_fraction() | extend Scenario = "gt"), (gte_fraction() | extend Scenario = "gte"), (lt_fraction() | extend Scenario = "lt"), (lte_fraction() | extend Scenario = "lte"), (eq_fraction() | extend Scenario = "eq"), (neq_fraction() | extend Scenario = "neq");
let Expected = datatable(Scenario:string, WindowEnd:datetime, Host:string, EventCount:long) [
"gt", datetime(2026-01-01T00:05:00), "a", 4,
"gt", datetime(2026-01-01T00:05:00.0000001), "a", 3,
"gte", datetime(2026-01-01T00:05:00), "a", 4,
"gte", datetime(2026-01-01T00:05:00.0000001), "a", 3,
"lt", datetime(2026-01-01T00:00:00), "a", 2,
"lt", datetime(2026-01-01T00:20:00), "a", 1,
"lt", datetime(2026-01-01T00:00:00), "b", 1,
"lt", datetime(2026-01-01T00:05:00.0000001), "b", 1,
"lte", datetime(2026-01-01T00:00:00), "a", 2,
"lte", datetime(2026-01-01T00:20:00), "a", 1,
"lte", datetime(2026-01-01T00:00:00), "b", 1,
"lte", datetime(2026-01-01T00:05:00.0000001), "b", 1,
"neq", datetime(2026-01-01T00:00:00), "a", 2,
"neq", datetime(2026-01-01T00:05:00), "a", 4,
"neq", datetime(2026-01-01T00:05:00.0000001), "a", 3,
"neq", datetime(2026-01-01T00:20:00), "a", 1,
"neq", datetime(2026-01-01T00:00:00), "b", 1,
"neq", datetime(2026-01-01T00:05:00.0000001), "b", 1
]
| extend WindowStart = WindowEnd - 5m;
union (Actual | extend Host=tostring(Host) | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by Scenario, WindowStart, WindowEnd, Host, EventCount
| where Delta != 0
