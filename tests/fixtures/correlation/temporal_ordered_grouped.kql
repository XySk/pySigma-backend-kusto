let Actual = () {
// Strict sequence: "source-rule" -> "other-rule" -> "third-rule". Total inclusive span: 5m.
union (Events
| where Marker =~ "A"
| extend EventTime_1 = todatetime(["ProcessTime"]), GroupCase = ["Case"], GroupHost = ["ProcessHost"]
| extend SourceRule = "source-rule"),
(Events
| where Marker =~ "A"
| extend EventTime_1 = todatetime(["ProcessTime"]), GroupCase = ["Case"], GroupHost = ["ProcessHost"]
| extend SourceRule = "source-rule"),
(OtherEvents
| where Marker =~ "B"
| extend EventTime_1 = todatetime(["NetworkTime"]), GroupCase = ["Case"], GroupHost = ["NetworkHost"]
| extend SourceRule = "other-rule"),
(OtherEvents
| where Marker =~ "B"
| extend EventTime_1 = todatetime(["NetworkTime"]), GroupCase = ["Case"], GroupHost = ["NetworkHost"]
| extend SourceRule = "other-rule"),
(Events
| where Marker =~ "C"
| extend EventTime_1 = todatetime(["ProcessTime"]), GroupCase = ["Case"], GroupHost = ["ProcessHost"]
| extend SourceRule = "third-rule"),
(Events
| where Marker =~ "C"
| extend EventTime_1 = todatetime(["ProcessTime"]), GroupCase = ["Case"], GroupHost = ["ProcessHost"]
| extend SourceRule = "third-rule")
| where isnotnull(EventTime_1) and isnotempty(GroupCase) and isnotempty(GroupHost)
// Batch equal timestamps: simultaneous source matches cannot advance strict sequence positions.
| summarize HasSourceRule = countif(SourceRule == "source-rule") > 0, HasOtherRule = countif(SourceRule == "other-rule") > 0, HasThirdRule = countif(SourceRule == "third-rule") > 0 by EventTime_1, GroupCase, GroupHost
| sort by GroupCase asc, GroupHost asc, EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1)) or GroupCase != prev(GroupCase) or GroupHost != prev(GroupHost)
// Read preceding timestamp state for every assignment; preserve viable earlier prefixes.
| scan declare (LatestSourceRuleStart:datetime = datetime(null), LatestSourceRuleThenOtherRuleStart:datetime = datetime(null), CompleteNow:bool = false) with (
    step SequenceState: true =>
        CompleteNow = not(NewCorrelationGroup) and HasThirdRule and isnotnull(SequenceState.LatestSourceRuleThenOtherRuleStart) and SequenceState.LatestSourceRuleThenOtherRuleStart >= EventTime_1 - 5m,
        LatestSourceRuleStart = iff(HasSourceRule, EventTime_1, iff(NewCorrelationGroup, datetime(null), SequenceState.LatestSourceRuleStart)),
        LatestSourceRuleThenOtherRuleStart = iff(NewCorrelationGroup, datetime(null), iff(HasOtherRule and isnotnull(SequenceState.LatestSourceRuleStart) and SequenceState.LatestSourceRuleStart >= EventTime_1 - 5m and (isnull(SequenceState.LatestSourceRuleThenOtherRuleStart) or SequenceState.LatestSourceRuleStart > SequenceState.LatestSourceRuleThenOtherRuleStart), SequenceState.LatestSourceRuleStart, SequenceState.LatestSourceRuleThenOtherRuleStart));
)
| where CompleteNow
| project WindowStart = EventTime_1 - 5m, WindowEnd = EventTime_1, ["Case"] = GroupCase, ["Host"] = GroupHost, RuleCount = tolong(3)
};
let Expected = datatable(WindowStart:datetime, WindowEnd:datetime, Case:string, Host:string, RuleCount:long) [
    datetime(2026-01-01T12:00:01Z), datetime(2026-01-01T12:05:01Z), "boundary", "host", 3,
    datetime(2026-01-01T12:00:59Z), datetime(2026-01-01T12:05:59Z), "boundary", "host", 3,
    datetime(2026-01-01T12:00:00Z), datetime(2026-01-01T12:05:00Z), "endpoint", "host", 3,
    datetime(2026-01-01T11:59:00Z), datetime(2026-01-01T12:04:00Z), "alternatives", "host", 3,
    datetime(2026-01-01T12:00:00Z), datetime(2026-01-01T12:05:00Z), "alternatives", "host", 3,
    datetime(2026-01-01T12:03:00Z), datetime(2026-01-01T12:08:00Z), "latest-start", "host", 3,
    datetime(2026-01-01T11:59:00Z), datetime(2026-01-01T12:04:00Z), "collapsed", "host", 3,
    datetime(2026-01-01T12:00:00Z), datetime(2026-01-01T12:05:00Z), "collapsed", "host", 3,
    datetime(2026-01-01T11:57:00Z), datetime(2026-01-01T12:02:00Z), "independent", "host-a", 3,
    datetime(2026-01-01T11:58:00Z), datetime(2026-01-01T12:03:00Z), "independent", "host-b", 3
];
union (Actual() | extend Case=tostring(Case), Host=tostring(Host) | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Case, Host, RuleCount
| where Delta != 0
