| extend _sigma_bin = pack_array(bin(_sigma_sequence_start, 5m), bin(_sigma_sequence_start, 5m) + 5m)
| mv-expand _sigma_bin to typeof(datetime)
| join kind=inner (
    _sigma_types
    | where _sigma_rule == "other-rule"
    | project _sigma_timestamp, _sigma_group_0, _sigma_group_1, _sigma_bin = bin(_sigma_timestamp, 5m)
) on _sigma_group_0, _sigma_group_1, _sigma_bin
| where _sigma_timestamp > _sigma_sequence_end and _sigma_timestamp <= _sigma_sequence_start + 5m
| summarize _sigma_sequence_start = max(_sigma_sequence_start) by _sigma_sequence_end = _sigma_timestamp, _sigma_group_0, _sigma_group_1;
let _sigma_sequence_2 = _sigma_sequence_1
| extend _sigma_bin = pack_array(bin(_sigma_sequence_start, 5m), bin(_sigma_sequence_start, 5m) + 5m)
| mv-expand _sigma_bin to typeof(datetime)
| join kind=inner (
    _sigma_types
    | where _sigma_rule == "third-rule"
    | project _sigma_timestamp, _sigma_group_0, _sigma_group_1, _sigma_bin = bin(_sigma_timestamp, 5m)
) on _sigma_group_0, _sigma_group_1, _sigma_bin
| where _sigma_timestamp > _sigma_sequence_end and _sigma_timestamp <= _sigma_sequence_start + 5m
| summarize _sigma_sequence_start = max(_sigma_sequence_start) by _sigma_sequence_end = _sigma_timestamp, _sigma_group_0, _sigma_group_1;
union (_sigma_identity_canonical | where _sigma_identity_count != array_length(_sigma_identity_tokens) or _sigma_identity_finished != 0 | project _sigma_correlation_error = "Kusto dynamic identity traversal incomplete or exceeds range limit; signature leaf limit exceeded")
};
let _sigma_guarded_query_rows = materialize(_sigma_guarded_query());
let _sigma_guarded_query_failure = toscalar(union (_sigma_validation_check() | project _sigma_correlation_error = tostring(_sigma_correlation_error)) | summarize countif(isnotempty(_sigma_correlation_error)));
_sigma_guarded_query_rows
| where assert(_sigma_guarded_query_failure == 0, "Kusto correlation validation failed: Kusto dynamic identity traversal incomplete or exceeds range limit; signature leaf limit exceeded; unrecognized error sentinel")
};
let Expected = datatable(WindowStart:datetime, WindowEnd:datetime, Case:string, Host:string, RuleCount:long) [
    datetime(2026-01-01T12:00:01Z), datetime(2026-01-01T12:05:01Z), "boundary", "host", 3,
    datetime(2026-01-01T12:00:59Z), datetime(2026-01-01T12:05:59Z), "boundary", "host", 3,
    datetime(2026-01-01T12:00:00Z), datetime(2026-01-01T12:05:00Z), "endpoint", "host", 3,
    datetime(2026-01-01T11:59:00Z), datetime(2026-01-01T12:04:00Z), "alternatives", "host", 3,
    datetime(2026-01-01T12:00:00Z), datetime(2026-01-01T12:05:00Z), "alternatives", "host", 3,
    datetime(2026-01-01T12:03:00Z), datetime(2026-01-01T12:08:00Z), "latest-start", "host", 3,
    datetime(2026-01-01T11:59:00Z), datetime(2026-01-01T12:04:00Z), "collapsed", "host", 3,
    datetime(2026-01-01T12:00:00Z), datetime(2026-01-01T12:05:00Z), "collapsed", "host", 3,
    datetime(2026-01-01T11:57:00Z), datetime(2026-01-01T12:02:00Z), "independent", "host-a", 3,
    datetime(2026-01-01T11:58:00Z), datetime(2026-01-01T12:03:00Z), "independent", "host-b", 3
];
union (Actual() | extend Case=tostring(Case), Host=tostring(Host) | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Case, Host, RuleCount
| where Delta != 0
