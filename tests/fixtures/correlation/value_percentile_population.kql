let Actual = union (p_0() | project Selector=0, Value=tolong(ValuePercentile)),
(p_1() | project Selector=1, Value=tolong(ValuePercentile)),
(p_50() | project Selector=50, Value=tolong(ValuePercentile)),
(p_99() | project Selector=99, Value=tolong(ValuePercentile)),
(p_100() | project Selector=100, Value=tolong(ValuePercentile));
let Expected = datatable(Selector:long, Value:long) [0,1, 1,2, 50,51, 99,100, 100,101];
union (Actual | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by Selector, Value
| where Delta != 0
