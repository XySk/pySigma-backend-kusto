let Actual = union (p_0() | project Selector=0, Value=tolong(ValuePercentile)),
(p_1() | project Selector=1, Value=tolong(ValuePercentile)),
(p_50() | project Selector=50, Value=tolong(ValuePercentile)),
(p_99() | project Selector=99, Value=tolong(ValuePercentile)),
