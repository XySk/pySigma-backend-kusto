// Prepared deterministic fixture; live engine execution has not been performed.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
let Events = range Amount from 1 to 101 step 1
| extend Timestamp=datetime(2026-01-01T12:00:00Z), Marker="match";
let p_0 = () {
let _sigma_values = union (Events
| where Marker =~ "match"
| extend _sigma_timestamp = todatetime(["Timestamp"]), _sigma_value = pack_array(gettype(["Amount"]), ["Amount"])
| extend _sigma_rule = "source-rule")
| where isnotnull(_sigma_timestamp);
let _sigma_ranked = materialize(
_sigma_values
| project _sigma_window_end = _sigma_timestamp, _sigma_bin = bin(_sigma_timestamp, 5m)
| distinct *
| join kind=inner (
_sigma_values
| extend _sigma_bin = pack_array(bin(_sigma_timestamp, 5m), bin(_sigma_timestamp, 5m) + 5m)
| mv-expand _sigma_bin to typeof(datetime)
) on _sigma_bin
| where _sigma_timestamp between ((_sigma_window_end - 5m) .. _sigma_window_end)
| where tostring(_sigma_value[0]) in ("int", "long", "real", "double", "decimal") and isfinite(toreal(_sigma_value[1]))
| extend _sigma_partition = tostring(pack_array(_sigma_window_end)), _sigma_numeric = toreal(_sigma_value[1]), _sigma_precise = todecimal(_sigma_value[1])
| sort by _sigma_partition asc, _sigma_numeric asc, _sigma_precise asc
| serialize _sigma_rank = row_number(1, _sigma_partition != prev(_sigma_partition))
);
_sigma_ranked
| join kind=inner (
_sigma_ranked | summarize _sigma_population = max(_sigma_rank) by _sigma_partition
) on _sigma_partition
| where _sigma_rank == max_of(1, (_sigma_population / 100) * 0 + tolong(ceiling(toreal((_sigma_population % 100) * 0) / 100.0)))
| extend ValuePercentile = tolong(_sigma_value[1])
| where (gettype(ValuePercentile) in ("int", "long") and todecimal(ValuePercentile) >= decimal(0)) or (gettype(ValuePercentile) in ("real", "double", "decimal") and toreal(ValuePercentile) >= 0)
| project WindowStart = _sigma_window_end - 5m, WindowEnd = _sigma_window_end, ValuePercentile
};
