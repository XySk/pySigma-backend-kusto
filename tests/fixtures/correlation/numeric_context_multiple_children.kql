let Events=datatable(Timestamp:datetime,Host:string,Marker:string,User:string,Amount:dynamic) [
 datetime(2026-01-01T12:00:00Z),"h","match","Alice",dynamic(10),
 datetime(2026-01-01T12:00:00Z),"h","match","Alice",dynamic(10),
 datetime(2026-01-01T12:00:00Z),"h","match","Alice",dynamic(20),
 datetime(2026-01-01T12:00:00Z),"h","match","Bob",dynamic(100),
 datetime(2026-01-01T12:00:00Z),"h2","match","Alice",dynamic(10),
 datetime(2026-01-01T12:00:00Z),"d","direct","Alice",dynamic(5)
, datetime(2026-01-01T12:00:00Z),"h3","other","Alice",dynamic(10) ]
// Normalize Events scalar fixture inputs explicitly.
| extend Amount=iff(gettype(Amount) in ("int","long","real","double","decimal"), tolong(Amount), long(null));
let Actual=(){
let Child = () {
let ContextSummary = () {
let SourceMatchArrivals = union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]), GroupHost = ["Host"])
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
| summarize SourceMatchCount = count() by EventTime_1, GroupHost;
union (SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime_1 + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupHost asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupHost != prev(GroupHost))
| where CountBoundaryOrder == 0
| where EventCount >= 1
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, ["Host"] = GroupHost, EventCount
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId = row_number());
let WindowSourceMatches = materialize(
CorrelationMatches | project CorrelationMatchId, CompletionTime = WindowEnd, ContextGroupHost = ["Host"], ContextPartition = 1
| join kind=inner (
union (Events
| where Marker =~ "match"
| extend ContextEventTime = todatetime(["Timestamp"]), ContextGroupHost = ["Host"], ContextUser = ["User"], ContextAmount = ["Amount"]
| extend ContextSourceRule = "source-rule")
| project ContextEventTime, ContextSourceRule, ContextGroupHost, ContextUser, ContextAmount, ContextPartition = 1
) on ContextGroupHost
| where ContextEventTime between ((CompletionTime - 5m) .. CompletionTime));
let CompleteContextRelationships = materialize(WindowSourceMatches
| project CorrelationMatchId, ContextUser, ContextAmount
| distinct *);
union (CorrelationMatches | extend ContextRowKind = "Summary"), (CorrelationMatches | join kind=inner (CompleteContextRelationships) on CorrelationMatchId | extend ContextRowKind = "ContextEvidence")
};
let ChildResults = materialize(Child());
let SecondChild = () {
let ContextSummary = () {
let SourceMatchArrivals = union (Events
| where Marker =~ "other"
| project EventTime_1 = todatetime(["Timestamp"]), GroupHost = ["Host"])
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
| summarize SourceMatchCount = count() by EventTime_1, GroupHost;
union (SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime_1 + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupHost asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupHost != prev(GroupHost))
| where CountBoundaryOrder == 0
| where EventCount >= 1
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, ["Host"] = GroupHost, EventCount
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId = row_number());
let WindowSourceMatches = materialize(
CorrelationMatches | project CorrelationMatchId, CompletionTime = WindowEnd, ContextGroupHost = ["Host"], ContextPartition = 1
| join kind=inner (
union (Events
| where Marker =~ "other"
| extend ContextEventTime = todatetime(["Timestamp"]), ContextGroupHost = ["Host"], ContextUser = ["User"], ContextAmount = ["Amount"]
| extend ContextSourceRule = "second-source")
| project ContextEventTime, ContextSourceRule, ContextGroupHost, ContextUser, ContextAmount, ContextPartition = 1
) on ContextGroupHost
| where ContextEventTime between ((CompletionTime - 5m) .. CompletionTime));
let CompleteContextRelationships = materialize(WindowSourceMatches
| project CorrelationMatchId, ContextUser, ContextAmount
| distinct *);
union (CorrelationMatches | extend ContextRowKind = "Summary"), (CorrelationMatches | join kind=inner (CompleteContextRelationships) on CorrelationMatchId | extend ContextRowKind = "ContextEvidence")
};
let SecondChildResults = materialize(SecondChild());
let ContextSummary = () {
let ParentSourceMatches = materialize(union (ChildResults | where ["ContextRowKind"] == "Summary"
| project-away ["ContextUser"], ["ContextAmount"]
| join kind=leftouter (ChildResults | where ["ContextRowKind"] == "ContextEvidence" | project ["CorrelationMatchId"], ["ContextUser"], ["ContextAmount"]) on ["CorrelationMatchId"]
| extend ChildCorrelationMatch = strcat("Child", "_", tostring(["CorrelationMatchId"]))
| project EventTime = todatetime(["WindowEnd"]), MeasuredAmount = ["ContextAmount"], ChildCorrelationMatch),
(SecondChildResults | where ["ContextRowKind"] == "Summary"
| project-away ["ContextUser"], ["ContextAmount"]
| join kind=leftouter (SecondChildResults | where ["ContextRowKind"] == "ContextEvidence" | project ["CorrelationMatchId"], ["ContextUser"], ["ContextAmount"]) on ["CorrelationMatchId"]
| extend ChildCorrelationMatch = strcat("SecondChild", "_", tostring(["CorrelationMatchId"]))
| project EventTime = todatetime(["WindowEnd"]), MeasuredAmount = ["ContextAmount"], ChildCorrelationMatch)
| extend ChildCorrelationMatch = tostring(column_ifexists("ChildCorrelationMatch", "")));
let SumObservations = union (ParentSourceMatches | where isempty(ChildCorrelationMatch)), (ParentSourceMatches | where isnotempty(ChildCorrelationMatch) | extend RetainedNumericValue = MeasuredAmount | summarize take_any(*) by ChildCorrelationMatch, RetainedNumericValue)
| where isnotnull(EventTime);
let SumArrivals = SumObservations
| summarize ArrivalSum = sum(MeasuredAmount) by EventTime;
union (SumArrivals
| project SumBoundaryTime = EventTime, SumBoundaryOrder = 0, SumDelta = ArrivalSum),
(SumArrivals
| project SumBoundaryTime = EventTime + 5m, SumBoundaryOrder = 1, SumDelta = -ArrivalSum)
// Arrivals evaluate before equal-time expirations, including zero and missing values.
| sort by SumBoundaryTime asc, SumBoundaryOrder asc
| extend ValueSum = row_cumsum(SumDelta)
| where SumBoundaryOrder == 0
| where ValueSum >= 0
| project WindowStart = SumBoundaryTime - 5m, WindowEnd = SumBoundaryTime, ValueSum
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId_1 = row_number());
let WindowSourceMatches = materialize(
CorrelationMatches | project CorrelationMatchId_1, CompletionTime = WindowEnd, ContextPartition = 1
| join kind=inner (
union (ChildResults | where ["ContextRowKind"] == "Summary"
| project-away ["ContextUser"], ["ContextAmount"]
| join kind=leftouter (ChildResults | where ["ContextRowKind"] == "ContextEvidence" | project ["CorrelationMatchId"], ["ContextUser"], ["ContextAmount"], HasContextEvidence = true) on ["CorrelationMatchId"]
| extend ContextEventTime = todatetime(["WindowEnd"]), ContextUser_1 = ["ContextUser"], ContextAmount_1 = ["ContextAmount"]
| extend ContextSourceRule = "child"),
(SecondChildResults | where ["ContextRowKind"] == "Summary"
| project-away ["ContextUser"], ["ContextAmount"]
| join kind=leftouter (SecondChildResults | where ["ContextRowKind"] == "ContextEvidence" | project ["CorrelationMatchId"], ["ContextUser"], ["ContextAmount"], HasContextEvidence = true) on ["CorrelationMatchId"]
| extend ContextEventTime = todatetime(["WindowEnd"]), ContextUser_1 = ["ContextUser"], ContextAmount_1 = ["ContextAmount"]
| extend ContextSourceRule = "second-child")
| project ContextEventTime, ContextSourceRule, ContextUser_1, ContextAmount_1, HasContextEvidence, ContextPartition = 1
) on ContextPartition
| where ContextEventTime between ((CompletionTime - 5m) .. CompletionTime));
let CompleteContextRelationships = materialize(WindowSourceMatches
| where HasContextEvidence
| project CorrelationMatchId_1, ContextUser_1, ContextAmount_1
| distinct *);
let ValuesForUser = CompleteContextRelationships
| where isnotnull(ContextUser_1)
| summarize by CorrelationMatchId_1, ContextUser_1
| summarize DisplayedUser = make_list(ContextUser_1, 1000), DistinctUserCount = count() by CorrelationMatchId_1;
let ValuesForAmount = CompleteContextRelationships
| where isnotnull(ContextAmount_1)
| summarize by CorrelationMatchId_1, ContextAmount_1
| summarize DisplayedAmount = make_list(ContextAmount_1, 1000), DistinctAmountCount = count() by CorrelationMatchId_1;
CorrelationMatches
| join kind=leftouter (ValuesForUser) on CorrelationMatchId_1
| extend ["User"] = coalesce(DisplayedUser, dynamic([]))
| join kind=leftouter (ValuesForAmount) on CorrelationMatchId_1
| extend ["Amount"] = coalesce(DisplayedAmount, dynamic([]))
| extend ContextComplete = coalesce(DistinctUserCount, 0) <= 1000 and coalesce(DistinctAmountCount, 0) <= 1000
| project ["WindowStart"], ["WindowEnd"], ["User"], ["Amount"], ["ValueSum"], ["ContextComplete"]
};
let Observed=Actual() | project Metric=toreal(ValueSum);
let Expected=datatable(Metric:real) [150.0];
union (Observed | extend Delta=1), (Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by Metric
| where Delta!=0
