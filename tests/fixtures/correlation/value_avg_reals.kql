// Nonempty rows identify a missing, additional, or duplicated summary.
let Events = datatable(Timestamp:datetime, Host:string, Amount:dynamic, Marker:string) [
    datetime(2026-01-01T12:00:00Z), "finite", dynamic(0), "match",
    datetime(2026-01-01T12:00:00Z), "finite", dynamic(-2.0), "match",
    datetime(2026-01-01T12:00:00Z), "finite", dynamic(3.5), "match",
    datetime(2026-01-01T12:00:00Z), "finite", dynamic("100"), "match",
    datetime(2026-01-01T12:00:00Z), "finite", dynamic("nan_value"), "match",
    datetime(2026-01-01T12:00:00Z), "finite", dynamic("positive_inf"), "match",
    datetime(2026-01-01T12:00:00Z), "finite", dynamic("negative_inf"), "match",
    datetime(2026-01-01T12:00:00Z), "undefined", dynamic("nan_value"), "match",
    datetime(2026-01-01T12:00:00Z), "undefined", dynamic("positive_inf"), "match",
    datetime(2026-01-01T12:00:00Z), "undefined", dynamic(null), "match",
    datetime(2026-01-01T12:00:00Z), "float", dynamic(0.1), "match",
    datetime(2026-01-01T12:00:00Z), "float", dynamic(0.2), "match",
    datetime(2026-01-01T12:01:00Z), "undefined", dynamic("bad"), "match"
]
| extend Amount = case(tostring(Amount) == "nan_value", pack_array(real(nan))[0],
    tostring(Amount) == "positive_inf", pack_array(real(+inf))[0],
    tostring(Amount) == "negative_inf", pack_array(real(-inf))[0], Amount);
let Actual = () {
let _sigma_values = union (Events
| where Marker =~ "match"
| extend _sigma_timestamp = todatetime(["Timestamp"]), _sigma_group_0 = tostring(["Host"]), _sigma_value = pack_array(gettype(["Amount"]), ["Amount"])
| extend _sigma_rule = "source-rule")
| where isnotnull(_sigma_timestamp) and isnotempty(_sigma_group_0)
;
_sigma_values
| project _sigma_group_0, _sigma_window_end = _sigma_timestamp, _sigma_bin = bin(_sigma_timestamp, 5m)
| distinct *
| join kind=inner (
    _sigma_values
    | extend _sigma_bin = pack_array(bin(_sigma_timestamp, 5m), bin(_sigma_timestamp, 5m) + 5m)
    | mv-expand _sigma_bin to typeof(datetime)
) on _sigma_group_0, _sigma_bin
| where _sigma_timestamp between ((_sigma_window_end - 5m) .. _sigma_window_end)
| summarize ValueAvg = avgif(toreal(_sigma_value[1]), tostring(_sigma_value[0]) in ("int", "long", "real", "double", "decimal") and isfinite(toreal(_sigma_value[1]))), _sigma_numeric_count = countif(tostring(_sigma_value[0]) in ("int", "long", "real", "double", "decimal") and isfinite(toreal(_sigma_value[1]))) by _sigma_window_end, _sigma_group_0
| where _sigma_numeric_count > 0 and ValueAvg != 0.15
| project WindowStart = _sigma_window_end - 5m, WindowEnd = _sigma_window_end, ["Host"] = _sigma_group_0, ValueAvg
};
let Expected = datatable(WindowStart:datetime, WindowEnd:datetime, Host:string, ValueAvg:real) [
    datetime(2026-01-01T11:55:00Z), datetime(2026-01-01T12:00:00Z), "finite", 0.5,
    datetime(2026-01-01T11:55:00Z), datetime(2026-01-01T12:00:00Z), "float", 0.15000000000000002
];
union (Actual() | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Host, ValueAvg
| where Delta != 0
