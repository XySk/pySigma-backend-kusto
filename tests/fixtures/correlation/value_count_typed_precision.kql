let Actual=union (Scenario0() | project Case="adjacent-real",ValueCount), (Scenario1() | project Case="adjacent-long",ValueCount), (Scenario2() | project Case="decimal-scale",ValueCount), (Scenario3() | project Case="decimal-zero",ValueCount), (Scenario4() | project Case="real-zero",ValueCount), (Scenario5() | project Case="exceptional-real",ValueCount);
let Expected=datatable(Case:string,ValueCount:long) ["adjacent-real",2, "adjacent-long",2, "decimal-scale",1, "decimal-zero",1, "real-zero",1, "exceptional-real",3];
union (Actual | extend Delta=1),(Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by Case,ValueCount
| where Delta!=0
