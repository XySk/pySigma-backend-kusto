let Scenario0=() { let Events=datatable(Value:real) [real(1.0),real(1.0000000000000002)] | extend Timestamp=datetime(2026-01-01T12:00:00Z),Marker="match";
let ValueCountSources = materialize(union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]), CountedValue = ["Value"])
| where isnotnull(EventTime_1));
let CountedValueActivity = materialize(ValueCountSources
| where isnotempty(CountedValue)
| summarize by CountedValue, EventTime_1
| sort by CountedValue asc, EventTime_1 asc
// Repeated values whose inclusive active intervals overlap contribute only once.
| extend CountedValueStarts = isnull(prev(EventTime_1)) or (CountedValue != prev(CountedValue) and not(isnan(CountedValue) and isnan(prev(CountedValue)))) or EventTime_1 > prev(EventTime_1) + 5m,
    CountedValueEnds = isnull(next(EventTime_1)) or (CountedValue != next(CountedValue) and not(isnan(CountedValue) and isnan(next(CountedValue)))) or next(EventTime_1) > EventTime_1 + 5m);
union (ValueCountSources | summarize by EventTime_1
| project ValueBoundaryTime = EventTime_1, ValueBoundaryOrder = 1, CountedValueDelta = 0),
(CountedValueActivity | where CountedValueStarts
| project ValueBoundaryTime = EventTime_1, ValueBoundaryOrder = 0, CountedValueDelta = 1),
(CountedValueActivity | where CountedValueEnds
| project ValueBoundaryTime = EventTime_1 + 5m, ValueBoundaryOrder = 2, CountedValueDelta = -1)
// All interval starts precede anchors; equal-time expirations follow them.
| sort by ValueBoundaryTime asc, ValueBoundaryOrder asc
| extend ValueCount = row_cumsum(CountedValueDelta)
| where ValueBoundaryOrder == 1
| where ValueCount >= 0
| project WindowStart = ValueBoundaryTime - 5m, WindowEnd = ValueBoundaryTime, ValueCount
};
