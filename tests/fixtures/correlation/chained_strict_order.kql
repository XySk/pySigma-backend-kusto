// Prepared deterministic fixture; live engine execution has not been performed.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
// C ends at 01 and 02. D before/tied with the first WindowEnd cannot complete P.
// D at 02 and 03 complete P once per end, despite multiple viable child summaries.
let Events=datatable(Timestamp:string, Case:string, Host:string, Marker:string) [
    "2026-01-01T12:00:00Z", "temporal-ordered", "host", "TA",
    "2026-01-01T12:01:00Z", "temporal-ordered", "host", "TB",
    "2026-01-01T12:02:00Z", "temporal-ordered", "host", "TB",
    "2026-01-01T12:00:30Z", "temporal-ordered", "host", "D",
    "2026-01-01T12:01:00Z", "temporal-ordered", "host", "D",
    "2026-01-01T12:02:00Z", "temporal-ordered", "host", "D",
    "2026-01-01T12:03:00Z", "temporal-ordered", "host", "D",
    "2026-01-01T12:00:00Z", "tie-only", "host", "TA",
    "2026-01-01T12:01:00Z", "tie-only", "host", "TB",
    "2026-01-01T12:01:00Z", "tie-only", "host", "D",
    "2026-01-01T12:00:00Z", "reversed", "host", "D",
    "2026-01-01T12:01:00Z", "reversed", "host", "TA",
    "2026-01-01T12:02:00Z", "reversed", "host", "TB",
    "2026-01-01T12:00:00Z", "overflow", "host", "TA",
    "2026-01-01T12:01:00Z", "overflow", "host", "TB",
    "2026-01-01T12:06:00.0000001Z", "overflow", "host", "D",
    "invalid", "temporal-ordered", "host", "D",
    "2026-01-01T12:04:00Z", "temporal-ordered", "", "D"
]
// Normalize Events scalar fixture inputs explicitly.
| extend Timestamp=todatetime(Timestamp);
let Actual = () {
let C = () {
union (Events
| where Marker =~ "TA"
| project EventTime_1 = todatetime(["Timestamp"]), GroupCase = ["Case"], GroupHost = ["Host"], SourceRule = "TA"),
(Events
| where Marker =~ "TB"
| project EventTime_1 = todatetime(["Timestamp"]), GroupCase = ["Case"], GroupHost = ["Host"], SourceRule = "TB")
| where isnotnull(EventTime_1) and isnotempty(GroupCase) and isnotempty(GroupHost)
// Batch simultaneous source matches before updating inclusive trailing presence.
| summarize MatchesTA = countif(SourceRule == "TA") > 0, MatchesTB = countif(SourceRule == "TB") > 0 by GroupCase, GroupHost, EventTime_1
| sort by GroupCase asc, GroupHost asc, EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1)) or GroupCase != prev(GroupCase) or GroupHost != prev(GroupHost)
| scan declare (LastTATime:datetime, LastTBTime:datetime) with (
    step PresenceWindow: true =>
        LastTATime = iff(MatchesTA, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastTATime)),
        LastTBTime = iff(MatchesTB, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastTBTime));
)
// Only source-match timestamps evaluate; expiration never creates an anchor.
| extend HasTA = isnotnull(LastTATime) and LastTATime >= EventTime_1 - 5m, HasTB = isnotnull(LastTBTime) and LastTBTime >= EventTime_1 - 5m
| extend RuleCount = tolong(HasTA) + tolong(HasTB)
| where RuleCount >= 2
| project WindowStart = EventTime_1 - 5m, WindowEnd = EventTime_1, ["Case"] = GroupCase, ["Host"] = GroupHost, RuleCount
};
// Strict sequence: "C" -> "D". Total inclusive span: 5m.
union (C()
| extend EventTime_1 = todatetime(["WindowEnd"]), GroupCase = ["Case"], GroupHost = ["Host"]
| extend SourceRule = "C"),
(Events
| where Marker =~ "D"
| extend EventTime_1 = todatetime(["Timestamp"]), GroupCase = ["Case"], GroupHost = ["Host"]
| extend SourceRule = "D")
| where isnotnull(EventTime_1) and isnotempty(GroupCase) and isnotempty(GroupHost)
// Batch equal timestamps: simultaneous source matches cannot advance strict sequence positions.
| summarize HasC = countif(SourceRule == "C") > 0, HasD = countif(SourceRule == "D") > 0 by EventTime_1, GroupCase, GroupHost
| sort by GroupCase asc, GroupHost asc, EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1)) or GroupCase != prev(GroupCase) or GroupHost != prev(GroupHost)
// Read preceding timestamp state for every assignment; preserve viable earlier prefixes.
| scan declare (LatestCStart:datetime = datetime(null), CompleteNow:bool = false) with (
    step SequenceState: true =>
        CompleteNow = not(NewCorrelationGroup) and HasD and isnotnull(SequenceState.LatestCStart) and SequenceState.LatestCStart >= EventTime_1 - 5m,
        LatestCStart = iff(HasC, EventTime_1, iff(NewCorrelationGroup, datetime(null), SequenceState.LatestCStart));
)
| where CompleteNow
| project WindowStart = EventTime_1 - 5m, WindowEnd = EventTime_1, ["Case"] = GroupCase, ["Host"] = GroupHost, RuleCount = tolong(2)
};
let Expected = datatable(WindowStart:datetime, WindowEnd:datetime, Case:string, Host:string, RuleCount:long) [
    datetime(2026-01-01T11:57:00Z), datetime(2026-01-01T12:02:00Z), "temporal-ordered", "host", 2,
    datetime(2026-01-01T11:58:00Z), datetime(2026-01-01T12:03:00Z), "temporal-ordered", "host", 2
];
union (Actual() | extend Case=tostring(Case), Host=tostring(Host) | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Case, Host, RuleCount
| where Delta != 0
