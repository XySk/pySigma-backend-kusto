// Generated through standard collection parsing and KustoBackend.convert.
// PASS: zero exact multiset differences. See RUNTIME.md.
let Events=datatable(Timestamp:datetime, Case:string, Marker:string, User:dynamic, Server:string) [
datetime(2026-01-01T12:00:00Z), "mixed", "A", dynamic("A"), "a",
datetime(2026-01-01T12:00:00Z), "mixed", "B", dynamic("B"), "b"
]
// Normalize Events scalar fixture inputs explicitly.
| extend User=tostring(User);
let Actual=(){
let _sigma_shared_child = () {
let SourceMatchArrivals = union (Events
| where Marker =~ "A"
| project EventTime_1 = todatetime(["Timestamp"]), GroupCase = ["Case"], GroupUser = ["User"], GroupServer = ["Server"])
| where isnotnull(EventTime_1) and isnotempty(GroupCase) and isnotempty(GroupUser) and isnotempty(GroupServer)
| summarize SourceMatchCount = count() by EventTime_1, GroupCase, GroupUser, GroupServer;
union (SourceMatchArrivals
| project GroupCase, GroupUser, GroupServer, CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupCase, GroupUser, GroupServer, CountBoundaryTime = EventTime_1 + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupCase asc, GroupUser asc, GroupServer asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupCase != prev(GroupCase) or GroupUser != prev(GroupUser) or GroupServer != prev(GroupServer))
| where CountBoundaryOrder == 0
| where EventCount >= 1
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, ["Case"] = GroupCase, ["User"] = GroupUser, ["Server"] = GroupServer, EventCount
};
let _sigma_shared_results = materialize(_sigma_shared_child());
let _sigma_context_summary = () {
union (_sigma_shared_results
| project EventTime_1 = todatetime(["WindowEnd"]), GroupCase = ["Case"], SourceRule = "A"),
(Events
| where Marker =~ "B"
| project EventTime_1 = todatetime(["Timestamp"]), GroupCase = ["Case"], SourceRule = "B")
| where isnotnull(EventTime_1) and isnotempty(GroupCase)
// Batch simultaneous source matches before updating inclusive trailing presence.
| summarize MatchesA = countif(SourceRule == "A") > 0, MatchesB = countif(SourceRule == "B") > 0 by GroupCase, EventTime_1
| sort by GroupCase asc, EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1)) or GroupCase != prev(GroupCase)
| scan declare (LastATime:datetime, LastBTime:datetime) with (
    step PresenceWindow: true =>
        LastATime = iff(MatchesA, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastATime)),
        LastBTime = iff(MatchesB, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastBTime));
)
// Only source-match timestamps evaluate; expiration never creates an anchor.
| extend HasA = isnotnull(LastATime) and LastATime >= EventTime_1 - 5m, HasB = isnotnull(LastBTime) and LastBTime >= EventTime_1 - 5m
| extend RuleCount = tolong(HasA) + tolong(HasB)
| where (HasA or HasB)
| project WindowStart = EventTime_1 - 5m, WindowEnd = EventTime_1, ["Case"] = GroupCase, RuleCount
};
let _sigma_context_summaries = materialize(_sigma_context_summary()
| serialize _sigma_context_id = row_number());
let _sigma_context_matches = materialize(
_sigma_context_summaries | project _sigma_context_id, _sigma_context_end = WindowEnd, _sigma_context_group = ["Case"], _sigma_context_partition = 1
| join kind=inner (
union (_sigma_shared_results
| extend _sigma_context_timestamp = todatetime(["WindowEnd"]), _sigma_context_group = ["Case"], _sigma_context_value = ["User"], _sigma_context_value_1 = ["Server"]
| extend _sigma_context_rule = "A"),
(Events
| where Marker =~ "B"
| extend _sigma_context_timestamp = todatetime(["Timestamp"]), _sigma_context_group = ["Case"], _sigma_context_value = ["User"], _sigma_context_value_1 = ["Server"]
| extend _sigma_context_rule = "B")
| project _sigma_context_timestamp, _sigma_context_rule, _sigma_context_group, _sigma_context_value, _sigma_context_value_1, _sigma_context_partition = 1
) on _sigma_context_group
| where _sigma_context_timestamp between ((_sigma_context_end - 5m) .. _sigma_context_end)
| serialize _sigma_context_key = row_number());
let _sigma_context_eligible = materialize(_sigma_context_matches
| join kind=inner (_sigma_context_matches | summarize _sigma_context_present = countif(_sigma_context_rule == "A") > 0, _sigma_context_present_1 = countif(_sigma_context_rule == "B") > 0 by _sigma_context_id) on _sigma_context_id
| where ((_sigma_context_present and (_sigma_context_rule == "A")) or (_sigma_context_present_1 and (_sigma_context_rule == "B"))));
let _sigma_context_rows = materialize(_sigma_context_eligible
| project _sigma_context_id, _sigma_context_value, _sigma_context_value_1
| distinct *);
let ContextValues = _sigma_context_rows
| where isnotnull(_sigma_context_value)
| summarize by _sigma_context_id, _sigma_context_value
| summarize DisplayedValues = make_list(_sigma_context_value, 1000), DistinctValueCount = count() by _sigma_context_id;
let ContextValues_1 = _sigma_context_rows
| where isnotnull(_sigma_context_value_1)
| summarize by _sigma_context_id, _sigma_context_value_1
| summarize DisplayedValues_1 = make_list(_sigma_context_value_1, 1000), DistinctValueCount_1 = count() by _sigma_context_id;
_sigma_context_summaries
| join kind=leftouter (ContextValues) on _sigma_context_id
| extend ["User"] = coalesce(DisplayedValues, dynamic([]))
| join kind=leftouter (ContextValues_1) on _sigma_context_id
| extend ["Server"] = coalesce(DisplayedValues_1, dynamic([]))
| extend ContextComplete = coalesce(DistinctValueCount, 0) <= 1000 and coalesce(DistinctValueCount_1, 0) <= 1000
| project ["WindowStart"], ["WindowEnd"], ["Case"], ["User"], ["Server"], ["RuleCount"], ["ContextComplete"]
};
let Observed=Actual()
| project WindowEnd, Case=tostring(Case), RuleCount, Users=tostring(array_sort_asc(User)), Servers=tostring(array_sort_asc(Server)), UserCount=array_length(User), ServerCount=array_length(Server), ContextComplete;
let Expected=datatable(WindowEnd:datetime, Case:string, RuleCount:long, User:dynamic, Server:dynamic, ContextComplete:bool) [
datetime(2026-01-01T12:00:00Z), "mixed", 2, dynamic(["A", "B"]), dynamic(["a", "b"]), true
]
| project WindowEnd, Case, RuleCount, Users=tostring(array_sort_asc(User)), Servers=tostring(array_sort_asc(Server)), UserCount=array_length(User), ServerCount=array_length(Server), ContextComplete;
union (Observed | extend Delta=1), (Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowEnd, Case, RuleCount, Users, Servers, UserCount, ServerCount, ContextComplete
| where Delta!=0
