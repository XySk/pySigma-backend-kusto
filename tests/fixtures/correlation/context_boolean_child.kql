// Generated through standard collection parsing and KustoBackend.convert.
// PASS: zero exact multiset differences. See RUNTIME.md.
let Events=datatable(Timestamp:datetime, Case:string, Marker:string, User:dynamic, Server:string) [
datetime(2026-01-01T12:00:00Z), "mixed", "A", dynamic("A"), "a",
datetime(2026-01-01T12:00:00Z), "mixed", "B", dynamic("B"), "b"
]
// Normalize Events scalar fixture inputs explicitly.
| extend User=tostring(User);
let Actual=(){
let A_1 = () {
Events
| where Marker =~ "A"
| project EventTime_1 = ["Timestamp"], GroupCase = ["Case"], GroupUser = ["User"], GroupServer = ["Server"]
| where isnotnull(EventTime_1) and isnotempty(GroupCase) and isnotempty(GroupUser) and isnotempty(GroupServer)
| distinct EventTime_1, GroupCase, GroupUser, GroupServer
| project WindowStart = EventTime_1 - 5m, WindowEnd = EventTime_1, ["Case"] = GroupCase, ["User"] = GroupUser, ["Server"] = GroupServer
};
let AResults = materialize(A_1());
let ContextSummary = () {
union (AResults
| project EventTime_1 = ["WindowEnd"], GroupCase = ["Case"], SourceRule = "A"
| where isnotnull(EventTime_1) and isnotempty(GroupCase)),
(Events
| where Marker =~ "B"
| project EventTime_1 = ["Timestamp"], GroupCase = ["Case"], SourceRule = "B"
| where isnotnull(EventTime_1) and isnotempty(GroupCase))
// Batch simultaneous source matches before updating inclusive trailing presence.
| summarize MatchesA = countif(SourceRule == "A") > 0, MatchesB = countif(SourceRule == "B") > 0 by GroupCase, EventTime_1
| sort by GroupCase asc, EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1)) or GroupCase != prev(GroupCase)
| scan declare (LastATime:datetime, LastBTime:datetime) with (
    step PresenceWindow: true =>
        LastATime = iff(MatchesA, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastATime)),
        LastBTime = iff(MatchesB, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastBTime));
)
// Only source-match timestamps evaluate; expiration never creates an anchor.
| extend HasA = isnotnull(LastATime) and LastATime >= EventTime_1 - 5m, HasB = isnotnull(LastBTime) and LastBTime >= EventTime_1 - 5m
| extend RuleCount = tolong(HasA) + tolong(HasB)
| where (HasA or HasB)
| project WindowStart = EventTime_1 - 5m, WindowEnd = EventTime_1, ["Case"] = GroupCase, RuleCount
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId = row_number());
let WindowSourceMatches = materialize(
CorrelationMatches | project CorrelationMatchId, CompletionTime = WindowEnd, ContextGroupCase = ["Case"], ContextPartition = 1
| join kind=inner (
union (AResults
| extend ContextEventTime = ["WindowEnd"], ContextGroupCase = ["Case"], ContextUser = ["User"], ContextServer = ["Server"]
| where isnotnull(ContextEventTime) and isnotempty(ContextGroupCase)
| extend ContextSourceRule = "A"),
(Events
| where Marker =~ "B"
| extend ContextEventTime = ["Timestamp"], ContextGroupCase = ["Case"], ContextUser = ["User"], ContextServer = ["Server"]
| where isnotnull(ContextEventTime) and isnotempty(ContextGroupCase)
| extend ContextSourceRule = "B")
| project ContextEventTime, ContextSourceRule, ContextGroupCase, ContextUser, ContextServer, ContextPartition = 1
) on ContextGroupCase
| where ContextEventTime between ((CompletionTime - 5m) .. CompletionTime));
let BooleanParticipants = WindowSourceMatches
| join kind=inner (WindowSourceMatches | summarize HasA_1 = countif(ContextSourceRule == "A") > 0, HasB_1 = countif(ContextSourceRule == "B") > 0 by CorrelationMatchId) on CorrelationMatchId
| where ((HasA_1 and (ContextSourceRule == "A")) or (HasB_1 and (ContextSourceRule == "B")));
let CompleteContextRelationships = materialize(BooleanParticipants
| project CorrelationMatchId, ContextUser, ContextServer
| distinct *);
let ValuesForUser = CompleteContextRelationships
| where isnotnull(ContextUser)
| summarize by CorrelationMatchId, ContextUser
| summarize DisplayedUser = make_list(ContextUser, 1000), DistinctUserCount = count() by CorrelationMatchId;
let ValuesForServer = CompleteContextRelationships
| where isnotnull(ContextServer)
| summarize by CorrelationMatchId, ContextServer
| summarize DisplayedServer = make_list(ContextServer, 1000), DistinctServerCount = count() by CorrelationMatchId;
CorrelationMatches
| join kind=leftouter (ValuesForUser) on CorrelationMatchId
| extend ["User"] = coalesce(DisplayedUser, dynamic([]))
| join kind=leftouter (ValuesForServer) on CorrelationMatchId
| extend ["Server"] = coalesce(DisplayedServer, dynamic([]))
| extend ContextComplete = coalesce(DistinctUserCount, 0) <= 1000 and coalesce(DistinctServerCount, 0) <= 1000
| project ["WindowStart"], ["WindowEnd"], ["Case"], ["User"], ["Server"], ["RuleCount"], ["ContextComplete"]
};
let Observed=Actual()
| project WindowEnd, Case=tostring(Case), RuleCount, Users=tostring(array_sort_asc(User)), Servers=tostring(array_sort_asc(Server)), UserCount=array_length(User), ServerCount=array_length(Server), ContextComplete;
let Expected=datatable(WindowEnd:datetime, Case:string, RuleCount:long, User:dynamic, Server:dynamic, ContextComplete:bool) [
datetime(2026-01-01T12:00:00Z), "mixed", 2, dynamic(["A", "B"]), dynamic(["a", "b"]), true
]
| project WindowEnd, Case, RuleCount, Users=tostring(array_sort_asc(User)), Servers=tostring(array_sort_asc(Server)), UserCount=array_length(User), ServerCount=array_length(Server), ContextComplete;
union (Observed | extend Delta=1), (Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowEnd, Case, RuleCount, Users, Servers, UserCount, ServerCount, ContextComplete
| where Delta!=0
