| where isnotnull(EventTime_1) and isnotempty(GroupCase) and isnotempty(GroupHost));
let CountedActorActivity = materialize(ValueCountSources
| where isnotempty(CountedActor)
| summarize by GroupCase, GroupHost, CountedActor, EventTime_1
| sort by GroupCase asc, GroupHost asc, CountedActor asc, EventTime_1 asc
// Repeated values whose inclusive active intervals overlap contribute only once.
| extend CountedActorStarts = isnull(prev(EventTime_1)) or GroupCase != prev(GroupCase) or GroupHost != prev(GroupHost) or CountedActor != prev(CountedActor) or EventTime_1 > prev(EventTime_1) + 5m,
    CountedActorEnds = isnull(next(EventTime_1)) or GroupCase != next(GroupCase) or GroupHost != next(GroupHost) or CountedActor != next(CountedActor) or next(EventTime_1) > EventTime_1 + 5m);
let CountedTargetActivity = materialize(ValueCountSources
| where isnotempty(CountedTarget)
