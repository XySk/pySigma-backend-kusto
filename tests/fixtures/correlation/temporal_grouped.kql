| summarize MatchesSourcerule = countif(SourceRule == "source-rule") > 0, MatchesOtherrule = countif(SourceRule == "other-rule") > 0, MatchesThirdrule = countif(SourceRule == "third-rule") > 0 by GroupCase, GroupHost, EventTime_1
| sort by GroupCase asc, GroupHost asc, EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1)) or GroupCase != prev(GroupCase) or GroupHost != prev(GroupHost)
| scan declare (LastSourceruleTime:datetime, LastOtherruleTime:datetime, LastThirdruleTime:datetime) with (
    step PresenceWindow: true =>
        LastSourceruleTime = iff(MatchesSourcerule, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastSourceruleTime)),
        LastOtherruleTime = iff(MatchesOtherrule, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastOtherruleTime)),
        LastThirdruleTime = iff(MatchesThirdrule, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastThirdruleTime));
