// Only source-match timestamps evaluate; expiration never creates an anchor.
| extend HasSourcerule = isnotnull(LastSourceruleTime) and LastSourceruleTime >= EventTime_1 - 5m, HasOtherrule = isnotnull(LastOtherruleTime) and LastOtherruleTime >= EventTime_1 - 5m, HasThirdrule = isnotnull(LastThirdruleTime) and LastThirdruleTime >= EventTime_1 - 5m
