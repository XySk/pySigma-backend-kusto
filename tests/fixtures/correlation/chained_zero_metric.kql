// Public-conversion comparison; execution status is hash-scoped in RUNTIME.md.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
// Missing raw values establish child anchors with ValueCount 0.
// Metric zero is an available nonempty value to the parent; expiry adds no anchor.
let Events=datatable(Timestamp:string, User:dynamic, Marker:string) [
    "2026-01-01T12:00:00Z", dynamic(null), "E",
    "2026-01-01T12:01:00Z", dynamic(""), "E",
    "invalid", dynamic(null), "E",
    "2026-01-01T12:02:00Z", dynamic("ignored"), "ignored"
]
// Normalize Events scalar fixture inputs explicitly.
| extend Timestamp=todatetime(Timestamp), User=tostring(User);
let Actual = () {
let C = () {
let ValueCountSources = materialize(Events
| where Marker =~ "E"
| project EventTime_1 = ["Timestamp"], CountedUser = ["User"]
| where isnotnull(EventTime_1));
let CountedUserActivity = materialize(ValueCountSources
| where isnotempty(CountedUser)
| summarize by CountedUser, EventTime_1
| sort by CountedUser asc, EventTime_1 asc
// Repeated values whose inclusive active intervals overlap contribute only once.
| extend CountedUserStarts = isnull(prev(EventTime_1)) or CountedUser != prev(CountedUser) or EventTime_1 > prev(EventTime_1) + 5m,
    CountedUserEnds = isnull(next(EventTime_1)) or CountedUser != next(CountedUser) or next(EventTime_1) > EventTime_1 + 5m);
union (ValueCountSources | summarize by EventTime_1
| project ValueBoundaryTime = EventTime_1, ValueBoundaryOrder = 1, CountedUserDelta = 0),
(CountedUserActivity | where CountedUserStarts
| project ValueBoundaryTime = EventTime_1, ValueBoundaryOrder = 0, CountedUserDelta = 1),
(CountedUserActivity | where CountedUserEnds
| project ValueBoundaryTime = EventTime_1 + 5m, ValueBoundaryOrder = 2, CountedUserDelta = -1)
// All interval starts precede anchors; equal-time expirations follow them.
| sort by ValueBoundaryTime asc, ValueBoundaryOrder asc
| extend ValueCount = row_cumsum(CountedUserDelta)
| where ValueBoundaryOrder == 1
| where ValueCount == 0
| project WindowStart = ValueBoundaryTime - 5m, WindowEnd = ValueBoundaryTime, ValueCount
};
let ValueCountSources = materialize(C()
| project EventTime = ["WindowEnd"], CountedValueCount = ["ValueCount"]
| where isnotnull(EventTime));
let CountedValueCountActivity = materialize(ValueCountSources
| where isnotempty(CountedValueCount)
| summarize by CountedValueCount, EventTime
| sort by CountedValueCount asc, EventTime asc
// Repeated values whose inclusive active intervals overlap contribute only once.
| extend CountedValueCountStarts = isnull(prev(EventTime)) or CountedValueCount != prev(CountedValueCount) or EventTime > prev(EventTime) + 5m,
    CountedValueCountEnds = isnull(next(EventTime)) or CountedValueCount != next(CountedValueCount) or next(EventTime) > EventTime + 5m);
union (ValueCountSources | summarize by EventTime
| project ValueBoundaryTime = EventTime, ValueBoundaryOrder = 1, CountedValueCountDelta = 0),
(CountedValueCountActivity | where CountedValueCountStarts
| project ValueBoundaryTime = EventTime, ValueBoundaryOrder = 0, CountedValueCountDelta = 1),
(CountedValueCountActivity | where CountedValueCountEnds
| project ValueBoundaryTime = EventTime + 5m, ValueBoundaryOrder = 2, CountedValueCountDelta = -1)
// All interval starts precede anchors; equal-time expirations follow them.
| sort by ValueBoundaryTime asc, ValueBoundaryOrder asc
| extend ValueCount = row_cumsum(CountedValueCountDelta)
| where ValueBoundaryOrder == 1
| where ValueCount == 1
| project WindowStart = ValueBoundaryTime - 5m, WindowEnd = ValueBoundaryTime, ValueCount
};
let Expected = datatable(WindowStart:datetime, WindowEnd:datetime, ValueCount:long) [
    datetime(2026-01-01T11:55:00Z), datetime(2026-01-01T12:00:00Z), 1,
    datetime(2026-01-01T11:56:00Z), datetime(2026-01-01T12:01:00Z), 1
];
union (Actual() | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, ValueCount
| where Delta != 0
