// Public-conversion comparison; execution status is hash-scoped in RUNTIME.md.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
// Each physical input row satisfies two searches in each of two source rules.
let Events=datatable(Timestamp:string, Marker:string) [
    "2026-01-01T12:00:00Z", "match",
    "2026-01-01T12:00:00Z", "match",
    "2026-01-01T12:01:00Z", "match"
]
// Normalize Events scalar fixture inputs explicitly.
| extend Timestamp=todatetime(Timestamp);
let Actual = () {
let SourceMatchArrivals = union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"])),
(Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"])),
(Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"])),
(Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]))
| where isnotnull(EventTime_1)
| summarize SourceMatchCount = count() by EventTime_1;
union (SourceMatchArrivals
| project CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project CountBoundaryTime = EventTime_1 + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta)
| where CountBoundaryOrder == 0
| where EventCount >= 2
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, EventCount
};
let Expected = datatable(WindowStart:datetime, WindowEnd:datetime, EventCount:long) [
    datetime(2026-01-01T11:55:00Z), datetime(2026-01-01T12:00:00Z), 8,
    datetime(2026-01-01T11:56:00Z), datetime(2026-01-01T12:01:00Z), 12
];
union (Actual() | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, EventCount
| where Delta != 0
