// Public-conversion comparison; execution status is hash-scoped in RUNTIME.md.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
let Events = datatable(ProcessTime:datetime, Computer:string, Size:long, Marker:string) [
    datetime(2026-01-01T12:00:00Z), "h", 2, "match",
    datetime(2026-01-01T12:00:00Z), "h", 2, "match"
];
let NetworkEvents = datatable(NetworkTime:datetime, Server:string, Length:long, Marker:string) [
    datetime(2026-01-01T12:00:00Z), "h", 8, "match",
    datetime(2026-01-01T12:05:00Z), "h", 14, "match"
];
let Expected = datatable(WindowStart:datetime, WindowEnd:datetime, Machine:string, ValueAvg:real) [
    datetime(2026-01-01T11:55:00Z), datetime(2026-01-01T12:00:00Z), "h", 4.0,
    datetime(2026-01-01T12:00:00Z), datetime(2026-01-01T12:05:00Z), "h", 6.5
];
let Actual = () {
let AverageObservations = union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["ProcessTime"]), GroupMachine = ["Computer"], MeasuredMeasurement = ["Size"]),
(NetworkEvents
| where Marker =~ "match"
| project EventTime_1 = todatetime(["NetworkTime"]), GroupMachine = ["Server"], MeasuredMeasurement = ["Length"])
| where isnotnull(EventTime_1) and isnotempty(GroupMachine);
AverageObservations
| summarize by GroupMachine, AverageWindowEnd = EventTime_1, AverageTimeBin = bin(EventTime_1, 5m)
| join kind=inner (
AverageObservations
| extend AverageTimeBin = pack_array(bin(EventTime_1, 5m), bin(EventTime_1, 5m) + 5m)
| mv-expand AverageTimeBin to typeof(datetime)
) on GroupMachine, AverageTimeBin
| where EventTime_1 between ((AverageWindowEnd - 5m) .. AverageWindowEnd)
| summarize ValueAvg = avgif(toreal(MeasuredMeasurement), isfinite(toreal(MeasuredMeasurement))) by AverageWindowEnd, GroupMachine
| where isfinite(ValueAvg) and ValueAvg >= 0
| project WindowStart = AverageWindowEnd - 5m, WindowEnd = AverageWindowEnd, ["Machine"] = GroupMachine, ValueAvg
};
union (Actual() | extend Machine=tostring(Machine) | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Machine, ValueAvg
| where Delta != 0
