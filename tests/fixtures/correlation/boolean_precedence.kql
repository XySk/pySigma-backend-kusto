// Generated through SigmaCollection.from_yaml and KustoBackend.convert.
// Run the complete file. PASS = zero output rows (exact summary multiset).
// Runtime evidence and engine version: RUNTIME.md.
let Events = datatable(Timestamp:datetime, Case:string, Marker:string) [

    datetime(2026-01-01T12:00:00Z), "negative-anchor", "A",
    datetime(2026-01-01T12:01:00Z), "negative-anchor", "C",
    datetime(2026-01-01T12:02:00Z), "negative-anchor", "B",
    datetime(2026-01-01T12:00:00Z), "B-alone", "B",
    datetime(2026-01-01T12:01:00Z), "B-alone", "C",
    datetime(2026-01-01T12:00:00Z), "C-alone", "C"

];
let Actual = () {
union (Events
| where Marker =~ "A"
| project EventTime_1 = todatetime(["Timestamp"]), GroupCase = ["Case"], SourceRule = "A"),
(Events
| where Marker =~ "B"
| project EventTime_1 = todatetime(["Timestamp"]), GroupCase = ["Case"], SourceRule = "B"),
(Events
| where Marker =~ "C"
| project EventTime_1 = todatetime(["Timestamp"]), GroupCase = ["Case"], SourceRule = "C")
| where isnotnull(EventTime_1) and isnotempty(GroupCase)
// Batch simultaneous source matches before updating inclusive trailing presence.
| summarize MatchesA = countif(SourceRule == "A") > 0, MatchesB = countif(SourceRule == "B") > 0, MatchesC = countif(SourceRule == "C") > 0 by GroupCase, EventTime_1
| sort by GroupCase asc, EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1)) or GroupCase != prev(GroupCase)
| scan declare (LastATime:datetime, LastBTime:datetime, LastCTime:datetime) with (
    step PresenceWindow: true =>
        LastATime = iff(MatchesA, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastATime)),
        LastBTime = iff(MatchesB, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastBTime)),
        LastCTime = iff(MatchesC, EventTime_1, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastCTime));
)
// Only source-match timestamps evaluate; expiration never creates an anchor.
| extend HasA = isnotnull(LastATime) and LastATime >= EventTime_1 - 5m, HasB = isnotnull(LastBTime) and LastBTime >= EventTime_1 - 5m, HasC = isnotnull(LastCTime) and LastCTime >= EventTime_1 - 5m
| extend RuleCount = tolong(HasA) + tolong(HasB) + tolong(HasC)
| where (HasA or (HasB and not(HasC)))
| project WindowStart = EventTime_1 - 5m, WindowEnd = EventTime_1, ["Case"] = GroupCase, RuleCount
};
let Expected = datatable(WindowEnd:datetime, Case:string, RuleCount:long) [

    datetime(2026-01-01T12:00:00Z), "negative-anchor", 1,
    datetime(2026-01-01T12:01:00Z), "negative-anchor", 2,
    datetime(2026-01-01T12:02:00Z), "negative-anchor", 3,
    datetime(2026-01-01T12:00:00Z), "B-alone", 1

]
| extend WindowStart = WindowEnd - 5m;
union (Actual() | extend Case=tostring(Case) | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Case, RuleCount
| where Delta != 0
