let Specialized = () {
let FailedLogonBursts = () {
Events
| where Marker =~ "failure"
| project EventTime_1 = ["Timestamp"], GroupUser = ["User"]
| where isnotnull(EventTime_1) and isnotempty(GroupUser)
// Preserve individual source matches, including timestamp ties, before the threshold lookup.
| sort by GroupUser asc, EventTime_1 asc
| extend ThresholdPredecessorTime = prev(EventTime_1, 9)
| where ThresholdPredecessorTime >= EventTime_1 - 5m and GroupUser == prev(GroupUser, 9)
| distinct EventTime_1, GroupUser
| project WindowStart = EventTime_1 - 5m, WindowEnd = EventTime_1, ["User"] = GroupUser
};
// Strict sequence: "failed-logon-bursts" -> "successful-logon". Total inclusive span: 3m.
union (FailedLogonBursts()
| extend EventTime_1 = ["WindowEnd"], GroupUser = ["User"]
| where isnotnull(EventTime_1) and isnotempty(GroupUser)
| extend SourceRule = "failed-logon-bursts"),
(Events
| where Marker =~ "success"
| extend EventTime_1 = ["Timestamp"], GroupUser = ["User"]
| where isnotnull(EventTime_1) and isnotempty(GroupUser)
| extend SourceRule = "successful-logon")
// Batch equal timestamps: simultaneous source matches cannot advance strict sequence positions.
| summarize HasFailedLogonBursts = countif(SourceRule == "failed-logon-bursts") > 0, HasSuccessfulLogon = countif(SourceRule == "successful-logon") > 0 by EventTime_1, GroupUser
| sort by GroupUser asc, EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1)) or GroupUser != prev(GroupUser)
// Read preceding timestamp state for every assignment; preserve viable earlier prefixes.
| scan declare (LastFailedLogonBurstTime:datetime = datetime(null), CompleteNow:bool = false) with (
    step SequenceState: true =>
        CompleteNow = not(NewCorrelationGroup) and HasSuccessfulLogon and isnotnull(SequenceState.LastFailedLogonBurstTime) and SequenceState.LastFailedLogonBurstTime >= EventTime_1 - 3m,
        LastFailedLogonBurstTime = iff(HasFailedLogonBursts, EventTime_1, iff(NewCorrelationGroup, datetime(null), SequenceState.LastFailedLogonBurstTime));
)
| where CompleteNow
| project WindowStart = EventTime_1 - 3m, WindowEnd = EventTime_1, ["User"] = GroupUser, RuleCount = tolong(2)
};
let General = () {
let FailedLogonBursts = () {
let SourceMatchArrivals = Events
| where Marker =~ "failure"
| project EventTime_1 = ["Timestamp"], GroupUser = ["User"]
| where isnotnull(EventTime_1) and isnotempty(GroupUser)
| summarize SourceMatchCount = count() by EventTime_1, GroupUser;
union (SourceMatchArrivals
| project GroupUser, CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupUser, CountBoundaryTime = EventTime_1 + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupUser asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupUser != prev(GroupUser))
| where CountBoundaryOrder == 0
| where EventCount >= 10
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, ["User"] = GroupUser, EventCount
};
// Strict sequence: "failed-logon-bursts" -> "successful-logon". Total inclusive span: 3m.
union (FailedLogonBursts()
| extend EventTime_1 = ["WindowEnd"], GroupUser = ["User"]
| where isnotnull(EventTime_1) and isnotempty(GroupUser)
| extend SourceRule = "failed-logon-bursts"),
(Events
| where Marker =~ "success"
| extend EventTime_1 = ["Timestamp"], GroupUser = ["User"]
| where isnotnull(EventTime_1) and isnotempty(GroupUser)
| extend SourceRule = "successful-logon")
// Batch equal timestamps: simultaneous source matches cannot advance strict sequence positions.
| summarize HasFailedLogonBursts = countif(SourceRule == "failed-logon-bursts") > 0, HasSuccessfulLogon = countif(SourceRule == "successful-logon") > 0 by EventTime_1, GroupUser
| sort by GroupUser asc, EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1)) or GroupUser != prev(GroupUser)
// Read preceding timestamp state for every assignment; preserve viable earlier prefixes.
| scan declare (LatestFailedLogonBurstsStart:datetime = datetime(null), CompleteNow:bool = false) with (
    step SequenceState: true =>
        CompleteNow = not(NewCorrelationGroup) and HasSuccessfulLogon and isnotnull(SequenceState.LatestFailedLogonBurstsStart) and SequenceState.LatestFailedLogonBurstsStart >= EventTime_1 - 3m,
        LatestFailedLogonBurstsStart = iff(HasFailedLogonBursts, EventTime_1, iff(NewCorrelationGroup, datetime(null), SequenceState.LatestFailedLogonBurstsStart));
)
| where CompleteNow
| project WindowStart = EventTime_1 - 3m, WindowEnd = EventTime_1, ["User"] = GroupUser, RuleCount = tolong(2)
};
