// Public-conversion comparison; execution status is hash-scoped in RUNTIME.md.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
let Events=datatable(Timestamp:datetime,Amount:int,Marker:string)[
datetime(2026-01-01T12:00:00Z),1,"match",
datetime(2026-01-01T12:00:00Z),2,"match",
datetime(2026-01-01T12:00:00Z),100,"match",
datetime(2026-01-01T12:00:00Z),200,"match"
];
let Actual=(){
let PercentileObservations = Events
| where Marker =~ "match"
| project EventTime_1 = ["Timestamp"], MeasuredAmount = ["Amount"]
| where isnotnull(EventTime_1);
let PercentileWindowValues = materialize(
PercentileObservations
| project PercentileWindowEnd = EventTime_1, PercentileTimeBin = bin(EventTime_1, 5m)
| distinct *
| join kind=inner (
PercentileObservations
| where isnotnull(MeasuredAmount)
| extend PercentileTimeBin = pack_array(bin(EventTime_1, 5m), bin(EventTime_1, 5m) + 5m)
| mv-expand PercentileTimeBin to typeof(datetime)
) on PercentileTimeBin
| where EventTime_1 between ((PercentileWindowEnd - 5m) .. PercentileWindowEnd)
| project PercentileWindowEnd, MeasuredAmount
);
PercentileWindowValues
| join kind=inner (
PercentileWindowValues | summarize PercentilePopulation = count() by PercentileWindowEnd
) on PercentileWindowEnd
| project PercentileWindowEnd, MeasuredAmount, PercentilePopulation
| sort by PercentileWindowEnd asc, MeasuredAmount asc
| serialize PercentileRank = row_number(1, PercentileWindowEnd != prev(PercentileWindowEnd))
| where PercentileRank == max_of(1, (PercentilePopulation / 100) * 50 + tolong(ceiling(toreal((PercentilePopulation % 100) * 50) / 100.0)))
| extend ValuePercentile = MeasuredAmount
| where ValuePercentile >= 0
| project WindowStart = PercentileWindowEnd - 5m, WindowEnd = PercentileWindowEnd, ValuePercentile
};
let Expected=datatable(WindowStart:datetime,WindowEnd:datetime,ValuePercentile:int)[datetime(2026-01-01T11:55:00Z),datetime(2026-01-01T12:00:00Z),2];
union (Actual() | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, ValuePercentile
| where Delta != 0
