// Public-conversion comparison; execution status is hash-scoped in RUNTIME.md.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
let Events=datatable(Timestamp:datetime,Amount:decimal,Marker:string) [
 datetime(2026-01-01T00:00:00),decimal(0.1),"match",
 datetime(2026-01-01T00:00:00),decimal(0.2),"match",
 datetime(2026-01-01T00:01:00),decimal(null),"match"
];
let Expected=datatable(WindowEnd:datetime,ValueAvg:real) [
 datetime(2026-01-01T00:00:00),0.15000000000000002,
 datetime(2026-01-01T00:01:00),0.15000000000000002
] | extend WindowStart=WindowEnd-5m;
let Actual=(){
let AverageObservations = union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]), MeasuredAmount = ["Amount"])
| where isnotnull(EventTime_1);
AverageObservations
| summarize by AverageWindowEnd = EventTime_1, AverageTimeBin = bin(EventTime_1, 5m)
| join kind=inner (
AverageObservations
| extend AverageTimeBin = pack_array(bin(EventTime_1, 5m), bin(EventTime_1, 5m) + 5m)
| mv-expand AverageTimeBin to typeof(datetime)
) on AverageTimeBin
| where EventTime_1 between ((AverageWindowEnd - 5m) .. AverageWindowEnd)
| summarize ValueAvg = avgif(toreal(MeasuredAmount), isfinite(toreal(MeasuredAmount))) by AverageWindowEnd
| where isfinite(ValueAvg) and ValueAvg != 0.15
| project WindowStart = AverageWindowEnd - 5m, WindowEnd = AverageWindowEnd, ValueAvg
};
union (Actual() | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, ValueAvg
| where Delta != 0
