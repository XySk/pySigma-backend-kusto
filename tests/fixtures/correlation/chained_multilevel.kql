| where _sigma_identity_hits == _sigma_identity_count and _sigma_identity_hits == _sigma_identity_other_count
| summarize _sigma_identity_identity = min(_sigma_identity_other_id) by _sigma_group_component_id;
let _sigma_group_identity_cache = materialize(_sigma_group_components | join kind=inner (_sigma_identity_relation) on _sigma_group_component_id
| project _sigma_group_row, _sigma_group_component, _sigma_identity_identity);
let _sigma_group_lookup = materialize(_sigma_group_input | join kind=inner (_sigma_group_identity_cache | where _sigma_group_component == 0) on _sigma_group_row
| summarize _sigma_group_original = take_any(_sigma_group_0) by _sigma_identity_identity);
let _sigma_types = _sigma_group_input
| join kind=inner (_sigma_group_identity_cache | where _sigma_group_component == 0 | project _sigma_group_row, _sigma_group_key = _sigma_identity_identity) on _sigma_group_row
| extend _sigma_group_0 = _sigma_group_key
| where isnotnull(_sigma_timestamp) and isnotempty(_sigma_group_0)
| summarize by _sigma_timestamp, _sigma_group_0, _sigma_rule;
let _sigma_sequence_0 = _sigma_types
| where _sigma_rule == "M"
| project _sigma_sequence_start = _sigma_timestamp, _sigma_sequence_end = _sigma_timestamp, _sigma_group_0;
let _sigma_sequence_1 = _sigma_sequence_0
| extend _sigma_bin = pack_array(bin(_sigma_sequence_start, 4m), bin(_sigma_sequence_start, 4m) + 4m)
| mv-expand _sigma_bin to typeof(datetime)
| join kind=inner (
    _sigma_types
    | where _sigma_rule == "D"
    | project _sigma_timestamp, _sigma_group_0, _sigma_bin = bin(_sigma_timestamp, 4m)
) on _sigma_group_0, _sigma_bin
| where _sigma_timestamp > _sigma_sequence_end and _sigma_timestamp <= _sigma_sequence_start + 4m
| summarize _sigma_sequence_start = max(_sigma_sequence_start) by _sigma_sequence_end = _sigma_timestamp, _sigma_group_0;
_sigma_sequence_1
| project WindowStart = _sigma_sequence_end - 4m, WindowEnd = _sigma_sequence_end, ["Tenant"] = _sigma_group_0, RuleCount = tolong(2)
| join kind=inner (_sigma_group_lookup | project ["Tenant"] = _sigma_identity_identity, _sigma_group_original) on ["Tenant"]
| extend ["Tenant"] = _sigma_group_original[1]
| project-away _sigma_group_original
| project ["WindowStart"], ["WindowEnd"], ["Tenant"], ["RuleCount"]
};
let Expected = datatable(WindowStart:datetime, WindowEnd:datetime, Tenant:string, RuleCount:long) [
    datetime(2026-01-01T12:03:00Z), datetime(2026-01-01T12:07:00Z), "lookback", 2
];
union (Actual() | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Tenant, RuleCount
| where Delta != 0
