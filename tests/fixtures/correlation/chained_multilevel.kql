// Public-conversion comparison; execution status is hash-scoped in RUNTIME.md.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
// C ends at 12:00 (count 2) and 12:03 (count 3); both child spans are exact.
// M at 12:03 counts {2,3} over [12:00,12:03]. P completes at 12:07 exactly.
// D at 12:03 ties M and fails; one tick beyond 12:07 exceeds the total span.
// Removing E at 11:58 removes the final result: the path needs 2m+3m+4m = 9m.
let Events=datatable(ProcessTime:string, ProcessCase:string, ProcessHost:string, Marker:string) [
    "2026-01-01T11:58:00Z", "lookback", "host", "E",
    "2026-01-01T12:00:00Z", "lookback", "host", "E",
    "2026-01-01T12:03:00Z", "lookback", "host", "E",
    "2026-01-01T12:03:00Z", "lookback", "host", "E",
    "2026-01-01T12:03:00Z", "lookback", "host", "E",
    "invalid", "lookback", "host", "E",
    "2026-01-01T12:03:00Z", "lookback", "", "E"
]
// Normalize Events scalar fixture inputs explicitly.
| extend ProcessTime=todatetime(ProcessTime);
let NetworkEvents=datatable(NetworkTime:string, NetworkScope:string, Marker:string) [
    "2026-01-01T12:03:00Z", "lookback", "D",
    "2026-01-01T12:07:00Z", "lookback", "D",
    "2026-01-01T12:07:00.0000001Z", "lookback", "D",
    "2026-01-01T12:08:00Z", "lookback", "ignored"
]
// Normalize NetworkEvents scalar fixture inputs explicitly.
| extend NetworkTime=todatetime(NetworkTime);
let Actual = () {
let M = () {
let C = () {
let SourceMatchArrivals = union (Events
| where Marker =~ "E"
| project EventTime_1 = todatetime(["ProcessTime"]), GroupCase = ["ProcessCase"], GroupHost = ["ProcessHost"])
| where isnotnull(EventTime_1) and isnotempty(GroupCase) and isnotempty(GroupHost)
| summarize SourceMatchCount = count() by EventTime_1, GroupCase, GroupHost;
union (SourceMatchArrivals
| project GroupCase, GroupHost, CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupCase, GroupHost, CountBoundaryTime = EventTime_1 + 2m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupCase asc, GroupHost asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupCase != prev(GroupCase) or GroupHost != prev(GroupHost))
| where CountBoundaryOrder == 0
| where EventCount >= 2
| project WindowStart = CountBoundaryTime - 2m, WindowEnd = CountBoundaryTime, ["Case"] = GroupCase, ["Host"] = GroupHost, EventCount
};
let ValueCountSources = materialize(union (C()
| project EventTime = todatetime(["WindowEnd"]), GroupTenant = ["Case"], CountedEventCount = ["EventCount"])
| where isnotnull(EventTime) and isnotempty(GroupTenant));
let CountedEventCountActivity = materialize(ValueCountSources
| where isnotempty(CountedEventCount)
| summarize by GroupTenant, CountedEventCount, EventTime
| sort by GroupTenant asc, CountedEventCount asc, EventTime asc
// Repeated values whose inclusive active intervals overlap contribute only once.
| extend CountedEventCountStarts = isnull(prev(EventTime)) or GroupTenant != prev(GroupTenant) or CountedEventCount != prev(CountedEventCount) or EventTime > prev(EventTime) + 3m,
    CountedEventCountEnds = isnull(next(EventTime)) or GroupTenant != next(GroupTenant) or CountedEventCount != next(CountedEventCount) or next(EventTime) > EventTime + 3m);
union (ValueCountSources | summarize by GroupTenant, EventTime
| project GroupTenant, ValueBoundaryTime = EventTime, ValueBoundaryOrder = 1, CountedEventCountDelta = 0),
(CountedEventCountActivity | where CountedEventCountStarts
| project GroupTenant, ValueBoundaryTime = EventTime, ValueBoundaryOrder = 0, CountedEventCountDelta = 1),
(CountedEventCountActivity | where CountedEventCountEnds
| project GroupTenant, ValueBoundaryTime = EventTime + 3m, ValueBoundaryOrder = 2, CountedEventCountDelta = -1)
// All interval starts precede anchors; equal-time expirations follow them.
| sort by GroupTenant asc, ValueBoundaryTime asc, ValueBoundaryOrder asc
| extend ValueCount = row_cumsum(CountedEventCountDelta, GroupTenant != prev(GroupTenant))
| where ValueBoundaryOrder == 1
| where ValueCount >= 2
| project WindowStart = ValueBoundaryTime - 3m, WindowEnd = ValueBoundaryTime, ["Tenant"] = GroupTenant, ValueCount
};
// Strict sequence: "M" -> "D". Total inclusive span: 4m.
union (M()
| extend EventTime_1 = todatetime(["WindowEnd"]), GroupTenant = ["Tenant"]
| extend SourceRule = "M"),
(NetworkEvents
| where Marker =~ "D"
| extend EventTime_1 = todatetime(["NetworkTime"]), GroupTenant = ["NetworkScope"]
| extend SourceRule = "D")
| where isnotnull(EventTime_1) and isnotempty(GroupTenant)
// Batch equal timestamps: simultaneous source matches cannot advance strict sequence positions.
| summarize HasM = countif(SourceRule == "M") > 0, HasD = countif(SourceRule == "D") > 0 by EventTime_1, GroupTenant
| sort by GroupTenant asc, EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1)) or GroupTenant != prev(GroupTenant)
// Read preceding timestamp state for every assignment; preserve viable earlier prefixes.
| scan declare (LatestMStart:datetime = datetime(null), CompleteNow:bool = false) with (
    step SequenceState: true =>
        CompleteNow = not(NewCorrelationGroup) and HasD and isnotnull(SequenceState.LatestMStart) and SequenceState.LatestMStart >= EventTime_1 - 4m,
        LatestMStart = iff(HasM, EventTime_1, iff(NewCorrelationGroup, datetime(null), SequenceState.LatestMStart));
)
| where CompleteNow
| project WindowStart = EventTime_1 - 4m, WindowEnd = EventTime_1, ["Tenant"] = GroupTenant, RuleCount = tolong(2)
};
let Expected = datatable(WindowStart:datetime, WindowEnd:datetime, Tenant:string, RuleCount:long) [
    datetime(2026-01-01T12:03:00Z), datetime(2026-01-01T12:07:00Z), "lookback", 2
];
union (Actual() | extend Tenant=tostring(Tenant) | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Tenant, RuleCount
| where Delta != 0
