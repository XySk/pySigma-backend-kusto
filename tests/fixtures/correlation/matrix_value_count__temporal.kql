// Public-conversion comparison; execution status is hash-scoped in RUNTIME.md.
let Events=datatable(Timestamp:datetime,Marker:string,Amount:real) [
 datetime(2026-01-01T12:00:00Z),"match",2.5
];
let Actual=(){
let Child = () {
let ContextSummary = () {
let ValueCountSources = materialize(Events
| where Marker =~ "match"
| project EventTime_1 = ["Timestamp"], CountedAmount = ["Amount"]
| where isnotnull(EventTime_1));
let CountedAmountActivity = materialize(ValueCountSources
| where isnotempty(CountedAmount)
| summarize by CountedAmount, EventTime_1
| sort by CountedAmount asc, EventTime_1 asc
// Repeated values whose inclusive active intervals overlap contribute only once.
| extend CountedAmountStarts = isnull(prev(EventTime_1)) or (CountedAmount != prev(CountedAmount) and not(isnan(CountedAmount) and isnan(prev(CountedAmount)))) or EventTime_1 > prev(EventTime_1) + 1m,
    CountedAmountEnds = isnull(next(EventTime_1)) or (CountedAmount != next(CountedAmount) and not(isnan(CountedAmount) and isnan(next(CountedAmount)))) or next(EventTime_1) > EventTime_1 + 1m);
union (ValueCountSources | summarize by EventTime_1
| project ValueBoundaryTime = EventTime_1, ValueBoundaryOrder = 1, CountedAmountDelta = 0),
(CountedAmountActivity | where CountedAmountStarts
| project ValueBoundaryTime = EventTime_1, ValueBoundaryOrder = 0, CountedAmountDelta = 1),
(CountedAmountActivity | where CountedAmountEnds
| project ValueBoundaryTime = EventTime_1 + 1m, ValueBoundaryOrder = 2, CountedAmountDelta = -1)
// All interval starts precede anchors; equal-time expirations follow them.
| sort by ValueBoundaryTime asc, ValueBoundaryOrder asc
| extend ValueCount = row_cumsum(CountedAmountDelta)
| where ValueBoundaryOrder == 1
| where ValueCount >= 1
| project WindowStart = ValueBoundaryTime - 1m, WindowEnd = ValueBoundaryTime, ValueCount
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId = row_number());
let WindowSourceMatches =
CorrelationMatches | project CorrelationMatchId, CompletionTime = WindowEnd, ContextPartition = 1
| join kind=inner (
Events
| where Marker =~ "match"
| extend ContextEventTime = ["Timestamp"], ContextAmount = ["Amount"]
| where isnotnull(ContextEventTime)
| extend ContextSourceRule = "source-rule"
| project ContextEventTime, ContextSourceRule, ContextAmount, ContextPartition = 1
) on ContextPartition
| where ContextEventTime between ((CompletionTime - 1m) .. CompletionTime);
let CompleteContextRelationships = materialize(WindowSourceMatches
| project CorrelationMatchId, ContextAmount
| distinct *);
union (CorrelationMatches | extend ContextRowKind = "Summary"), (CorrelationMatches | join kind=inner (CompleteContextRelationships) on CorrelationMatchId | extend ContextRowKind = "ContextEvidence")
};
let ChildResults = materialize(Child());
let ContextSummary = () {
ChildResults
| where ["ContextRowKind"] == "Summary"
| project EventTime = ["WindowEnd"], SourceRule = "child"
| where isnotnull(EventTime)
// Batch simultaneous source matches before updating inclusive trailing presence.
| summarize MatchesChild = countif(SourceRule == "child") > 0 by EventTime
| sort by EventTime asc
| extend NewCorrelationGroup = isnull(prev(EventTime))
| scan declare (LastChildTime:datetime) with (
    step PresenceWindow: true =>
        LastChildTime = iff(MatchesChild, EventTime, iff(NewCorrelationGroup, datetime(null), PresenceWindow.LastChildTime));
)
// Only source-match timestamps evaluate; expiration never creates an anchor.
| extend HasChild = isnotnull(LastChildTime) and LastChildTime >= EventTime - 5m
| extend RuleCount = tolong(HasChild)
| where RuleCount >= 1
| project WindowStart = EventTime - 5m, WindowEnd = EventTime, RuleCount
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId = row_number());
let WindowSourceMatches =
CorrelationMatches | project CorrelationMatchId, CompletionTime = WindowEnd, ContextPartition = 1
| join kind=inner (
ChildResults | where ["ContextRowKind"] == "Summary"
| project-away ["ContextAmount"]
| join kind=leftouter (ChildResults | where ["ContextRowKind"] == "ContextEvidence" | project ["CorrelationMatchId"], ["ContextAmount"], HasContextEvidence = true) on ["CorrelationMatchId"]
| extend ContextEventTime = ["WindowEnd"], ContextAmount = ["ContextAmount"]
| where isnotnull(ContextEventTime)
| extend ContextSourceRule = "child"
| project ContextEventTime, ContextSourceRule, ContextAmount, HasContextEvidence, ContextPartition = 1
) on ContextPartition
| where ContextEventTime between ((CompletionTime - 5m) .. CompletionTime);
let CompleteContextRelationships = WindowSourceMatches
| where HasContextEvidence
| project CorrelationMatchId, ContextAmount
| distinct *;
let ValuesForAmount = CompleteContextRelationships
| where isnotnull(ContextAmount)
| summarize by CorrelationMatchId, ContextAmount
| summarize DisplayedAmount = make_list(ContextAmount, 1000), DistinctAmountCount = count() by CorrelationMatchId;
CorrelationMatches
| join kind=leftouter (ValuesForAmount) on CorrelationMatchId
| extend ["Amount"] = coalesce(DisplayedAmount, dynamic([]))
| extend ContextComplete = coalesce(DistinctAmountCount, 0) <= 1000
| project ["WindowStart"], ["WindowEnd"], ["Amount"], ["RuleCount"], ["ContextComplete"]
};
let Observed=Actual() | project WindowStart,WindowEnd,Metric=toreal(RuleCount);
let Expected=datatable(WindowStart:datetime,WindowEnd:datetime,Metric:real) [
 datetime(2026-01-01T11:55:00Z),datetime(2026-01-01T12:00:00Z),1
];
union (Observed | extend Delta=1),(Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowStart,WindowEnd,Metric
| where Delta!=0
