// Public-conversion comparison; execution status is hash-scoped in RUNTIME.md.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
let Events = datatable(Timestamp:datetime, Host:string, Amount:long, Marker:string) [
datetime(2026-01-01T12:00:00Z), "alice", 1, "match",
datetime(2026-01-01T12:00:00Z), "alice", 2, "match",
datetime(2026-01-01T12:00:00Z), "alice", 100, "match",
datetime(2026-01-01T12:00:00Z), "alice", 200, "match",
datetime(2026-01-01T12:01:00Z), "alice", 100, "match"
];
let Actual = () {
let Sum = () {
let Child = () {
let PercentileObservations = union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]), GroupHost = ["Host"], MeasuredAmount = ["Amount"])
| where isnotnull(EventTime_1) and isnotempty(GroupHost);
let PercentileWindowValues = materialize(
PercentileObservations
| project GroupHost, PercentileWindowEnd = EventTime_1, PercentileTimeBin = bin(EventTime_1, 5m)
| distinct *
| join kind=inner (
PercentileObservations
| where isnotnull(MeasuredAmount)
| extend PercentileTimeBin = pack_array(bin(EventTime_1, 5m), bin(EventTime_1, 5m) + 5m)
| mv-expand PercentileTimeBin to typeof(datetime)
) on GroupHost, PercentileTimeBin
| where EventTime_1 between ((PercentileWindowEnd - 5m) .. PercentileWindowEnd)
| project GroupHost, PercentileWindowEnd, MeasuredAmount
);
PercentileWindowValues
| join kind=inner (
PercentileWindowValues | summarize PercentilePopulation = count() by GroupHost, PercentileWindowEnd
) on GroupHost, PercentileWindowEnd
| project GroupHost, PercentileWindowEnd, MeasuredAmount, PercentilePopulation
| sort by GroupHost asc, PercentileWindowEnd asc, MeasuredAmount asc
| serialize PercentileRank = row_number(1, GroupHost != prev(GroupHost) or PercentileWindowEnd != prev(PercentileWindowEnd))
| where PercentileRank == max_of(1, (PercentilePopulation / 100) * 50 + tolong(ceiling(toreal((PercentilePopulation % 100) * 50) / 100.0)))
| extend ValuePercentile = MeasuredAmount
| where ValuePercentile >= 0
| project WindowStart = PercentileWindowEnd - 5m, WindowEnd = PercentileWindowEnd, ["Host"] = GroupHost, ValuePercentile
};
let SumObservations = union (Child()
| project EventTime = todatetime(["WindowEnd"]), GroupHost = ["Host"], MeasuredValuePercentile = ["ValuePercentile"])
| where isnotnull(EventTime) and isnotempty(GroupHost);
let SumArrivals = SumObservations
| summarize ArrivalSum = sum(MeasuredValuePercentile) by EventTime, GroupHost;
union (SumArrivals
| project GroupHost, SumBoundaryTime = EventTime, SumBoundaryOrder = 0, SumDelta = ArrivalSum),
(SumArrivals
| project GroupHost, SumBoundaryTime = EventTime + 5m, SumBoundaryOrder = 1, SumDelta = -ArrivalSum)
// Arrivals evaluate before equal-time expirations, including zero and missing values.
| sort by GroupHost asc, SumBoundaryTime asc, SumBoundaryOrder asc
| extend ValueSum = row_cumsum(SumDelta, GroupHost != prev(GroupHost))
| where SumBoundaryOrder == 0
| where ValueSum >= 0
| project WindowStart = SumBoundaryTime - 5m, WindowEnd = SumBoundaryTime, ["Host"] = GroupHost, ValueSum
};
let PercentileObservations = union (Sum()
| project EventTime = todatetime(["WindowEnd"]), GroupHost = ["Host"], MeasuredValueSum = ["ValueSum"])
| where isnotnull(EventTime) and isnotempty(GroupHost);
PercentileObservations
| project GroupHost, PercentileWindowEnd = EventTime, PercentileTimeBin = bin(EventTime, 5m)
| distinct *
| join kind=inner (
PercentileObservations
| where isnotnull(MeasuredValueSum)
| extend PercentileTimeBin = pack_array(bin(EventTime, 5m), bin(EventTime, 5m) + 5m)
| mv-expand PercentileTimeBin to typeof(datetime)
) on GroupHost, PercentileTimeBin
| where EventTime between ((PercentileWindowEnd - 5m) .. PercentileWindowEnd)
| project GroupHost, PercentileWindowEnd, MeasuredValueSum
| summarize ValuePercentile = max(MeasuredValueSum) by GroupHost, PercentileWindowEnd
| where ValuePercentile >= 0
| project WindowStart = PercentileWindowEnd - 5m, WindowEnd = PercentileWindowEnd, ["Host"] = GroupHost, ValuePercentile
};
let Expected = datatable(WindowStart:datetime, WindowEnd:datetime, Host:string, ValuePercentile:long) [
datetime(2026-01-01T11:55:00Z), datetime(2026-01-01T12:00:00Z), "alice", 2,
datetime(2026-01-01T11:56:00Z), datetime(2026-01-01T12:01:00Z), "alice", 102
];
union (Actual() | project WindowStart, WindowEnd, Host, ValuePercentile=tolong(ValuePercentile) | extend Host=tostring(Host) | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Host, ValuePercentile
| where Delta != 0
