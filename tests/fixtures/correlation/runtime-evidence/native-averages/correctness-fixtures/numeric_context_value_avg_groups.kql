let Events=datatable(Timestamp:datetime,Host:string,Marker:string,User:string,Amount:dynamic) [
 datetime(2026-01-01T12:00:00Z),"h","match","Alice",dynamic(10),
 datetime(2026-01-01T12:00:00Z),"h","match","Alice",dynamic(10),
 datetime(2026-01-01T12:00:00Z),"h","match","Alice",dynamic(20),
 datetime(2026-01-01T12:00:00Z),"h","match","Bob",dynamic(100),
 datetime(2026-01-01T12:00:00Z),"h2","match","Alice",dynamic(10),
 datetime(2026-01-01T12:00:00Z),"d","direct","Alice",dynamic(5)
]
// Normalize Events scalar fixture inputs explicitly.
| extend Amount=iff(gettype(Amount) in ("int","long","real","double","decimal"), tolong(Amount), long(null));
let Actual=(){
let _sigma_shared_child = () {
let ContextSummary = () {
let SourceMatchArrivals = union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]), GroupHost = ["Host"])
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
| summarize SourceMatchCount = count() by EventTime_1, GroupHost;
union (SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupHost, CountBoundaryTime = EventTime_1 + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupHost asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupHost != prev(GroupHost))
| where CountBoundaryOrder == 0
| where EventCount >= 1
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, ["Host"] = GroupHost, EventCount
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId = row_number());
let WindowSourceMatches = materialize(
CorrelationMatches | project CorrelationMatchId, CompletionTime = WindowEnd, ContextGroupHost = ["Host"], ContextPartition = 1
| join kind=inner (
union (Events
| where Marker =~ "match"
| extend ContextEventTime = todatetime(["Timestamp"]), ContextGroupHost = ["Host"], ContextUser = ["User"], ContextAmount = ["Amount"]
| extend ContextSourceRule = "source-rule")
| project ContextEventTime, ContextSourceRule, ContextGroupHost, ContextUser, ContextAmount, ContextPartition = 1
) on ContextGroupHost
| where ContextEventTime between ((CompletionTime - 5m) .. CompletionTime));
let CompleteContextRelationships = materialize(WindowSourceMatches
| project CorrelationMatchId, ContextUser, ContextAmount
| distinct *);
union (CorrelationMatches | extend ContextRowKind = "Summary"), (CorrelationMatches | join kind=inner (CompleteContextRelationships) on CorrelationMatchId | extend ContextRowKind = "ContextEvidence")
};
let _sigma_shared_results = materialize(_sigma_shared_child());
let ContextSummary = () {
let _sigma_parent_matches = materialize(union (_sigma_shared_results
| where ["ContextRowKind"] == "ContextEvidence"
| extend _sigma_child_match = strcat("_sigma_shared_child", "_", tostring(["CorrelationMatchId"]))
| project EventTime_1 = todatetime(["WindowEnd"]), GroupActor = ["ContextUser"], MeasuredAmount = ["ContextAmount"], _sigma_child_match),
(Events
| where Marker =~ "direct"
| project EventTime_1 = todatetime(["Timestamp"]), GroupActor = ["User"], MeasuredAmount = ["Amount"])
| extend _sigma_child_match = tostring(column_ifexists("_sigma_child_match", "")));
let AverageObservations = union (_sigma_parent_matches | where isempty(_sigma_child_match)), (_sigma_parent_matches | where isnotempty(_sigma_child_match) | extend RetainedNumericValue = MeasuredAmount | summarize take_any(*) by _sigma_child_match, GroupActor, RetainedNumericValue)
| where isnotnull(EventTime_1) and isnotempty(GroupActor);
AverageObservations
| summarize by GroupActor, AverageWindowEnd = EventTime_1, AverageTimeBin = bin(EventTime_1, 5m)
| join kind=inner (
AverageObservations
| extend AverageTimeBin = pack_array(bin(EventTime_1, 5m), bin(EventTime_1, 5m) + 5m)
| mv-expand AverageTimeBin to typeof(datetime)
) on GroupActor, AverageTimeBin
| where EventTime_1 between ((AverageWindowEnd - 5m) .. AverageWindowEnd)
| summarize ValueAvg = avgif(toreal(MeasuredAmount), isfinite(toreal(MeasuredAmount))) by AverageWindowEnd, GroupActor
| where isfinite(ValueAvg) and ValueAvg >= -1
| project WindowStart = AverageWindowEnd - 5m, WindowEnd = AverageWindowEnd, ["Actor"] = GroupActor, ValueAvg
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId_1 = row_number());
let WindowSourceMatches = materialize(
CorrelationMatches | project CorrelationMatchId_1, CompletionTime = WindowEnd, ContextGroupActor = ["Actor"], ContextPartition = 1
| join kind=inner (
union (_sigma_shared_results | where ["ContextRowKind"] == "Summary"
| project-away ["ContextUser"], ["ContextAmount"]
| join kind=leftouter (_sigma_shared_results | where ["ContextRowKind"] == "ContextEvidence" | project ["CorrelationMatchId"], ["ContextUser"], ["ContextAmount"], HasContextEvidence = true) on ["CorrelationMatchId"]
| extend ContextEventTime = todatetime(["WindowEnd"]), ContextGroupActor = tostring(pack_array(gettype(["ContextUser"]), ["ContextUser"])[1]), ContextAmount_1 = tolong(pack_array(gettype(["ContextAmount"]), ["ContextAmount"])[1])
| extend ContextSourceRule = "child"),
((Events
| where Marker =~ "direct"
| extend ContextEventTime = todatetime(["Timestamp"]), ContextGroupActor = ["User"], ContextAmount_1 = ["Amount"]
| extend ContextSourceRule = "direct")
| extend HasContextEvidence = true)
| project ContextEventTime, ContextSourceRule, ContextGroupActor, ContextAmount_1, HasContextEvidence, ContextPartition = 1
) on ContextGroupActor
| where ContextEventTime between ((CompletionTime - 5m) .. CompletionTime));
let CompleteContextRelationships = materialize(WindowSourceMatches
| where HasContextEvidence
| project CorrelationMatchId_1, ContextAmount_1
| distinct *);
let ValuesForAmount = CompleteContextRelationships
| where isnotnull(ContextAmount_1)
| summarize by CorrelationMatchId_1, ContextAmount_1
| summarize DisplayedAmount = make_list(ContextAmount_1, 1000), DistinctAmountCount = count() by CorrelationMatchId_1;
CorrelationMatches
| join kind=leftouter (ValuesForAmount) on CorrelationMatchId_1
| extend ["Amount"] = coalesce(DisplayedAmount, dynamic([]))
| extend ContextComplete = coalesce(DistinctAmountCount, 0) <= 1000
| project ["WindowStart"], ["WindowEnd"], ["Actor"], ["Amount"], ["ValueAvg"], ["ContextComplete"]
};
let Observed=Actual() | project Actor=tostring(Actor), Metric=toreal(ValueAvg);
let Expected=datatable(Actor:string, Metric:real) ["Alice",real(11.25), "Bob",real(100)];
union (Observed | extend Delta=1), (Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by Actor, Metric
| where Delta!=0
