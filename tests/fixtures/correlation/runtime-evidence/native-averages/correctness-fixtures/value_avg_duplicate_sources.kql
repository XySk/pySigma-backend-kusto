let Events=datatable(Timestamp:datetime, Amount:dynamic, Marker:string) [
    datetime(2026-01-01T12:00:00Z), dynamic(2), "match",
    datetime(2026-01-01T12:00:00Z), dynamic(12), "other"
]
// Normalize Events scalar fixture inputs explicitly.
| extend Amount=iff(gettype(Amount) in ("int","long","real","double","decimal"), toreal(Amount), real(null));
let Expected = datatable(WindowStart:datetime, WindowEnd:datetime, ValueAvg:real) [
    datetime(2026-01-01T11:55:00Z), datetime(2026-01-01T12:00:00Z), 4.0
];
let Actual = () {
let AverageObservations = union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]), MeasuredAmount = ["Amount"]),
(Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]), MeasuredAmount = ["Amount"]),
(Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]), MeasuredAmount = ["Amount"]),
(Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]), MeasuredAmount = ["Amount"]),
(Events
| where Marker =~ "other"
| project EventTime_1 = todatetime(["Timestamp"]), MeasuredAmount = ["Amount"])
| where isnotnull(EventTime_1);
AverageObservations
| summarize by AverageWindowEnd = EventTime_1, AverageTimeBin = bin(EventTime_1, 5m)
| join kind=inner (
AverageObservations
| extend AverageTimeBin = pack_array(bin(EventTime_1, 5m), bin(EventTime_1, 5m) + 5m)
| mv-expand AverageTimeBin to typeof(datetime)
) on AverageTimeBin
| where EventTime_1 between ((AverageWindowEnd - 5m) .. AverageWindowEnd)
| summarize ValueAvg = avgif(toreal(MeasuredAmount), isfinite(toreal(MeasuredAmount))) by AverageWindowEnd
| where isfinite(ValueAvg) and ValueAvg == 4
| project WindowStart = AverageWindowEnd - 5m, WindowEnd = AverageWindowEnd, ValueAvg
};
union (Actual() | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, ValueAvg
| where Delta != 0
