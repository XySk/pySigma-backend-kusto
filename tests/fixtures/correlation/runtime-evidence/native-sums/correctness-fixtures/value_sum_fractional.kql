let Events=datatable(Timestamp:datetime,Amount:long,Marker:string) [
 datetime(2026-01-01T12:00:00Z),2,"match",
 datetime(2026-01-01T12:06:00Z),long(null),"match"
];
let Sum_gt=(){
let SumObservations = union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]), MeasuredAmount = ["Amount"])
| where isnotnull(EventTime_1);
let SumArrivals = SumObservations
| summarize ArrivalSum = sum(MeasuredAmount) by EventTime_1;
union (SumArrivals
| project SumBoundaryTime = EventTime_1, SumBoundaryOrder = 0, SumDelta = ArrivalSum),
(SumArrivals
| project SumBoundaryTime = EventTime_1 + 5m, SumBoundaryOrder = 1, SumDelta = -ArrivalSum)
// Arrivals evaluate before equal-time expirations, including zero and missing values.
| sort by SumBoundaryTime asc, SumBoundaryOrder asc
| extend ValueSum = row_cumsum(SumDelta)
| where SumBoundaryOrder == 0
| where todecimal(ValueSum) > decimal(2.5)
| project WindowStart = SumBoundaryTime - 5m, WindowEnd = SumBoundaryTime, ValueSum
};
