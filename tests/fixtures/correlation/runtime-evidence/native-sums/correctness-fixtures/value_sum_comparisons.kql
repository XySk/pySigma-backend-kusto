// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
let Events=datatable(Timestamp:string, Host:string, Amount:dynamic, Marker:string) [
    "2026-01-01T12:00:00Z", "mixed", dynamic(10), "match",
    "2026-01-01T12:00:00Z", "mixed", dynamic(-3), "match",
    "2026-01-01T12:01:00Z", "mixed", dynamic(0), "match",
    "2026-01-01T12:05:00Z", "mixed", dynamic(1), "match",
    "2026-01-01T12:05:00.0000001Z", "mixed", dynamic("bad"), "match",
    "2026-01-01T12:00:00Z", "empty", dynamic("7"), "match",
    "2026-01-01T12:01:00Z", "empty", dynamic(null), "match",
    "2026-01-01T12:02:00Z", "mixed", dynamic(100), "other"
]
// Normalize Events scalar fixture inputs explicitly.
| extend Amount=iff(gettype(Amount) in ("int","long","real","double","decimal"), tolong(Amount), long(null)), Timestamp=todatetime(Timestamp);
let sum_gt_7 = () {
let SumObservations = union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]), GroupHost = ["Host"], MeasuredAmount = ["Amount"])
| where isnotnull(EventTime_1) and isnotempty(GroupHost);
let SumArrivals = SumObservations
| summarize ArrivalSum = sum(MeasuredAmount) by EventTime_1, GroupHost;
union (SumArrivals
| project GroupHost, SumBoundaryTime = EventTime_1, SumBoundaryOrder = 0, SumDelta = ArrivalSum),
(SumArrivals
| project GroupHost, SumBoundaryTime = EventTime_1 + 5m, SumBoundaryOrder = 1, SumDelta = -ArrivalSum)
// Arrivals evaluate before equal-time expirations, including zero and missing values.
| sort by GroupHost asc, SumBoundaryTime asc, SumBoundaryOrder asc
| extend ValueSum = row_cumsum(SumDelta, GroupHost != prev(GroupHost))
| where SumBoundaryOrder == 0
| where ValueSum > 7
| project WindowStart = SumBoundaryTime - 5m, WindowEnd = SumBoundaryTime, ["Host"] = GroupHost, ValueSum
};
