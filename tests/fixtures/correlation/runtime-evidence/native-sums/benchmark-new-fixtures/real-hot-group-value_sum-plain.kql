];
let SumObservations = union (Events
| where Marker in~ ("A", "B", "C", "D")
| project EventTime_1 = todatetime(["Timestamp"]), GroupHost = ["Host"], MeasuredAmount = ["Amount"])
| where isnotnull(EventTime_1) and isnotempty(GroupHost);
SumObservations
| project GroupHost, SumWindowEnd = EventTime_1, SumTimeBin = bin(EventTime_1, 5m)
| distinct *
| join kind=inner (
SumObservations
| extend SumTimeBin = pack_array(bin(EventTime_1, 5m), bin(EventTime_1, 5m) + 5m)
| mv-expand SumTimeBin to typeof(datetime)
) on GroupHost, SumTimeBin
| where EventTime_1 between ((SumWindowEnd - 5m) .. SumWindowEnd)
| summarize ValueSum = sumif(MeasuredAmount, isfinite(MeasuredAmount)) by SumWindowEnd, GroupHost
| where ValueSum >= 10000
| project WindowStart = SumWindowEnd - 5m, WindowEnd = SumWindowEnd, ["Host"] = GroupHost, ValueSum
