let _sigma_guarded_query = () {
let _sigma_values = union (Events
| where Marker in~ ("A", "B", "C", "D")
| extend _sigma_timestamp = todatetime(["Timestamp"]), _sigma_group_0 = ["Host"], _sigma_value = pack_array(gettype(["Amount"]), ["Amount"])
| extend _sigma_rule = "SourceEvents")
| where isnotnull(_sigma_timestamp) and isnotempty(_sigma_group_0)
;
let _sigma_sums = materialize(
_sigma_values
| project _sigma_group_0, _sigma_window_end = _sigma_timestamp, _sigma_bin = bin(_sigma_timestamp, 5m)
| distinct *
| join kind=inner (
    _sigma_values
    | extend _sigma_bin = pack_array(bin(_sigma_timestamp, 5m), bin(_sigma_timestamp, 5m) + 5m)
    | mv-expand _sigma_bin to typeof(datetime)
) on _sigma_group_0, _sigma_bin
| where _sigma_timestamp between ((_sigma_window_end - 5m) .. _sigma_window_end)
| summarize _sigma_integer_sum = sumif(todecimal(_sigma_value[1]), tostring(_sigma_value[0]) in ("int", "long")), _sigma_real_sum = sumif(toreal(_sigma_value[1]), tostring(_sigma_value[0]) in ("real", "double", "decimal") and isfinite(toreal(_sigma_value[1]))), _sigma_real_count = countif(tostring(_sigma_value[0]) in ("real", "double", "decimal") and isfinite(toreal(_sigma_value[1]))) by _sigma_window_end, _sigma_group_0
);
_sigma_sums
| extend ValueSum = tolong(_sigma_integer_sum)
| where (_sigma_real_count == 0 and todecimal(_sigma_integer_sum) >= decimal(10000)) or (_sigma_real_count > 0 and toreal(_sigma_integer_sum) + _sigma_real_sum >= 10000)
| project WindowStart = _sigma_window_end - 5m, WindowEnd = _sigma_window_end, ["Host"] = _sigma_group_0, ValueSum
};
let _sigma_validation_check = () {
let _sigma_values = union (Events
| where Marker in~ ("A", "B", "C", "D")
| extend _sigma_timestamp = todatetime(["Timestamp"]), _sigma_group_0 = ["Host"], _sigma_value = pack_array(gettype(["Amount"]), ["Amount"])
| extend _sigma_rule = "SourceEvents")
| where isnotnull(_sigma_timestamp) and isnotempty(_sigma_group_0)
;
let _sigma_sums = materialize(
_sigma_values
| project _sigma_group_0, _sigma_window_end = _sigma_timestamp, _sigma_bin = bin(_sigma_timestamp, 5m)
| distinct *
| join kind=inner (
    _sigma_values
    | extend _sigma_bin = pack_array(bin(_sigma_timestamp, 5m), bin(_sigma_timestamp, 5m) + 5m)
    | mv-expand _sigma_bin to typeof(datetime)
) on _sigma_group_0, _sigma_bin
| where _sigma_timestamp between ((_sigma_window_end - 5m) .. _sigma_window_end)
| summarize _sigma_integer_sum = sumif(todecimal(_sigma_value[1]), tostring(_sigma_value[0]) in ("int", "long")), _sigma_real_sum = sumif(toreal(_sigma_value[1]), tostring(_sigma_value[0]) in ("real", "double", "decimal") and isfinite(toreal(_sigma_value[1]))), _sigma_real_count = countif(tostring(_sigma_value[0]) in ("real", "double", "decimal") and isfinite(toreal(_sigma_value[1]))) by _sigma_window_end, _sigma_group_0
);
union (_sigma_sums | where _sigma_real_count == 0 and (isnull(_sigma_integer_sum) or _sigma_integer_sum < decimal(-9223372036854775808) or _sigma_integer_sum > decimal(9223372036854775807)) | project _sigma_correlation_error = "Kusto value_sum integer overflow")
};
let _sigma_guarded_query_rows = materialize(_sigma_guarded_query());
let _sigma_guarded_query_failure = toscalar(union (_sigma_validation_check() | project _sigma_correlation_error = tostring(_sigma_correlation_error)) | summarize countif(isnotempty(_sigma_correlation_error)));
_sigma_guarded_query_rows
| where assert(_sigma_guarded_query_failure == 0, "Kusto correlation validation failed: Kusto value_sum integer overflow; unrecognized error sentinel")
