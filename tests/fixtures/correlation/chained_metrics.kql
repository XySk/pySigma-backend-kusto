// Public-conversion comparison; execution status is hash-scoped in RUNTIME.md.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
// Child counts: pass/a @01=2, @02=3; pass/b @02=2.
// fail-one-host has metrics {2,3}, but only host {a}; both comparisons must pass.
let Events=datatable(Timestamp:string, Case:string, Host:dynamic, Marker:string) [
    "2026-01-01T12:00:00Z", "pass", dynamic("a"), "E",
    "2026-01-01T12:01:00Z", "pass", dynamic("a"), "E",
    "2026-01-01T12:02:00Z", "pass", dynamic("a"), "E",
    "2026-01-01T12:01:00Z", "pass", dynamic("b"), "E",
    "2026-01-01T12:02:00Z", "pass", dynamic("b"), "E",
    "2026-01-01T12:00:00Z", "fail-one-host", dynamic("a"), "E",
    "2026-01-01T12:01:00Z", "fail-one-host", dynamic("a"), "E",
    "2026-01-01T12:02:00Z", "fail-one-host", dynamic("a"), "E",
    "invalid", "pass", dynamic("b"), "E",
    "2026-01-01T12:00:00Z", "pass", dynamic(null), "E",
    "2026-01-01T12:01:00Z", "pass", dynamic(null), "E",
    "2026-01-01T12:00:00Z", "pass", dynamic(""), "E",
    "2026-01-01T12:01:00Z", "pass", dynamic(""), "E",
    "2026-01-01T12:00:00Z", "", dynamic("a"), "E",
    "2026-01-01T12:01:00Z", "", dynamic("a"), "E",
    "2026-01-01T12:03:00Z", "pass", dynamic("c"), "ignored"
]
// Normalize Events scalar fixture inputs explicitly.
| extend Host=tostring(Host), Timestamp=todatetime(Timestamp);
let Actual = () {
let C = () {
let SourceMatchArrivals = union (Events
| where Marker =~ "E"
| project EventTime_1 = todatetime(["Timestamp"]), GroupCase = ["Case"], GroupHost = ["Host"])
| where isnotnull(EventTime_1) and isnotempty(GroupCase) and isnotempty(GroupHost)
| summarize SourceMatchCount = count() by EventTime_1, GroupCase, GroupHost;
union (SourceMatchArrivals
| project GroupCase, GroupHost, CountBoundaryTime = EventTime_1, CountBoundaryOrder = 0, SourceMatchDelta = SourceMatchCount),
(SourceMatchArrivals
| project GroupCase, GroupHost, CountBoundaryTime = EventTime_1 + 5m, CountBoundaryOrder = 1, SourceMatchDelta = -SourceMatchCount)
// Arrivals evaluate before equal-time expirations; expirations never create matches.
| sort by GroupCase asc, GroupHost asc, CountBoundaryTime asc, CountBoundaryOrder asc
| extend EventCount = row_cumsum(SourceMatchDelta, GroupCase != prev(GroupCase) or GroupHost != prev(GroupHost))
| where CountBoundaryOrder == 0
| where EventCount >= 2
| project WindowStart = CountBoundaryTime - 5m, WindowEnd = CountBoundaryTime, ["Case"] = GroupCase, ["Host"] = GroupHost, EventCount
};
let ValueCountSources = materialize(union (C()
| project EventTime = todatetime(["WindowEnd"]), GroupCase = ["Case"], CountedEventCount = ["EventCount"], CountedHost = ["Host"])
| where isnotnull(EventTime) and isnotempty(GroupCase));
let CountedEventCountActivity = materialize(ValueCountSources
| where isnotempty(CountedEventCount)
| summarize by GroupCase, CountedEventCount, EventTime
| sort by GroupCase asc, CountedEventCount asc, EventTime asc
// Repeated values whose inclusive active intervals overlap contribute only once.
| extend CountedEventCountStarts = isnull(prev(EventTime)) or GroupCase != prev(GroupCase) or CountedEventCount != prev(CountedEventCount) or EventTime > prev(EventTime) + 5m,
    CountedEventCountEnds = isnull(next(EventTime)) or GroupCase != next(GroupCase) or CountedEventCount != next(CountedEventCount) or next(EventTime) > EventTime + 5m);
let CountedHostActivity = materialize(ValueCountSources
| where isnotempty(CountedHost)
| summarize by GroupCase, CountedHost, EventTime
| sort by GroupCase asc, CountedHost asc, EventTime asc
// Repeated values whose inclusive active intervals overlap contribute only once.
| extend CountedHostStarts = isnull(prev(EventTime)) or GroupCase != prev(GroupCase) or CountedHost != prev(CountedHost) or EventTime > prev(EventTime) + 5m,
    CountedHostEnds = isnull(next(EventTime)) or GroupCase != next(GroupCase) or CountedHost != next(CountedHost) or next(EventTime) > EventTime + 5m);
union (ValueCountSources | summarize by GroupCase, EventTime
| project GroupCase, ValueBoundaryTime = EventTime, ValueBoundaryOrder = 1, CountedEventCountDelta = 0, CountedHostDelta = 0),
(CountedEventCountActivity | where CountedEventCountStarts
| project GroupCase, ValueBoundaryTime = EventTime, ValueBoundaryOrder = 0, CountedEventCountDelta = 1, CountedHostDelta = 0),
(CountedEventCountActivity | where CountedEventCountEnds
| project GroupCase, ValueBoundaryTime = EventTime + 5m, ValueBoundaryOrder = 2, CountedEventCountDelta = -1, CountedHostDelta = 0),
(CountedHostActivity | where CountedHostStarts
| project GroupCase, ValueBoundaryTime = EventTime, ValueBoundaryOrder = 0, CountedEventCountDelta = 0, CountedHostDelta = 1),
(CountedHostActivity | where CountedHostEnds
| project GroupCase, ValueBoundaryTime = EventTime + 5m, ValueBoundaryOrder = 2, CountedEventCountDelta = 0, CountedHostDelta = -1)
// All interval starts precede anchors; equal-time expirations follow them.
| sort by GroupCase asc, ValueBoundaryTime asc, ValueBoundaryOrder asc
| extend ["ValueCount_EventCount"] = row_cumsum(CountedEventCountDelta, GroupCase != prev(GroupCase)), ["ValueCount_Host"] = row_cumsum(CountedHostDelta, GroupCase != prev(GroupCase))
| where ValueBoundaryOrder == 1
| where ["ValueCount_EventCount"] >= 2 and ["ValueCount_Host"] >= 2
| project WindowStart = ValueBoundaryTime - 5m, WindowEnd = ValueBoundaryTime, ["Case"] = GroupCase, ["ValueCount_EventCount"], ["ValueCount_Host"]
};
let Expected = datatable(WindowStart:datetime, WindowEnd:datetime, Case:string, ValueCount_EventCount:long, ValueCount_Host:long) [
    datetime(2026-01-01T11:57:00Z), datetime(2026-01-01T12:02:00Z), "pass", 2, 2
];
union (Actual() | extend Case=tostring(Case) | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Case, ValueCount_EventCount, ValueCount_Host
| where Delta != 0
