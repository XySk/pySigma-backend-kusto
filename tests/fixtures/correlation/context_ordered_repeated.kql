// Generated via public Sigma parsing and KustoBackend.convert. Zero differences means PASS.
let Events=datatable(Timestamp:datetime, Host:string, Marker:string, User:string, Actor:string, Server:string) [
 datetime(2026-01-01T12:00:00Z), "h", "a", "first", "first", "first-server",
 datetime(2026-01-01T12:01:00Z), "h", "a", "second", "second", "second-server",
 datetime(2026-01-01T12:02:00Z), "h", "b", "middle", "middle", "middle-server",
 datetime(2026-01-01T12:02:00Z), "h", "a", "tie", "tie", "tie-server",
 datetime(2026-01-01T12:03:00Z), "h", "a", "last", "last", "last-server",
 datetime(2026-01-01T12:04:00Z), "h", "a", "overlap", "overlap", "overlap-server",
 datetime(2026-01-01T12:00:00Z), "span-fail", "a", "bad", "bad", "bad-server",
 datetime(2026-01-01T12:04:00Z), "span-fail", "b", "bad", "bad", "bad-server",
 datetime(2026-01-01T12:08:00Z), "span-fail", "c", "bad", "bad", "bad-server",
 datetime(2026-01-01T12:00:00Z), "tie-fail", "a", "bad", "bad", "bad-server",
 datetime(2026-01-01T12:00:00Z), "tie-fail", "b", "bad", "bad", "bad-server",
 datetime(2026-01-01T12:01:00Z), "tie-fail", "c", "bad", "bad", "bad-server"
];
let Actual=() {
let ContextSummary = () {
// Strict sequence: "a" -> "b" -> "a". Total inclusive span: 5m.
union (Events
| where Marker =~ "a"
| extend EventTime_1 = ["Timestamp"], GroupHost = ["Host"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
| extend SourceRule = "a"),
(Events
| where Marker =~ "b"
| extend EventTime_1 = ["Timestamp"], GroupHost = ["Host"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
| extend SourceRule = "b"),
(Events
| where Marker =~ "a"
| extend EventTime_1 = ["Timestamp"], GroupHost = ["Host"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
| extend SourceRule = "a")
// Batch equal timestamps: simultaneous source matches cannot advance strict sequence positions.
| summarize HasA = countif(SourceRule == "a") > 0, HasB = countif(SourceRule == "b") > 0 by EventTime_1, GroupHost
| sort by GroupHost asc, EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1)) or GroupHost != prev(GroupHost)
// Read preceding timestamp state for every assignment; preserve viable earlier prefixes.
| scan declare (LatestAStart:datetime = datetime(null), LatestAThenBStart:datetime = datetime(null), CompleteNow:bool = false) with (
    step SequenceState: true =>
        CompleteNow = not(NewCorrelationGroup) and HasA and isnotnull(SequenceState.LatestAThenBStart) and SequenceState.LatestAThenBStart >= EventTime_1 - 5m,
        LatestAStart = iff(HasA, EventTime_1, iff(NewCorrelationGroup, datetime(null), SequenceState.LatestAStart)),
        LatestAThenBStart = iff(NewCorrelationGroup, datetime(null), iff(HasB and isnotnull(SequenceState.LatestAStart) and SequenceState.LatestAStart >= EventTime_1 - 5m and (isnull(SequenceState.LatestAThenBStart) or SequenceState.LatestAStart > SequenceState.LatestAThenBStart), SequenceState.LatestAStart, SequenceState.LatestAThenBStart));
)
| where CompleteNow
| project WindowStart = EventTime_1 - 5m, WindowEnd = EventTime_1, ["Host"] = GroupHost, RuleCount = tolong(2)
};
let CorrelationMatches = materialize(ContextSummary()
| serialize CorrelationMatchId = row_number());
let WindowSourceMatches = materialize(
CorrelationMatches | project CorrelationMatchId, CompletionTime = WindowEnd, ContextGroupHost = ["Host"], ContextPartition = 1
| join kind=inner (
union (Events
| where Marker =~ "a"
| extend ContextEventTime = ["Timestamp"], ContextGroupHost = ["Host"], ContextUser = ["User"], ContextServer = ["Server"]
| where isnotnull(ContextEventTime) and isnotempty(ContextGroupHost)
| extend ContextSourceRule = "a"),
(Events
| where Marker =~ "b"
| extend ContextEventTime = ["Timestamp"], ContextGroupHost = ["Host"], ContextUser = ["User"], ContextServer = ["Server"]
| where isnotnull(ContextEventTime) and isnotempty(ContextGroupHost)
| extend ContextSourceRule = "b"),
(Events
| where Marker =~ "a"
| extend ContextEventTime = ["Timestamp"], ContextGroupHost = ["Host"], ContextUser = ["User"], ContextServer = ["Server"]
| where isnotnull(ContextEventTime) and isnotempty(ContextGroupHost)
| extend ContextSourceRule = "a")
| project ContextEventTime, ContextSourceRule, ContextGroupHost, ContextUser, ContextServer, ContextPartition = 1
) on ContextGroupHost
| where ContextEventTime between ((CompletionTime - 5m) .. CompletionTime)
| serialize SourceRelationshipId = row_number());
// All candidates share one successful completion's inclusive window.
// Strict prefix/suffix witnesses retain every participating alternative.
let CandidatesFora = WindowSourceMatches
| where ContextSourceRule == "a"
| project CorrelationMatchId, CompletionTime, SourceRelationshipId, ContextEventTime;
let CandidatesForb = WindowSourceMatches
| where ContextSourceRule == "b"
| project CorrelationMatchId, CompletionTime, SourceRelationshipId, ContextEventTime;
let CandidatesFora_1 = WindowSourceMatches
| where ContextSourceRule == "a"
| project CorrelationMatchId, CompletionTime, SourceRelationshipId, ContextEventTime;
let EarliestaPrefix = CandidatesFora
| summarize PrefixEndTime = min(ContextEventTime) by CorrelationMatchId;
let LatestbSuffix = CandidatesForb
| where ContextEventTime < CompletionTime
| summarize SuffixStartTime = max(ContextEventTime) by CorrelationMatchId;
let OrderedParticipants = union (CandidatesFora
| join kind=inner (LatestbSuffix) on CorrelationMatchId
| where ContextEventTime < SuffixStartTime
| project CorrelationMatchId, SourceRelationshipId), (CandidatesForb
| join kind=inner (EarliestaPrefix) on CorrelationMatchId
| where ContextEventTime > PrefixEndTime
| where ContextEventTime < CompletionTime
| project CorrelationMatchId, SourceRelationshipId), (CandidatesFora_1
| where ContextEventTime == CompletionTime
| project CorrelationMatchId, SourceRelationshipId)
| distinct CorrelationMatchId, SourceRelationshipId;
let OrderedSourceRelationships = WindowSourceMatches
| join kind=leftsemi (OrderedParticipants) on CorrelationMatchId, SourceRelationshipId;
let CompleteContextRelationships = materialize(OrderedSourceRelationships
| project CorrelationMatchId, ContextUser, ContextServer
| distinct *);
let ValuesForUser = CompleteContextRelationships
| where isnotnull(ContextUser)
| summarize by CorrelationMatchId, ContextUser
| summarize DisplayedUser = make_list(ContextUser, 1000), DistinctUserCount = count() by CorrelationMatchId;
let ValuesForServer = CompleteContextRelationships
| where isnotnull(ContextServer)
| summarize by CorrelationMatchId, ContextServer
| summarize DisplayedServer = make_list(ContextServer, 1000), DistinctServerCount = count() by CorrelationMatchId;
CorrelationMatches
| join kind=leftouter (ValuesForUser) on CorrelationMatchId
| extend ["User"] = coalesce(DisplayedUser, dynamic([]))
| join kind=leftouter (ValuesForServer) on CorrelationMatchId
| extend ["Server"] = coalesce(DisplayedServer, dynamic([]))
| extend ContextComplete = coalesce(DistinctUserCount, 0) <= 1000 and coalesce(DistinctServerCount, 0) <= 1000
| project ["WindowStart"], ["WindowEnd"], ["Host"], ["User"], ["Server"], ["RuleCount"], ["ContextComplete"]
};
let Observed=Actual()
| project WindowEnd, Users=tostring(array_sort_asc(User)), Servers=tostring(array_sort_asc(Server)), Values=array_length(User), RuleCount, ContextComplete;
let Expected=datatable(WindowEnd:datetime, Users:string, Servers:string, Values:long, RuleCount:long, ContextComplete:bool) [
 datetime(2026-01-01T12:03:00Z), '["first","last","middle","second"]', '["first-server","last-server","middle-server","second-server"]', 4, 2, true,
 datetime(2026-01-01T12:04:00Z), '["first","middle","overlap","second"]', '["first-server","middle-server","overlap-server","second-server"]', 4, 2, true
];
union (Observed | extend Delta=1), (Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowEnd,Users,Servers,Values,RuleCount,ContextComplete
| where Delta!=0
