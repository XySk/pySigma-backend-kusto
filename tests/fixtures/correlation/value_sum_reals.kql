// Public-conversion comparison; execution status is hash-scoped in RUNTIME.md.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
let Events=datatable(Timestamp:string, Amount:dynamic, Marker:string) [
    "2026-01-01T12:00:00Z", dynamic(0.5), "match",
    "2026-01-01T12:00:00Z", dynamic(real(nan)), "match",
    "2026-01-01T12:00:00Z", dynamic(real(+inf)), "match",
    "2026-01-01T12:00:00Z", dynamic(real(-inf)), "match",
    "2026-01-01T12:01:00Z", dynamic(-1.25), "match",
    "2026-01-01T12:01:00Z", dynamic("20"), "match",
    "2026-01-01T12:01:00Z", dynamic(true), "match",
    "2026-01-01T12:01:00Z", dynamic(null), "match",
    "2026-01-01T12:02:00Z", dynamic(2), "match",
    "2026-01-01T12:03:00Z", dynamic("20"), "other"
]
// Normalize Events scalar fixture inputs explicitly.
| extend Amount=iff(gettype(Amount) in ("int","long","real","double","decimal"), toreal(Amount), real(null)), Timestamp=todatetime(Timestamp);
let Actual = () {
let SumObservations = union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]), MeasuredAmount = ["Amount"])
| where isnotnull(EventTime_1);
SumObservations
| project SumWindowEnd = EventTime_1, SumTimeBin = bin(EventTime_1, 5m)
| distinct *
| join kind=inner (
SumObservations
| extend SumTimeBin = pack_array(bin(EventTime_1, 5m), bin(EventTime_1, 5m) + 5m)
| mv-expand SumTimeBin to typeof(datetime)
) on SumTimeBin
| where EventTime_1 between ((SumWindowEnd - 5m) .. SumWindowEnd)
| summarize ValueSum = sumif(MeasuredAmount, isfinite(MeasuredAmount)) by SumWindowEnd
| where ValueSum >= -1
| project WindowStart = SumWindowEnd - 5m, WindowEnd = SumWindowEnd, ValueSum
| project WindowStart, WindowEnd, ValueSum = toreal(ValueSum)
};
let Expected = datatable(WindowStart:datetime, WindowEnd:datetime, ValueSum:real) [
    datetime(2026-01-01T11:55:00Z), datetime(2026-01-01T12:00:00Z), 0.5,
    datetime(2026-01-01T11:56:00Z), datetime(2026-01-01T12:01:00Z), -0.75,
    datetime(2026-01-01T11:57:00Z), datetime(2026-01-01T12:02:00Z), 1.25
];
union (Actual() | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, ValueSum
| where Delta != 0
