// Generated through SigmaCollection.from_yaml and KustoBackend.convert.
// Run the complete file. PASS = zero output rows (exact summary multiset).
// Runtime evidence and engine version: RUNTIME.md.
let Events = datatable(Timestamp:datetime, Case:string, Marker:string) [

    datetime(2026-01-01T12:00:00Z), "C-alone", "C",
    datetime(2026-01-01T12:01:00Z), "C-alone", "C",
    datetime(2026-01-01T12:00:00Z), "incomplete", "A",
    datetime(2026-01-01T12:01:00Z), "incomplete", "C",
    datetime(2026-01-01T12:02:00Z), "incomplete", "B",
    datetime(2026-01-01T12:00:00Z), "span", "A",
    datetime(2026-01-01T12:05:00Z), "span", "B",
    datetime(2026-01-01T12:05:00.0000001Z), "span", "B"

];
let Actual = () {
let _sigma_types = union (Events
| where Marker =~ "A"
| extend _sigma_timestamp = todatetime(["Timestamp"]), _sigma_group_0 = ["Case"]
| extend _sigma_rule = "A"),
(Events
| where Marker =~ "B"
| extend _sigma_timestamp = todatetime(["Timestamp"]), _sigma_group_0 = ["Case"]
| extend _sigma_rule = "B"),
(Events
| where Marker =~ "C"
| extend _sigma_timestamp = todatetime(["Timestamp"]), _sigma_group_0 = ["Case"]
| extend _sigma_rule = "C")
| where isnotnull(_sigma_timestamp) and isnotempty(_sigma_group_0)
| summarize by _sigma_timestamp, _sigma_group_0, _sigma_rule;
_sigma_types
| project _sigma_group_0, _sigma_window_end = _sigma_timestamp, _sigma_bin = bin(_sigma_timestamp, 5m)
| distinct *
| join kind=inner (
    _sigma_types
    | extend _sigma_bin = pack_array(bin(_sigma_timestamp, 5m), bin(_sigma_timestamp, 5m) + 5m)
    | mv-expand _sigma_bin to typeof(datetime)
) on _sigma_group_0, _sigma_bin
| where _sigma_timestamp between ((_sigma_window_end - 5m) .. _sigma_window_end)
| summarize RuleCount = count_distinctif(_sigma_rule, isnotempty(_sigma_rule)), _sigma_present = countif(_sigma_rule == "A") > 0, _sigma_present_1 = countif(_sigma_rule == "B") > 0, _sigma_present_2 = countif(_sigma_rule == "C") > 0 by _sigma_window_end, _sigma_group_0
| where ((_sigma_present and _sigma_present_1) or _sigma_present_2)
| project WindowStart = _sigma_window_end - 5m, WindowEnd = _sigma_window_end, ["Case"] = _sigma_group_0, RuleCount
};
let Expected = datatable(WindowEnd:datetime, Case:string, RuleCount:long) [

    datetime(2026-01-01T12:00:00Z), "C-alone", 1,
    datetime(2026-01-01T12:01:00Z), "C-alone", 1,
    datetime(2026-01-01T12:01:00Z), "incomplete", 2,
    datetime(2026-01-01T12:02:00Z), "incomplete", 3,
    datetime(2026-01-01T12:05:00Z), "span", 2

]
| extend WindowStart = WindowEnd - 5m;
union (Actual() | extend Case=tostring(Case) | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Case, RuleCount
| where Delta != 0
