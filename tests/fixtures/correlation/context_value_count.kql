// Generated through public Sigma parsing and Kusto conversion.
// PASS: zero exact multiset differences. Collections are unordered.
let Events=datatable(Timestamp:datetime, Host:string, Marker:string, User:dynamic, Server:string, Amount:long) [
 datetime(2026-01-01T12:01:00Z), "h", "match", dynamic("1"), "one", 10,
 datetime(2026-01-01T12:01:00Z), "h", "match", dynamic("2"), "two", 20,
 datetime(2026-01-01T12:01:00Z), "h", "match", dynamic("1"), "one", 10
]
// Normalize Events scalar fixture inputs explicitly.
| extend User=tostring(User);
let Actual = () {
let _sigma_context_summary = () {
let _sigma_values = union (Events
| where Marker =~ "match"
| extend _sigma_timestamp = todatetime(["Timestamp"]), _sigma_group_0 = ["Host"], _sigma_value = ["Amount"]
| extend _sigma_rule = "source-rule")
| where isnotnull(_sigma_timestamp) and isnotempty(_sigma_group_0)
| summarize by _sigma_timestamp, _sigma_group_0, _sigma_value;
_sigma_values
| project _sigma_group_0, _sigma_window_end = _sigma_timestamp, _sigma_bin = bin(_sigma_timestamp, 5m)
| distinct *
| join kind=inner (
    _sigma_values
    | extend _sigma_bin = pack_array(bin(_sigma_timestamp, 5m), bin(_sigma_timestamp, 5m) + 5m)
    | mv-expand _sigma_bin to typeof(datetime)
) on _sigma_group_0, _sigma_bin
| where _sigma_timestamp between ((_sigma_window_end - 5m) .. _sigma_window_end)
| summarize ValueCount = count_distinctif(_sigma_value, isnotempty(_sigma_value)) by _sigma_window_end, _sigma_group_0
| where ValueCount >= 0
| project WindowStart = _sigma_window_end - 5m, WindowEnd = _sigma_window_end, ["Host"] = _sigma_group_0, ValueCount
};
let _sigma_context_summaries = materialize(_sigma_context_summary()
| serialize _sigma_context_id = row_number());
let _sigma_context_matches = materialize(
_sigma_context_summaries | project _sigma_context_id, _sigma_context_end = WindowEnd, _sigma_context_group = ["Host"], _sigma_context_partition = 1
| join kind=inner (
union (Events
| where Marker =~ "match"
| extend _sigma_context_timestamp = todatetime(["Timestamp"]), _sigma_context_group = ["Host"], _sigma_context_value = ["Server"], _sigma_context_value_1 = ["User"]
| extend _sigma_context_rule = "source-rule")
| project _sigma_context_timestamp, _sigma_context_rule, _sigma_context_group, _sigma_context_value, _sigma_context_value_1, _sigma_context_partition = 1
) on _sigma_context_group
| where _sigma_context_timestamp between ((_sigma_context_end - 5m) .. _sigma_context_end)
| serialize _sigma_context_key = row_number());
let _sigma_context_rows = materialize(_sigma_context_matches
| project _sigma_context_id, _sigma_context_value, _sigma_context_value_1
| distinct *);
let ContextValues = _sigma_context_rows
| where isnotnull(_sigma_context_value)
| summarize by _sigma_context_id, _sigma_context_value
| summarize DisplayedValues = make_list(_sigma_context_value, 1000), DistinctValueCount = count() by _sigma_context_id;
let ContextValues_1 = _sigma_context_rows
| where isnotnull(_sigma_context_value_1)
| summarize by _sigma_context_id, _sigma_context_value_1
| summarize DisplayedValues_1 = make_list(_sigma_context_value_1, 1000), DistinctValueCount_1 = count() by _sigma_context_id;
_sigma_context_summaries
| join kind=leftouter (ContextValues) on _sigma_context_id
| extend ["Server"] = coalesce(DisplayedValues, dynamic([]))
| join kind=leftouter (ContextValues_1) on _sigma_context_id
| extend ["User"] = coalesce(DisplayedValues_1, dynamic([]))
| extend ContextComplete = coalesce(DistinctValueCount, 0) <= 1000 and coalesce(DistinctValueCount_1, 0) <= 1000
| project ["WindowStart"], ["WindowEnd"], ["Host"], ["Server"], ["User"], ["ValueCount"], ["ContextComplete"]
};
let Observed = Actual()
| project WindowEnd, Host=tostring(Host), Metric = toreal(ValueCount),
    UserCount = array_length(User), ServerCount = array_length(Server), ContextComplete,
    UserLong = false,
    UserString = gettype(User[0]) == "string" or gettype(User[1]) == "string",
    HasServers = set_has_element(Server, "one") and set_has_element(Server, "two");
let Expected = datatable(WindowEnd:datetime, Host:string, Metric:real, UserCount:long, ServerCount:long,
    ContextComplete:bool, UserLong:bool, UserString:bool, HasServers:bool) [
 datetime(2026-01-01T12:01:00Z), "h", real(2), 2, 2, true, false, true, true
];
union (Observed | extend Delta=1), (Expected | extend Delta=-1)
| summarize Delta=sum(Delta) by WindowEnd, Host, Metric, UserCount, ServerCount, ContextComplete, UserLong, UserString, HasServers
| where Delta != 0
