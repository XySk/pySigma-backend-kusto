// Public-conversion comparison; execution status is hash-scoped in RUNTIME.md.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
// Old prefixes survive intervening a; only a new final match completes.
// Literal cases cover total span, strict ties, shared membership, resets and duplicates.
let Events = datatable(Timestamp:datetime, Host:string, Marker:string) [
 datetime(2026-01-01T12:01:00Z), "a-first", "c",
 datetime(2026-01-01T12:00:00Z), "a-first", "b",
 datetime(2026-01-01T12:42:00Z), "z-reset", "c",
 datetime(2026-01-01T12:42:00Z), "h", "c",
 datetime(2026-01-01T12:41:00Z), "h", "c",
 datetime(2026-01-01T12:41:00Z), "h", "shared",
 datetime(2026-01-01T12:40:00Z), "h", "a",
 datetime(2026-01-01T12:38:00Z), "h", "c",
 datetime(2026-01-01T12:34:30Z), "h", "b",
 datetime(2026-01-01T12:34:00Z), "h", "a",
 datetime(2026-01-01T12:30:00Z), "h", "a",
 datetime(2026-01-01T12:21:00Z), "h", "c",
 datetime(2026-01-01T12:20:00Z), "h", "shared",
 datetime(2026-01-01T12:07:00.0000001Z), "h", "c",
 datetime(2026-01-01T12:07:00Z), "h", "c",
 datetime(2026-01-01T12:05:00Z), "h", "c",
 datetime(2026-01-01T12:04:00Z), "h", "b",
 datetime(2026-01-01T12:03:00Z), "h", "c",
 datetime(2026-01-01T12:02:00Z), "h", "a",
 datetime(2026-01-01T12:01:00Z), "h", "b",
 datetime(2026-01-01T12:00:00Z), "h", "a"
];
let Actual = () {
// Strict sequence: "a" -> "b" -> "c". Total inclusive span: 5m.
union (Events
| where Marker in~ ("a", "shared")
| extend EventTime_1 = ["Timestamp"], GroupHost = ["Host"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
| extend SourceRule = "a"),
(Events
| where Marker in~ ("b", "shared")
| extend EventTime_1 = ["Timestamp"], GroupHost = ["Host"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
| extend SourceRule = "b"),
(Events
| where Marker =~ "c"
| extend EventTime_1 = ["Timestamp"], GroupHost = ["Host"]
| where isnotnull(EventTime_1) and isnotempty(GroupHost)
| extend SourceRule = "c")
// Batch equal timestamps: simultaneous source matches cannot advance strict sequence positions.
| summarize HasA = countif(SourceRule == "a") > 0, HasB = countif(SourceRule == "b") > 0, HasC = countif(SourceRule == "c") > 0 by EventTime_1, GroupHost
| sort by GroupHost asc, EventTime_1 asc
| extend NewCorrelationGroup = isnull(prev(EventTime_1)) or GroupHost != prev(GroupHost)
// Read preceding timestamp state for every assignment; preserve viable earlier prefixes.
| scan declare (LatestAStart:datetime = datetime(null), LatestAThenBStart:datetime = datetime(null), CompleteNow:bool = false) with (
    step SequenceState: true =>
        CompleteNow = not(NewCorrelationGroup) and HasC and isnotnull(SequenceState.LatestAThenBStart) and SequenceState.LatestAThenBStart >= EventTime_1 - 5m,
        LatestAStart = iff(HasA, EventTime_1, iff(NewCorrelationGroup, datetime(null), SequenceState.LatestAStart)),
        LatestAThenBStart = iff(NewCorrelationGroup, datetime(null), iff(HasB and isnotnull(SequenceState.LatestAStart) and SequenceState.LatestAStart >= EventTime_1 - 5m and (isnull(SequenceState.LatestAThenBStart) or SequenceState.LatestAStart > SequenceState.LatestAThenBStart), SequenceState.LatestAStart, SequenceState.LatestAThenBStart));
)
| where CompleteNow
| project WindowStart = EventTime_1 - 5m, WindowEnd = EventTime_1, ["Host"] = GroupHost, RuleCount = tolong(3)
};
let CompletionEnds = datatable(WindowEnd:datetime, Host:string, RuleCount:long) [
 datetime(2026-01-01T12:03:00Z), "h", 3,
 datetime(2026-01-01T12:05:00Z), "h", 3,
 datetime(2026-01-01T12:07:00Z), "h", 3,
 datetime(2026-01-01T12:38:00Z), "h", 3,
 datetime(2026-01-01T12:42:00Z), "h", 3
];
let Expected = CompletionEnds | extend WindowStart=WindowEnd-5m;
union (Actual() | extend Host=tostring(Host) | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, Host, RuleCount
| where Delta != 0
