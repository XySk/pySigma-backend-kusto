// Public-conversion comparison; execution status is hash-scoped in RUNTIME.md.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
let Events=datatable(Timestamp:datetime,Amount:real,Marker:string) [
 datetime(2026-01-01T12:00:00Z),real(1e20),"match",
 datetime(2026-01-01T12:01:00Z),real(1),"match",
 datetime(2026-01-01T12:05:00.0000001Z),real(null),"match",
 datetime(2026-01-01T12:06:00.0000001Z),real(nan),"match",
 datetime(2026-01-01T12:07:00Z),real(+inf),"match",
 datetime(2026-01-01T12:08:00Z),real(-inf),"match"
];
let Actual=(){
let SumObservations = Events
| where Marker =~ "match"
| project EventTime_1 = ["Timestamp"], MeasuredAmount = ["Amount"]
| where isnotnull(EventTime_1);
SumObservations
| project SumWindowEnd = EventTime_1, SumTimeBin = bin(EventTime_1, 5m)
| distinct *
| join kind=inner (
SumObservations
| extend SumTimeBin = pack_array(bin(EventTime_1, 5m), bin(EventTime_1, 5m) + 5m)
| mv-expand SumTimeBin to typeof(datetime)
) on SumTimeBin
| where EventTime_1 between ((SumWindowEnd - 5m) .. SumWindowEnd)
| summarize ValueSum = sumif(MeasuredAmount, isfinite(MeasuredAmount)) by SumWindowEnd
| where ValueSum >= 0
| project WindowStart = SumWindowEnd - 5m, WindowEnd = SumWindowEnd, ValueSum
};
let Expected=datatable(WindowStart:datetime,WindowEnd:datetime,ValueSum:real) [
 datetime(2026-01-01T11:55:00Z),datetime(2026-01-01T12:00:00Z),real(1e20),
 datetime(2026-01-01T11:56:00Z),datetime(2026-01-01T12:01:00Z),real(1e20),
 datetime(2026-01-01T12:00:00.0000001Z),datetime(2026-01-01T12:05:00.0000001Z),real(1),
 datetime(2026-01-01T12:01:00.0000001Z),datetime(2026-01-01T12:06:00.0000001Z),real(0),
 datetime(2026-01-01T12:02:00Z),datetime(2026-01-01T12:07:00Z),real(0),
 datetime(2026-01-01T12:03:00Z),datetime(2026-01-01T12:08:00Z),real(0)
];
union (Actual() | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, ValueSum
| where Delta != 0
