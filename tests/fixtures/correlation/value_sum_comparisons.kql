    (sum_neq_7() | project Scenario = "neq_7", WindowStart, WindowEnd, Host, ValueSum = tolong(ValueSum)),
    (sum_gt_7_5() | project Scenario = "gt_7_5", WindowStart, WindowEnd, Host, ValueSum = tolong(ValueSum));
let Expected = datatable(Scenario:string, WindowStart:datetime, WindowEnd:datetime, Host:string, ValueSum:long) [
    "gt_7", datetime(2026-01-01T12:00:00Z), datetime(2026-01-01T12:05:00Z), "mixed", 8,
