// Prepared deterministic fixture; live engine execution has not been performed.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
// Each physical observation contributes through four matching searches.
let Events=datatable(Timestamp:string, Amount:dynamic, Marker:string) [
    "2026-01-01T12:00:00Z", dynamic(2), "match",
    "2026-01-01T12:00:00Z", dynamic(2), "match",
    "2026-01-01T12:01:00Z", dynamic(-1), "match"
]
// Normalize Events scalar fixture inputs explicitly.
| extend Amount=iff(gettype(Amount) in ("int","long","real","double","decimal"), tolong(Amount), long(null)), Timestamp=todatetime(Timestamp);
let Actual = () {
let SumObservations = union (Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]), MeasuredAmount = ["Amount"]),
(Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]), MeasuredAmount = ["Amount"]),
(Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]), MeasuredAmount = ["Amount"]),
(Events
| where Marker =~ "match"
| project EventTime_1 = todatetime(["Timestamp"]), MeasuredAmount = ["Amount"])
| where isnotnull(EventTime_1);
let SumArrivals = SumObservations
| summarize ArrivalSum = sum(MeasuredAmount) by EventTime_1;
union (SumArrivals
| project SumBoundaryTime = EventTime_1, SumBoundaryOrder = 0, SumDelta = ArrivalSum),
(SumArrivals
| project SumBoundaryTime = EventTime_1 + 5m, SumBoundaryOrder = 1, SumDelta = -ArrivalSum)
// Arrivals evaluate before equal-time expirations, including zero and missing values.
| sort by SumBoundaryTime asc, SumBoundaryOrder asc
| extend ValueSum = row_cumsum(SumDelta)
| where SumBoundaryOrder == 0
| where ValueSum >= 0
| project WindowStart = SumBoundaryTime - 5m, WindowEnd = SumBoundaryTime, ValueSum
| project WindowStart, WindowEnd, ValueSum = tolong(ValueSum)
};
let Expected = datatable(WindowStart:datetime, WindowEnd:datetime, ValueSum:long) [
    datetime(2026-01-01T11:55:00Z), datetime(2026-01-01T12:00:00Z), 16,
    datetime(2026-01-01T11:56:00Z), datetime(2026-01-01T12:01:00Z), 12
];
union (Actual() | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, ValueSum
| where Delta != 0
