// Deterministic fixture; see RUNTIME.md for recorded engine execution.
// Generated by tests/fixtures/correlation/generate.py via KustoBackend.convert().
// Run the entire file in one Kusto query. PASS = zero output rows.
// Nonempty rows identify a missing, additional, or duplicated summary.
let Events = datatable(Timestamp:datetime, Amount:dynamic, Marker:string) [
    datetime(2026-01-01T12:00:00Z), dynamic(2), "match",
    datetime(2026-01-01T12:00:00Z), dynamic(12), "other"
];
let Expected = datatable(WindowStart:datetime, WindowEnd:datetime, ValueAvg:real) [
    datetime(2026-01-01T11:55:00Z), datetime(2026-01-01T12:00:00Z), 4.0
];
let Actual = () {
let _sigma_values = union (Events
| where Marker =~ "match"
| extend _sigma_timestamp = todatetime(["Timestamp"]), _sigma_value = pack_array(gettype(["Amount"]), ["Amount"])
| extend _sigma_rule = "first"),
(Events
| where Marker =~ "match"
| extend _sigma_timestamp = todatetime(["Timestamp"]), _sigma_value = pack_array(gettype(["Amount"]), ["Amount"])
| extend _sigma_rule = "first"),
(Events
| where Marker =~ "match"
| extend _sigma_timestamp = todatetime(["Timestamp"]), _sigma_value = pack_array(gettype(["Amount"]), ["Amount"])
| extend _sigma_rule = "second"),
(Events
| where Marker =~ "match"
| extend _sigma_timestamp = todatetime(["Timestamp"]), _sigma_value = pack_array(gettype(["Amount"]), ["Amount"])
| extend _sigma_rule = "second"),
(Events
| where Marker =~ "other"
| extend _sigma_timestamp = todatetime(["Timestamp"]), _sigma_value = pack_array(gettype(["Amount"]), ["Amount"])
| extend _sigma_rule = "third")
| where isnotnull(_sigma_timestamp)
;
_sigma_values
| project _sigma_window_end = _sigma_timestamp, _sigma_bin = bin(_sigma_timestamp, 5m)
| distinct *
| join kind=inner (
    _sigma_values
    | extend _sigma_bin = pack_array(bin(_sigma_timestamp, 5m), bin(_sigma_timestamp, 5m) + 5m)
    | mv-expand _sigma_bin to typeof(datetime)
) on _sigma_bin
| where _sigma_timestamp between ((_sigma_window_end - 5m) .. _sigma_window_end)
| summarize ValueAvg = avgif(toreal(_sigma_value[1]), tostring(_sigma_value[0]) in ("int", "long", "real", "double", "decimal") and isfinite(toreal(_sigma_value[1]))), _sigma_numeric_count = countif(tostring(_sigma_value[0]) in ("int", "long", "real", "double", "decimal") and isfinite(toreal(_sigma_value[1]))) by _sigma_window_end
| where _sigma_numeric_count > 0 and ValueAvg == 4
| project WindowStart = _sigma_window_end - 5m, WindowEnd = _sigma_window_end, ValueAvg
};
union (Actual() | extend Delta = 1), (Expected | extend Delta = -1)
| summarize Delta = sum(Delta) by WindowStart, WindowEnd, ValueAvg
| where Delta != 0
